<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_MemberAccountImport"
  targetNamespace="https://raho.local/bpmn/member-account-import">
  <bpmn:collaboration id="Collaboration_MemberAccountImport">
    <bpmn:participant id="Participant_RAHO" name="RAHO - Import Akun Member Excel" processRef="Process_MemberAccountImport" />
  </bpmn:collaboration>

  <bpmn:process id="Process_MemberAccountImport" name="Import Akun Member dari Excel" isExecutable="false">
    <bpmn:laneSet id="LaneSet_MemberAccountImport">
      <bpmn:lane id="Lane_Admin" name="SUPER_ADMIN / ADMIN_MANAGER">
        <bpmn:flowNodeRef>Start_NeedImport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenBranchPage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectExcelFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCheckFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCreateAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportInvalidCsv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixExcelFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ImportComplete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Web" name="Frontend Web RAHO">
        <bpmn:flowNodeRef>Task_SendDryRun</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowBlockingError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FileRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowPreview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasValidRows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowImportResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasSkippedRows</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_API" name="Backend API Import Service">
        <bpmn:flowNodeRef>Task_ReadWorkbook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FileReadable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ParseRows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateRows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDatabase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyRows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExecuteImport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessValidRows</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnImportResponse</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:dataStoreReference id="DataStore_RAHO" name="Database RAHO" />
    <bpmn:dataObjectReference id="DataObject_Excel" name="Members.xlsx" dataObjectRef="DataObject_Excel_Source" />
    <bpmn:dataObject id="DataObject_Excel_Source" name="File Excel import member" />
    <bpmn:dataObjectReference id="DataObject_InvalidCsv" name="member-import-data-tidak-lengkap.csv" dataObjectRef="DataObject_InvalidCsv_Source" />
    <bpmn:dataObject id="DataObject_InvalidCsv_Source" name="CSV data tidak lengkap" />

    <bpmn:startEvent id="Start_NeedImport" name="Butuh import akun member">
      <bpmn:outgoing>Flow_Start_To_OpenBranch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_OpenBranchPage" name="Buka halaman Cabang, tab Members">
      <bpmn:incoming>Flow_Start_To_OpenBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenBranch_To_SelectFile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SelectExcelFile" name="Pilih file Excel .xlsx">
      <bpmn:incoming>Flow_OpenBranch_To_SelectFile</bpmn:incoming>
      <bpmn:incoming>Flow_FixExcel_To_SelectFile</bpmn:incoming>
      <bpmn:outgoing>Flow_SelectFile_To_ClickCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ClickCheckFile" name="Klik Cek File">
      <bpmn:incoming>Flow_SelectFile_To_ClickCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ClickCheck_To_SendDryRun</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendDryRun" name="Kirim dry-run import">
      <bpmn:incoming>Flow_ClickCheck_To_SendDryRun</bpmn:incoming>
      <bpmn:outgoing>Flow_SendDryRun_To_ReadWorkbook</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReadWorkbook" name="Baca workbook dan cari sheet Members/header">
      <bpmn:incoming>Flow_SendDryRun_To_ReadWorkbook</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadWorkbook_To_FileReadable</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_FileReadable" name="File dan header valid?">
      <bpmn:incoming>Flow_ReadWorkbook_To_FileReadable</bpmn:incoming>
      <bpmn:outgoing>Flow_FileInvalid_To_ShowBlockingError</bpmn:outgoing>
      <bpmn:outgoing>Flow_FileValid_To_ParseRows</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ShowBlockingError" name="Tampilkan error file/header">
      <bpmn:incoming>Flow_FileInvalid_To_ShowBlockingError</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowBlockingError_To_FileRejected</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_FileRejected" name="Import ditolak">
      <bpmn:incoming>Flow_ShowBlockingError_To_FileRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ParseRows" name="Parse baris member">
      <bpmn:incoming>Flow_FileValid_To_ParseRows</bpmn:incoming>
      <bpmn:outgoing>Flow_ParseRows_To_ValidateRows</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidateRows" name="Validasi nama, tanggal lahir, no HP, NIK, username, referral, duplikat file">
      <bpmn:incoming>Flow_ParseRows_To_ValidateRows</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateRows_To_CheckDatabase</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CheckDatabase" name="Cek user, member, referral existing">
      <bpmn:incoming>Flow_ValidateRows_To_CheckDatabase</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckDatabase_To_ClassifyRows</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ClassifyRows" name="Kelompokkan: buat baru, lengkapi existing, atau invalid">
      <bpmn:incoming>Flow_CheckDatabase_To_ClassifyRows</bpmn:incoming>
      <bpmn:outgoing>Flow_ClassifyRows_To_ShowPreview</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_ShowPreview" name="Tampilkan preview valid/invalid">
      <bpmn:incoming>Flow_ClassifyRows_To_ShowPreview</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowPreview_To_HasValidRows</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasValidRows" name="Ada baris valid?">
      <bpmn:incoming>Flow_ShowPreview_To_HasValidRows</bpmn:incoming>
      <bpmn:outgoing>Flow_NoValidRows_To_ExportInvalidCsv</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidRows_To_ClickCreateAccounts</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ClickCreateAccounts" name="Klik Buat Akun">
      <bpmn:incoming>Flow_ValidRows_To_ClickCreateAccounts</bpmn:incoming>
      <bpmn:outgoing>Flow_ClickCreateAccounts_To_ExecuteImport</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ExecuteImport" name="Execute import dan revalidasi">
      <bpmn:incoming>Flow_ClickCreateAccounts_To_ExecuteImport</bpmn:incoming>
      <bpmn:outgoing>Flow_ExecuteImport_To_ProcessValidRows</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Task_ProcessValidRows" name="Untuk setiap baris valid: buat akun baru atau lengkapi member existing">
      <bpmn:incoming>Flow_ExecuteImport_To_ProcessValidRows</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcessValidRows_To_ReturnImportResponse</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_ReturnImportResponse" name="Kembalikan hasil, credential, dan skipped rows">
      <bpmn:incoming>Flow_ProcessValidRows_To_ReturnImportResponse</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnImportResponse_To_ShowImportResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_ShowImportResult" name="Tampilkan hasil import">
      <bpmn:incoming>Flow_ReturnImportResponse_To_ShowImportResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowImportResult_To_HasSkippedRows</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasSkippedRows" name="Ada baris di-skip?">
      <bpmn:incoming>Flow_ShowImportResult_To_HasSkippedRows</bpmn:incoming>
      <bpmn:outgoing>Flow_SkippedRows_To_ExportInvalidCsv</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoSkippedRows_To_ImportComplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ExportInvalidCsv" name="Export Data Tidak Lengkap">
      <bpmn:incoming>Flow_NoValidRows_To_ExportInvalidCsv</bpmn:incoming>
      <bpmn:incoming>Flow_SkippedRows_To_ExportInvalidCsv</bpmn:incoming>
      <bpmn:outgoing>Flow_ExportInvalidCsv_To_FixExcel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FixExcelFile" name="Perbaiki data Excel">
      <bpmn:incoming>Flow_ExportInvalidCsv_To_FixExcel</bpmn:incoming>
      <bpmn:outgoing>Flow_FixExcel_To_SelectFile</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ImportComplete" name="Import selesai">
      <bpmn:incoming>Flow_NoSkippedRows_To_ImportComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_To_OpenBranch" sourceRef="Start_NeedImport" targetRef="Task_OpenBranchPage" />
    <bpmn:sequenceFlow id="Flow_OpenBranch_To_SelectFile" sourceRef="Task_OpenBranchPage" targetRef="Task_SelectExcelFile" />
    <bpmn:sequenceFlow id="Flow_SelectFile_To_ClickCheck" sourceRef="Task_SelectExcelFile" targetRef="Task_ClickCheckFile" />
    <bpmn:sequenceFlow id="Flow_ClickCheck_To_SendDryRun" sourceRef="Task_ClickCheckFile" targetRef="Task_SendDryRun" />
    <bpmn:sequenceFlow id="Flow_SendDryRun_To_ReadWorkbook" sourceRef="Task_SendDryRun" targetRef="Task_ReadWorkbook" />
    <bpmn:sequenceFlow id="Flow_ReadWorkbook_To_FileReadable" sourceRef="Task_ReadWorkbook" targetRef="Gateway_FileReadable" />
    <bpmn:sequenceFlow id="Flow_FileInvalid_To_ShowBlockingError" name="Tidak" sourceRef="Gateway_FileReadable" targetRef="Task_ShowBlockingError" />
    <bpmn:sequenceFlow id="Flow_ShowBlockingError_To_FileRejected" sourceRef="Task_ShowBlockingError" targetRef="End_FileRejected" />
    <bpmn:sequenceFlow id="Flow_FileValid_To_ParseRows" name="Ya" sourceRef="Gateway_FileReadable" targetRef="Task_ParseRows" />
    <bpmn:sequenceFlow id="Flow_ParseRows_To_ValidateRows" sourceRef="Task_ParseRows" targetRef="Task_ValidateRows" />
    <bpmn:sequenceFlow id="Flow_ValidateRows_To_CheckDatabase" sourceRef="Task_ValidateRows" targetRef="Task_CheckDatabase" />
    <bpmn:sequenceFlow id="Flow_CheckDatabase_To_ClassifyRows" sourceRef="Task_CheckDatabase" targetRef="Task_ClassifyRows" />
    <bpmn:sequenceFlow id="Flow_ClassifyRows_To_ShowPreview" sourceRef="Task_ClassifyRows" targetRef="Task_ShowPreview" />
    <bpmn:sequenceFlow id="Flow_ShowPreview_To_HasValidRows" sourceRef="Task_ShowPreview" targetRef="Gateway_HasValidRows" />
    <bpmn:sequenceFlow id="Flow_NoValidRows_To_ExportInvalidCsv" name="Tidak" sourceRef="Gateway_HasValidRows" targetRef="Task_ExportInvalidCsv" />
    <bpmn:sequenceFlow id="Flow_ValidRows_To_ClickCreateAccounts" name="Ya" sourceRef="Gateway_HasValidRows" targetRef="Task_ClickCreateAccounts" />
    <bpmn:sequenceFlow id="Flow_ClickCreateAccounts_To_ExecuteImport" sourceRef="Task_ClickCreateAccounts" targetRef="Task_ExecuteImport" />
    <bpmn:sequenceFlow id="Flow_ExecuteImport_To_ProcessValidRows" sourceRef="Task_ExecuteImport" targetRef="Task_ProcessValidRows" />
    <bpmn:sequenceFlow id="Flow_ProcessValidRows_To_ReturnImportResponse" sourceRef="Task_ProcessValidRows" targetRef="Task_ReturnImportResponse" />
    <bpmn:sequenceFlow id="Flow_ReturnImportResponse_To_ShowImportResult" sourceRef="Task_ReturnImportResponse" targetRef="Task_ShowImportResult" />
    <bpmn:sequenceFlow id="Flow_ShowImportResult_To_HasSkippedRows" sourceRef="Task_ShowImportResult" targetRef="Gateway_HasSkippedRows" />
    <bpmn:sequenceFlow id="Flow_SkippedRows_To_ExportInvalidCsv" name="Ya" sourceRef="Gateway_HasSkippedRows" targetRef="Task_ExportInvalidCsv" />
    <bpmn:sequenceFlow id="Flow_NoSkippedRows_To_ImportComplete" name="Tidak" sourceRef="Gateway_HasSkippedRows" targetRef="End_ImportComplete" />
    <bpmn:sequenceFlow id="Flow_ExportInvalidCsv_To_FixExcel" sourceRef="Task_ExportInvalidCsv" targetRef="Task_FixExcelFile" />
    <bpmn:sequenceFlow id="Flow_FixExcel_To_SelectFile" sourceRef="Task_FixExcelFile" targetRef="Task_SelectExcelFile" />

    <bpmn:association id="Association_Excel_To_DryRun" sourceRef="DataObject_Excel" targetRef="Task_SendDryRun" />
    <bpmn:association id="Association_Database_To_Check" sourceRef="DataStore_RAHO" targetRef="Task_CheckDatabase" />
    <bpmn:association id="Association_Process_To_Database" sourceRef="Task_ProcessValidRows" targetRef="DataStore_RAHO" />
    <bpmn:association id="Association_Export_To_Csv" sourceRef="Task_ExportInvalidCsv" targetRef="DataObject_InvalidCsv" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_MemberAccountImport">
    <bpmndi:BPMNPlane id="BPMNPlane_MemberAccountImport" bpmnElement="Collaboration_MemberAccountImport">
      <bpmndi:BPMNShape id="Participant_RAHO_di" bpmnElement="Participant_RAHO" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="3560" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_di" bpmnElement="Lane_Admin" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="3530" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Web_di" bpmnElement="Lane_Web" isHorizontal="true">
        <dc:Bounds x="110" y="270" width="3530" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_API_di" bpmnElement="Lane_API" isHorizontal="true">
        <dc:Bounds x="110" y="460" width="3530" height="240" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_NeedImport_di" bpmnElement="Start_NeedImport">
        <dc:Bounds x="170" y="157" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenBranchPage_di" bpmnElement="Task_OpenBranchPage">
        <dc:Bounds x="250" y="135" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SelectExcelFile_di" bpmnElement="Task_SelectExcelFile">
        <dc:Bounds x="450" y="135" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClickCheckFile_di" bpmnElement="Task_ClickCheckFile">
        <dc:Bounds x="650" y="135" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDryRun_di" bpmnElement="Task_SendDryRun">
        <dc:Bounds x="850" y="325" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadWorkbook_di" bpmnElement="Task_ReadWorkbook">
        <dc:Bounds x="1050" y="540" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FileReadable_di" bpmnElement="Gateway_FileReadable" isMarkerVisible="true">
        <dc:Bounds x="1285" y="555" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowBlockingError_di" bpmnElement="Task_ShowBlockingError">
        <dc:Bounds x="1235" y="325" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FileRejected_di" bpmnElement="End_FileRejected">
        <dc:Bounds x="1430" y="347" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ParseRows_di" bpmnElement="Task_ParseRows">
        <dc:Bounds x="1420" y="540" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateRows_di" bpmnElement="Task_ValidateRows">
        <dc:Bounds x="1620" y="540" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckDatabase_di" bpmnElement="Task_CheckDatabase">
        <dc:Bounds x="1860" y="540" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClassifyRows_di" bpmnElement="Task_ClassifyRows">
        <dc:Bounds x="2080" y="540" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowPreview_di" bpmnElement="Task_ShowPreview">
        <dc:Bounds x="2320" y="325" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HasValidRows_di" bpmnElement="Gateway_HasValidRows" isMarkerVisible="true">
        <dc:Bounds x="2525" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClickCreateAccounts_di" bpmnElement="Task_ClickCreateAccounts">
        <dc:Bounds x="2660" y="135" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExecuteImport_di" bpmnElement="Task_ExecuteImport">
        <dc:Bounds x="2850" y="540" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ProcessValidRows_di" bpmnElement="Task_ProcessValidRows" isExpanded="false">
        <dc:Bounds x="3060" y="540" width="230" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnImportResponse_di" bpmnElement="Task_ReturnImportResponse">
        <dc:Bounds x="3340" y="540" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShowImportResult_di" bpmnElement="Task_ShowImportResult">
        <dc:Bounds x="3340" y="325" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_HasSkippedRows_di" bpmnElement="Gateway_HasSkippedRows" isMarkerVisible="true">
        <dc:Bounds x="3165" y="340" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExportInvalidCsv_di" bpmnElement="Task_ExportInvalidCsv">
        <dc:Bounds x="2740" y="320" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixExcelFile_di" bpmnElement="Task_FixExcelFile">
        <dc:Bounds x="3000" y="135" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ImportComplete_di" bpmnElement="End_ImportComplete">
        <dc:Bounds x="3568" y="157" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_Excel_di" bpmnElement="DataObject_Excel">
        <dc:Bounds x="855" y="120" width="36" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_RAHO_di" bpmnElement="DataStore_RAHO">
        <dc:Bounds x="1870" y="640" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_InvalidCsv_di" bpmnElement="DataObject_InvalidCsv">
        <dc:Bounds x="2810" y="430" width="36" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_To_OpenBranch_di" bpmnElement="Flow_Start_To_OpenBranch">
        <di:waypoint x="206" y="175" />
        <di:waypoint x="250" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_OpenBranch_To_SelectFile_di" bpmnElement="Flow_OpenBranch_To_SelectFile">
        <di:waypoint x="400" y="175" />
        <di:waypoint x="450" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SelectFile_To_ClickCheck_di" bpmnElement="Flow_SelectFile_To_ClickCheck">
        <di:waypoint x="600" y="175" />
        <di:waypoint x="650" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClickCheck_To_SendDryRun_di" bpmnElement="Flow_ClickCheck_To_SendDryRun">
        <di:waypoint x="800" y="175" />
        <di:waypoint x="925" y="175" />
        <di:waypoint x="925" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendDryRun_To_ReadWorkbook_di" bpmnElement="Flow_SendDryRun_To_ReadWorkbook">
        <di:waypoint x="1000" y="365" />
        <di:waypoint x="1140" y="365" />
        <di:waypoint x="1140" y="540" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReadWorkbook_To_FileReadable_di" bpmnElement="Flow_ReadWorkbook_To_FileReadable">
        <di:waypoint x="1230" y="580" />
        <di:waypoint x="1285" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FileInvalid_To_ShowBlockingError_di" bpmnElement="Flow_FileInvalid_To_ShowBlockingError">
        <di:waypoint x="1310" y="555" />
        <di:waypoint x="1310" y="405" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ShowBlockingError_To_FileRejected_di" bpmnElement="Flow_ShowBlockingError_To_FileRejected">
        <di:waypoint x="1385" y="365" />
        <di:waypoint x="1430" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_FileValid_To_ParseRows_di" bpmnElement="Flow_FileValid_To_ParseRows">
        <di:waypoint x="1335" y="580" />
