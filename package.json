{
  "name": "raho-system",
  "version": "1.0.0",
  "private": true,
  "author": {
    "name": "Jovan Prabowo Kunoro",
    "email": "jovanku1@gmail.com",
    "url": "https://github.com/TatangSteam"
  },
  "contributors": [
    {
      "name": "Jovan Prabowo Kunoro",
      "email": "jovanku1@gmail.com",
      "url": "https://github.com/TatangSteam"
    }
  ],
  "description": "RAHO — Monorepo (Backend + Frontend)",
  "scripts": {
    "dev:api": "npm run dev --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm run lint --prefix apps/api",
    "lint:web": "npm run lint --prefix apps/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test --prefix apps/api -- --runInBand",
    "test:web": "npm run test --prefix apps/web -- --runInBand",
    "db:migrate": "npm run db:migrate --prefix apps/api",
    "db:seed": "npm run db:seed --prefix apps/api",
    "db:studio": "npm run db:studio --prefix apps/api",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "type-check": "npm run type-check:all",
    "type-check:api": "npm run type-check --prefix apps/api",
    "type-check:web": "npm run type-check --prefix apps/web",
    "type-check:all": "npm run type-check:api && npm run type-check:web",
    "e2e:web": "npm --prefix apps/web run e2e --",
    "e2e:web:headed": "npm --prefix apps/web run e2e:headed --",
    "e2e:web:ui": "npm --prefix apps/web run e2e:ui --",
    "e2e:web:install": "npm --prefix apps/web run e2e:install --"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.4"
  }
}
