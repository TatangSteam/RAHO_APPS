# ========================
# RAHO API — Environment Variables
# Copy ke .env dan sesuaikan nilainya
# ========================

# ── Application ─────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
API_URL=https://erp.rahopremier.id

# ── Database (PostgreSQL) ────────────────────────
# Sudah dikonfigurasi di docker-compose.dev.yml
DATABASE_URL=""

# ── JWT Tokens ───────────────────────────────────
JWT_ACCESS_SECRET=raho_access_secret_key_2026_production_secure_token
JWT_REFRESH_SECRET=raho_refresh_secret_key_2026_production_secure_token
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=1d

# ── MinIO Object Storage ─────────────────────────
# Sudah dikonfigurasi di docker-compose.dev.yml
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=raho_minio_user
MINIO_SECRET_KEY=raho_minio_secret
MINIO_BUCKET=raho-uploads
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ── CORS ─────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ─────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
