{
    "name": "@raho/api",
    "version": "1.0.0",
    "description": "RAHO Klinik — REST API Server (Express.js)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:nocheck": "tsc --build --noCheck",
        "start": "node dist/server.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset --force",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "minio:init": "tsx scripts/initMinio.ts",
        "minio:public": "node scripts/setMinioPublicPolicy.js",
        "fix:document-urls": "tsx scripts/fixDocumentUrls.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.600.0",
        "@aws-sdk/s3-request-presigner": "^3.600.0",
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "esbuild": "^0.27.7",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nanoid": "^5.1.7",
        "pdfkit": "^0.18.0",
        "uuid": "^10.0.0",
        "winston": "^3.13.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.19.39",
        "@types/pdfkit": "^0.17.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "eslint": "^8.57.0",
        "prisma": "^5.22.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.7.0",
        "typescript": "^5.5.3"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    }
}
