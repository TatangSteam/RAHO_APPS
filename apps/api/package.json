{
    "name": "@raho/api",
    "version": "1.0.0",
    "description": "RAHO ERP — REST API Server (Express.js)",
    "main": "dist/server.js",
    "scripts": {
        "predev": "prisma migrate deploy",
        "dev": "tsx watch src/server.ts",
        "dev:setup": "prisma generate && prisma migrate deploy",
        "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "build:nocheck": "tsc --build --noCheck",
        "start": "node dist/server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:regression": "node scripts/run-regression-tests.cjs",
        "test:inventory-concurrency": "node scripts/run-inventory-concurrency-tests.js",
        "test:go-live:contracts": "jest --runInBand src/modules/go-live/__tests__ src/modules/revenue/__tests__/sprint8.ac001-ac002.contract.test.ts src/modules/purchasing/__tests__/ac003.contract.test.ts src/modules/inventory/services/__tests__/internal-transfer-posting.helpers.test.ts src/modules/inventory/services/__tests__/internal-transfer.ac006.contract.test.ts src/modules/iam/__tests__/authorization.service.test.ts src/middleware/__tests__/assertBranchAccess.test.ts src/middleware/__tests__/requirePermission.test.ts",
        "test:go-live:database": "node scripts/run-go-live-database-tests.cjs",
        "go-live:audit": "node --import tsx scripts/go-live-audit.ts",
        "db:backup": "sh scripts/backup-database.sh",
        "db:restore:verify": "sh scripts/verify-database-restore.sh",
        "db:backup:rehearse": "node scripts/rehearse-database-backup.cjs",
        "storage:backup": "sh scripts/backup-object-storage.sh",
        "storage:restore:verify": "sh scripts/verify-object-storage-restore.sh",
        "storage:backup:rehearse": "node scripts/rehearse-object-storage-backup.cjs",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:seed:essential": "tsx prisma/seed-essential.ts",
        "db:seed:testing": "tsx prisma/seed-testing.ts",
        "db:seed:minimal": "tsx prisma/seed-minimal.ts",
        "db:seed:local-cash-bank": "tsx prisma/seed-local-cash-bank.ts",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset --force",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "minio:init": "tsx scripts/initMinio.ts",
        "minio:public": "node scripts/setMinioPublicPolicy.js",
        "fix:document-urls": "tsx scripts/fixDocumentUrls.ts",
        "zoho:check": "tsx scripts/check-zoho-readiness.ts",
        "zoho:map-uom": "tsx scripts/map-zoho-uom.ts",
        "zoho:deactivate-unused-uom": "tsx scripts/deactivate-unused-uom.ts",
        "zoho:discover": "tsx scripts/refresh-zoho-discovery.ts",
        "zoho:cutover-status": "tsx scripts/check-zoho-cutover.ts",
        "zoho:reconcile": "tsx scripts/run-zoho-reconciliation.ts",
        "zoho:activate-canary": "tsx scripts/activate-zoho-canary.ts",
        "zoho:drain-canary": "tsx scripts/drain-zoho-canary.ts",
        "zoho:hold": "tsx scripts/hold-zoho-sync.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.600.0",
        "@aws-sdk/s3-request-presigner": "^3.600.0",
        "@prisma/client": "^5.22.0",
        "@whiskeysockets/baileys": "6.7.24",
        "axios": "^1.15.2",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "esbuild": "^0.27.7",
        "exceljs": "^4.4.0",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nanoid": "^5.1.7",
        "pdfkit": "^0.18.0",
        "pino": "9.14.0",
        "sharp": "^0.34.5",
        "uuid": "^10.0.0",
        "winston": "^3.13.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.19.39",
        "@types/pdfkit": "^0.17.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "eslint": "^8.57.0",
        "jest": "^30.4.2",
        "prisma": "^5.22.0",
        "ts-jest": "^29.4.9",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.16.2",
        "typescript": "^5.5.3"
    }
}
