  outboundPostingId   String?                   @unique
  journalEntryId      String?                   @unique
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedBy          String?
  rejectionReason     String?
  postedAt            DateTime?
  postedBy            String?
  createdBy           String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  lines            InventoryAdjustmentLine[]
  approvalInstance ApprovalInstance?         @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)

