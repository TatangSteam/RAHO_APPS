  totalCost                Decimal  @db.Decimal(18, 4)
  currency                 String   @default("IDR")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  shipmentItem           ShipmentItem          @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  sourceCostLayer        InventoryCostLayer    @relation(fields: [sourceCostLayerId], references: [id], onDelete: Restrict)
  sourceInventoryBalance InventoryBalance      @relation(fields: [sourceInventoryBalanceId], references: [id], onDelete: Restrict)
  batch                  InventoryBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  receiptItems           ShipmentReceiptItem[]

  @@unique([shipmentItemId, sourceCostLayerId])
  @@index([sourceInventoryBalanceId])
  @@index([shipmentItemId, receivedQty])
  @@map("shipment_transfer_layers")
}

model ShipmentReceipt {
  id                  String   @id @default(cuid())
  receiptNumber       String   @unique
  shipmentId          String
  idempotencyKey      String   @unique
  payloadHash         String
  inventoryPostingId  String   @unique
  isFinal             Boolean  @default(false)
  totalQuantity       Decimal  @db.Decimal(18, 4)
  quarantinedQuantity Decimal  @default(0) @db.Decimal(18, 4)
  totalCost           Decimal  @db.Decimal(18, 4)
  evidenceFileUrl     String?
  evidenceFileName    String?
  evidenceFileSize    Int?
  evidenceMimeType    String?
  evidenceChecksum    String?
  notes               String?
  receivedBy          String
  receivedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  shipment         Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  inventoryPosting InventoryPosting      @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  items            ShipmentReceiptItem[]
  discrepancies    ShipmentDiscrepancy[]

  @@index([shipmentId, receivedAt])
  @@map("shipment_receipts")
}

model ShipmentReceiptItem {
  id                 String   @id @default(cuid())
  shipmentReceiptId  String
  shipmentItemId     String
  transferLayerId    String
  inventoryBalanceId String
  receivedQty        Decimal  @db.Decimal(18, 4)
  quarantineQty      Decimal  @default(0) @db.Decimal(18, 4)
  unitCost           Decimal  @db.Decimal(18, 4)
  totalCost          Decimal  @db.Decimal(18, 4)
  createdAt          DateTime @default(now())

  shipmentReceipt  ShipmentReceipt       @relation(fields: [shipmentReceiptId], references: [id], onDelete: Restrict)
  shipmentItem     ShipmentItem          @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  transferLayer    ShipmentTransferLayer @relation(fields: [transferLayerId], references: [id], onDelete: Restrict)
  inventoryBalance InventoryBalance      @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)

  @@unique([shipmentReceiptId, shipmentItemId, transferLayerId])
  @@index([shipmentItemId])
  @@index([inventoryBalanceId])
  @@map("shipment_receipt_items")
}

// ============================================================
// OVERSTOCK DOMAIN
// ============================================================

// Tracks overstock (excess items sent beyond requested quantity)
model BranchOverstock {
  id               String          @id @default(cuid())
  branchId         String
  masterProductId  String
  quantity         Decimal         @db.Decimal(10, 2) // Remaining overstock quantity
  originalQty      Decimal         @db.Decimal(10, 2) // Original overstock quantity
  reason           String // Reason for overstock (required)
  sourceShipmentId String
  status           OverstockStatus @default(AVAILABLE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterProduct  MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  sourceShipment Shipment         @relation(fields: [sourceShipmentId], references: [id], onDelete: Cascade)
  usages         OverstockUsage[]

  @@index([branchId])
  @@index([masterProductId])
  @@index([status])
  @@index([branchId, masterProductId, status])
  @@index([sourceShipmentId])
  @@map("branch_overstocks")
}

// Tracks how overstock is consumed by stock requests
model OverstockUsage {
  id                 String   @id @default(cuid())
  overstockId        String
  stockRequestId     String
  stockRequestItemId String
  quantityUsed       Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  overstock        BranchOverstock  @relation(fields: [overstockId], references: [id], onDelete: Cascade)
  stockRequest     StockRequest     @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  stockRequestItem StockRequestItem @relation(fields: [stockRequestItemId], references: [id], onDelete: Cascade)

  @@index([overstockId])
  @@index([stockRequestId])
  @@index([stockRequestItemId])
  @@map("overstock_usages")
}

// ============================================================
// HOMECARE BAG LOGISTICS DOMAIN
// ============================================================

model HomecareTeam {
  id          String  @id @default(cuid())
  teamCode    String  @unique
  name        String
  branchId    String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       HomecareTeamMember[]
  bags          HomecareBag[]
  stockRequests HomecareBagStockRequest[]
  loansGiven    HomecareTeamLoan[]        @relation("HomecareTeamLoansGiven")
  loansReceived HomecareTeamLoan[]        @relation("HomecareTeamLoansReceived")

  @@index([branchId, isActive])
  @@index([teamCode])
  @@map("homecare_teams")
}

model HomecareTeamMember {
  id       String                 @id @default(cuid())
  teamId   String
  userId   String
  role     HomecareTeamMemberRole
  isActive Boolean                @default(true)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  notes    String?   @db.Text

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@map("homecare_team_members")
}

model HomecareBag {
  id       String            @id @default(cuid())
  bagCode  String            @unique
  name     String
  teamId   String
  branchId String
  status   HomecareBagStatus @default(ACTIVE)
  isActive Boolean           @default(true)

  notes     String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  stocks        HomecareBagStock[]
  stockRequests HomecareBagStockRequest[]
  shipments     HomecareBagShipment[]
  usages        HomecareBagUsage[]
  returns       HomecareBagReturn[]
  opnames       HomecareBagOpname[]
  mutations     LogisticStockMutation[]
  loansGiven    HomecareTeamLoan[]        @relation("HomecareBagLoansGiven")
  loansReceived HomecareTeamLoan[]        @relation("HomecareBagLoansReceived")

  @@index([teamId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@map("homecare_bags")
}

model HomecareBagStock {
  id              String @id @default(cuid())
  bagId           String
  masterProductId String

  stock        Decimal @default(0) @db.Decimal(10, 4)
  minThreshold Decimal @default(0) @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag HomecareBag @relation(fields: [bagId], references: [id], onDelete: Cascade)

  @@unique([bagId, masterProductId])
  @@index([bagId])
  @@index([masterProductId])
  @@index([bagId, stock])
  @@map("homecare_bag_stocks")
}

model HomecareTeamLoan {
  id             String                 @id @default(cuid())
  loanCode       String                 @unique
  lenderTeamId   String
  borrowerTeamId String
  fromBagId      String
  toBagId        String
  status         HomecareTeamLoanStatus @default(PENDING)
  reason         String                 @db.Text
  requestedBy    String
  requestedAt    DateTime               @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?                @db.Text
  returnedBy     String?
  returnedAt     DateTime?
  returnNotes    String?                @db.Text
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  lenderTeam   HomecareTeam           @relation("HomecareTeamLoansGiven", fields: [lenderTeamId], references: [id])
  borrowerTeam HomecareTeam           @relation("HomecareTeamLoansReceived", fields: [borrowerTeamId], references: [id])
  fromBag      HomecareBag            @relation("HomecareBagLoansGiven", fields: [fromBagId], references: [id])
  toBag        HomecareBag            @relation("HomecareBagLoansReceived", fields: [toBagId], references: [id])
  items        HomecareTeamLoanItem[]

  @@index([lenderTeamId, status])
  @@index([borrowerTeamId, status])
  @@index([fromBagId])
  @@index([toBagId])
  @@index([requestedAt])
  @@map("homecare_team_loans")
}

model HomecareTeamLoanItem {
  id              String   @id @default(cuid())
  loanId          String
  masterProductId String
  requestedQty    Decimal  @db.Decimal(10, 4)
  approvedQty     Decimal? @db.Decimal(10, 4)
  returnedQty     Decimal  @default(0) @db.Decimal(10, 4)
  notes           String?  @db.Text

  loan          HomecareTeamLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  @@unique([loanId, masterProductId])
  @@index([masterProductId])
  @@map("homecare_team_loan_items")
}

model HomecareBagStockRequest {
  id          String                   @id @default(cuid())
  requestCode String                   @unique
  teamId      String
  bagId       String
  branchId    String
  requestedBy String
  status      HomecareBagRequestStatus @default(PENDING)

  priority     String @default("NORMAL")
  requestNotes String @db.Text

  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?   @db.Text
  rejectionReason String?   @db.Text
  preparedBy      String?
  preparedAt      DateTime?
  shippedBy       String?
  shippedAt       DateTime?
  receivedBy      String?
  receivedAt      DateTime?
  receivingNotes  String?   @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team     HomecareTeam                  @relation(fields: [teamId], references: [id])
  bag      HomecareBag                   @relation(fields: [bagId], references: [id])
  items    HomecareBagStockRequestItem[]
  shipment HomecareBagShipment?

  @@index([teamId, status])
  @@index([bagId, status])
  @@index([branchId, status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("homecare_bag_stock_requests")
}

model HomecareBagStockRequestItem {
  id              String @id @default(cuid())
  requestId       String
  masterProductId String

  requestedQty Decimal  @db.Decimal(10, 4)
  approvedQty  Decimal? @db.Decimal(10, 4)
  finalQty     Decimal? @db.Decimal(10, 4)
  notes        String?  @db.Text

  request HomecareBagStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([masterProductId])
  @@map("homecare_bag_stock_request_items")
}

model HomecareBagShipment {
  id           String @id @default(cuid())
  shipmentCode String @unique
  requestId    String @unique

  fromBranchId String
  toBagId      String
  status       ShipmentStatus @default(PREPARING)

  shippedBy String?
  shippedAt DateTime?

  shipmentPhotoUrl  String?
  shipmentPhotoName String?

  receivedAt     DateTime?
  receivedUserId String?

  receiptFileUrl  String?
  receiptFileName String?
  receiptFileSize Int?
  receiptMimeType String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request HomecareBagStockRequest   @relation(fields: [requestId], references: [id])
  bag     HomecareBag               @relation(fields: [toBagId], references: [id])
  items   HomecareBagShipmentItem[]

  @@index([fromBranchId])
  @@index([toBagId, status])
  @@index([status])
  @@index([shippedAt])
  @@map("homecare_bag_shipments")
}

model HomecareBagShipmentItem {
  id              String @id @default(cuid())
  shipmentId      String
  masterProductId String

  sentQty     Decimal  @db.Decimal(10, 4)
  receivedQty Decimal? @db.Decimal(10, 4)

  discrepancyType  DiscrepancyType?
  discrepancyNotes String?          @db.Text
  photoUrl         String?
  photoFileName    String?

  shipment HomecareBagShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([masterProductId])
  @@index([discrepancyType])
  @@map("homecare_bag_shipment_items")
}

model HomecareBagUsage {
  id        String @id @default(cuid())
  usageCode String @unique
  bagId     String
  teamId    String

  treatmentSessionId String?
  multiBagUsageId    String?
  usedBy             String
  status             HomecareBagUsageStatus @default(COMPLETED)
  usageDate          DateTime               @default(now())
  notes              String                 @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag            @relation(fields: [bagId], references: [id])
  items HomecareBagUsageItem[]

  @@unique([treatmentSessionId, bagId])
  @@index([bagId])
  @@index([teamId])
  @@index([usedBy])
  @@index([treatmentSessionId])
  @@index([multiBagUsageId])
  @@index([usageDate])
  @@map("homecare_bag_usages")
}

model HomecareBagUsageItem {
  id              String  @id @default(cuid())
  usageId         String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  unit            String?
  notes           String? @db.Text

  usage HomecareBagUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)

  @@index([usageId])
  @@index([masterProductId])
  @@map("homecare_bag_usage_items")
}

model HomecareBagReturn {
  id         String @id @default(cuid())
  returnCode String @unique
  bagId      String
  teamId     String
  toBranchId String

  returnedBy String
  receivedBy String?
  returnedAt DateTime  @default(now())
  receivedAt DateTime?
  notes      String    @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagReturnItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([toBranchId])
  @@index([returnedBy])
  @@index([receivedAt])
  @@map("homecare_bag_returns")
}

model HomecareBagReturnItem {
  id              String  @id @default(cuid())
  returnId        String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  isReusable      Boolean @default(true)
  condition       String?
  notes           String? @db.Text

  bagReturn HomecareBagReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([masterProductId])
  @@map("homecare_bag_return_items")
}

model HomecareBagOpname {
  id         String                  @id @default(cuid())
  opnameCode String                  @unique
  bagId      String
  teamId     String
  status     HomecareBagOpnameStatus @default(DRAFT)
  checkedBy  String
  checkedAt  DateTime                @default(now())
  notes      String                  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagOpnameItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([checkedBy])
  @@index([checkedAt])
  @@map("homecare_bag_opnames")
}

model HomecareBagOpnameItem {
  id              String @id @default(cuid())
  opnameId        String
  masterProductId String

  systemQty         Decimal @db.Decimal(10, 4)
  physicalQty       Decimal @db.Decimal(10, 4)
  difference        Decimal @db.Decimal(10, 4)
  adjustmentCreated Boolean @default(false)
  notes             String? @db.Text

  opname HomecareBagOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)

  @@index([opnameId])
  @@index([masterProductId])
  @@map("homecare_bag_opname_items")
}

model HomecareMultiBagUsage {
  id                 String                 @id @default(cuid())
  completionNumber   String                 @unique
  idempotencyKey     String                 @unique
  payloadHash        String
  treatmentSessionId String                 @unique
  teamId             String
  branchId           String
  status             HomecareBagUsageStatus @default(COMPLETED)
  usageIds           Json
  bagCount           Int
  totalItemLines     Int
  notes              String
  completedBy        String
  completedAt        DateTime               @default(now())
  createdAt          DateTime               @default(now())

  @@index([teamId, completedAt])
  @@index([branchId, completedAt])
  @@map("homecare_multi_bag_usages")
}

model LogisticStockTransaction {
  id              String                    @id @default(cuid())
  transactionCode String                    @unique
  type            LogisticTransactionType
  status          LogisticTransactionStatus @default(COMPLETED)

  sourceType LogisticLocationType?
  sourceId   String?

  destinationType LogisticLocationType?
  destinationId   String?

  referenceType String?
  referenceId   String?

  reason String?
  notes  String  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LogisticStockTransactionItem[]

  @@index([type])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_transactions")
}

model LogisticStockTransactionItem {
  id              String  @id @default(cuid())
  transactionId   String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)

  sourceStockBefore Decimal? @db.Decimal(10, 4)
  sourceStockAfter  Decimal? @db.Decimal(10, 4)

  destinationStockBefore Decimal? @db.Decimal(10, 4)
  destinationStockAfter  Decimal? @db.Decimal(10, 4)
  notes                  String?  @db.Text

  transaction LogisticStockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([masterProductId])
  @@map("logistic_stock_transaction_items")
}

model LogisticStockMutation {
  id           String @id @default(cuid())
  mutationCode String @unique

  locationType LogisticLocationType
  locationId   String

  homecareBagId   String?
  masterProductId String
  type            LogisticTransactionType

  quantity    Decimal @db.Decimal(10, 4)
  stockBefore Decimal @db.Decimal(10, 4)
  stockAfter  Decimal @db.Decimal(10, 4)

  referenceType String?
  referenceId   String?
  notes         String  @db.Text

  createdBy String
  createdAt DateTime @default(now())

  homecareBag HomecareBag? @relation(fields: [homecareBagId], references: [id], onDelete: SetNull)

  @@index([locationType, locationId])
  @@index([homecareBagId])
  @@index([masterProductId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_mutations")
}

// ============================================================
// COMMUNICATION DOMAIN
// ============================================================

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String             @db.Text
  deepLink  String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ChatRoom {
  id        String   @id @default(cuid())
  memberId  String   @unique
  staffId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member   Member        @relation(fields: [memberId], references: [id])
  staff    User?         @relation("ChatRoomStaff", fields: [staffId], references: [id])
  messages ChatMessage[]

  @@index([isActive])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String   @db.Text
  fileUrl    String?
  fileName   String?
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  userName      String?
  userRole      String?
  branchId      String? // Branch where action occurred (null for global/system actions)
  branchName    String?
  action        AuditAction
  module        String?
  resource      String
  resourceId    String
  entityType    String?
  entityId      String?
  entityCode    String?
  description   String?
  meta          Json?
  beforeData    Json?
  afterData     Json?
  changedFields Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId, createdAt])
  @@index([branchId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// LAB RESULTS DOMAIN
// ============================================================

model LabResult {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fileName String // Original filename
  fileUrl  String // MinIO URL
  fileType String // MIME type: application/pdf, image/jpeg, image/png
  fileSize Int // File size in bytes

  description String?   @db.Text // Keterangan hasil lab
  labDate     DateTime? // Tanggal hasil lab (optional)

  uploadedBy     String // User ID yang upload
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([uploadedBy])
  @@map("lab_results")
}
