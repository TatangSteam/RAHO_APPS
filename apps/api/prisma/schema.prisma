  stockLocationId    String
  inventoryBalanceId String?
  batchId            String?
  batchKey           String                @default("NO_BATCH")
  systemQty          Decimal               @db.Decimal(18, 4)
  systemUnitCost     Decimal               @default(0) @db.Decimal(18, 4)
  systemValue        Decimal               @default(0) @db.Decimal(18, 2)
  physicalQty        Decimal               @db.Decimal(18, 4)
  differenceQty      Decimal               @db.Decimal(18, 4)
  positiveUnitCost   Decimal?              @db.Decimal(18, 4)
  resolvedUnitCost   Decimal?              @db.Decimal(18, 4)
  resolution         StockOpnameResolution @default(PENDING)
  resolutionNote     String?
  countedBy          String?
  countedAt          DateTime?
  actualCost         Decimal?              @db.Decimal(18, 4)
  inventoryPostingId String?
  stockMutationId    String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  stockOpname      StockOpname       @relation(fields: [stockOpnameId], references: [id], onDelete: Restrict)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  batch            InventoryBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  inventoryPosting InventoryPosting? @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  stockMutation    StockMutation?    @relation(fields: [stockMutationId], references: [id], onDelete: Restrict)

