}

// Junction table for multiple nurses per session
model SessionNurse {
  id        String   @id @default(cuid())
  sessionId String
  nurseId   String
  isPrimary Boolean  @default(false) // Mark primary nurse
  createdAt DateTime @default(now())

  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nurse   User             @relation("SessionNurseStaff", fields: [nurseId], references: [id])

  @@unique([sessionId, nurseId])
  @@index([sessionId])
  @@index([nurseId])
  @@map("session_nurses")
}

model Diagnosis {
  id                       String             @id @default(cuid())
  diagnosisCode            String             @unique
  memberId                 String // Direct link to member
  encounterId              String?            @unique // Optional - only if linked to encounter
  sourceDiagnosisId        String?            @map("source_diagnosis_id")
  doktorPemeriksa          String
  diagnosa                 String             @db.Text
  kategoriDiagnosa         DiagnosisCategory?
  kategoriDiagnosaList     Json?              @map("kategori_diagnosa_list")
  icdPrimer                String?
  icdSekunder              String?
  icdTersier               String?
  keluhanRiwayatSekarang   String?            @db.Text
  riwayatPenyakitTerdahulu String?            @db.Text
  riwayatSosialKebiasaan   String?            @db.Text
  riwayatPengobatan        String?            @db.Text
  pemeriksaanFisik         String?            @db.Text
  pemeriksaanTambahan      Json?
