  batchId         String?
  batchKey        String   @default("NO_BATCH")
  onHandQty       Decimal  @default(0) @db.Decimal(18, 4)
  reservedQty     Decimal  @default(0) @db.Decimal(18, 4)
  quarantineQty   Decimal  @default(0) @db.Decimal(18, 4)
  inTransitQty    Decimal  @default(0) @db.Decimal(18, 4)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryItem          InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockLocation          StockLocation           @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  masterProduct          MasterProduct           @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  batch                  InventoryBatch?         @relation(fields: [batchId], references: [id], onDelete: Restrict)
  costLayers             InventoryCostLayer[]
  stockMutations         StockMutation[]
  reservations           StockReservation[]
  shipmentTransferLayers ShipmentTransferLayer[]
  shipmentReceiptItems   ShipmentReceiptItem[]
  goodsReceiptItems      GoodsReceiptItem[]

  @@unique([inventoryItemId, stockLocationId, batchKey])
  @@index([branchId, masterProductId])
  @@index([stockLocationId, masterProductId])
  @@index([batchId])
  @@map("inventory_balances")
}

model InventoryPosting {
  id             String                 @id @default(cuid())
  postingNumber  String                 @unique
  idempotencyKey String                 @unique
  payloadHash    String
  type           InventoryPostingType
  status         InventoryPostingStatus @default(POSTED)
  reasonCode     String
  sourceType     String
  sourceId       String
  sourceNumber   String?
  branchId       String
  costCenterCode String?
  occurredAt     DateTime
  totalCost      Decimal                @default(0) @db.Decimal(18, 4)
  postedBy       String
  reversedAt     DateTime?
  reversalOfId   String?                @unique
  createdAt      DateTime               @default(now())

  branch                   Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reversalOf               InventoryPosting?         @relation("InventoryPostingReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy               InventoryPosting?         @relation("InventoryPostingReversal")
  stockMutations           StockMutation[]
  costAllocations          InventoryCostAllocation[]
  openingBalanceLine       OpeningBalanceLine?
  goodsReceiptLine         GoodsReceiptLine?
  transferDispatch         InternalTransferLedger?   @relation("TransferDispatchPosting")
  transferReceipt          InternalTransferLedger?   @relation("TransferReceiptPosting")
  shipmentReceipt          ShipmentReceipt?
  goodsReceipt             GoodsReceipt?
  treatmentSession         TreatmentSession?         @relation("TreatmentMaterialPosting")
  reversedTreatmentSession TreatmentSession?         @relation("TreatmentMaterialReversalPosting")
  treatmentMaterialUsages  MaterialUsage[]
  stockOpnameLines         StockOpnameLine[]

  @@index([sourceType, sourceId])
  @@index([branchId, occurredAt])
  @@index([status, createdAt])
  @@map("inventory_postings")
}

model StockOpname {
  id                   String                @id @default(cuid())
  opnameNumber         String                @unique
  idempotencyKey       String                @unique
  payloadHash          String
  branchId             String
  status               StockOpnameStatus     @default(DRAFT)
  reasonCode           StockAdjustmentReason
  notes                String
  countedAt            DateTime
  createdBy            String
  submittedAt          DateTime?
  reviewedBy           String?
  reviewedAt           DateTime?
  rejectionReason      String?
  approvalInstanceId   String?               @unique
  totalAdjustmentValue Decimal               @default(0) @db.Decimal(18, 2)
  journalEntryId       String?               @unique
  postedAt             DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator          User              @relation("StockOpnameCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approvalInstance ApprovalInstance? @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?     @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines            StockOpnameLine[]

  @@index([branchId, status, countedAt])
  @@map("stock_opnames")
}

model StockOpnameLine {
  id                 String   @id @default(cuid())
  stockOpnameId      String
  lineNo             Int
  inventoryItemId    String
  stockLocationId    String
  batchId            String?
  batchKey           String   @default("NO_BATCH")
  systemQty          Decimal  @db.Decimal(18, 4)
  physicalQty        Decimal  @db.Decimal(18, 4)
  differenceQty      Decimal  @db.Decimal(18, 4)
  positiveUnitCost   Decimal? @db.Decimal(18, 4)
  actualCost         Decimal? @db.Decimal(18, 4)
  inventoryPostingId String?
  stockMutationId    String?
  notes              String?
  createdAt          DateTime @default(now())

  stockOpname      StockOpname       @relation(fields: [stockOpnameId], references: [id], onDelete: Restrict)
  inventoryItem    InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockLocation    StockLocation     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  batch            InventoryBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  inventoryPosting InventoryPosting? @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  stockMutation    StockMutation?    @relation(fields: [stockMutationId], references: [id], onDelete: Restrict)

  @@unique([stockOpnameId, lineNo])
  @@unique([stockOpnameId, inventoryItemId, stockLocationId, batchKey])
  @@index([inventoryItemId, stockLocationId])
  @@index([inventoryPostingId])
  @@map("stock_opname_lines")
}

model InventoryCostLayer {
  id                 String                   @id @default(cuid())
  inventoryBalanceId String
  batchId            String?
  sourceType         String
  sourceId           String
  originalQty        Decimal                  @db.Decimal(18, 4)
  remainingQty       Decimal                  @db.Decimal(18, 4)
  unitCost           Decimal?                 @db.Decimal(18, 4)
  currency           String                   @default("IDR")
  valuationStatus    InventoryValuationStatus @default(VALUED)
  receivedAt         DateTime
  isVoided           Boolean                  @default(false)
  createdAt          DateTime                 @default(now())

  inventoryBalance       InventoryBalance          @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  batch                  InventoryBatch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  allocations            InventoryCostAllocation[]
  shipmentTransferLayers ShipmentTransferLayer[]
  goodsReceiptItem       GoodsReceiptItem?

  @@index([inventoryBalanceId, receivedAt, id])
  @@index([batchId, receivedAt])
  @@index([sourceType, sourceId])
  @@map("inventory_cost_layers")
}

model InventoryCostAllocation {
  id              String                      @id @default(cuid())
  postingId       String
  stockMutationId String
  costLayerId     String
  type            InventoryCostAllocationType @default(CONSUMPTION)
  quantity        Decimal                     @db.Decimal(18, 4)
  unitCost        Decimal                     @db.Decimal(18, 4)
  totalCost       Decimal                     @db.Decimal(18, 4)
  reversalOfId    String?                     @unique
  createdAt       DateTime                    @default(now())

  posting       InventoryPosting         @relation(fields: [postingId], references: [id], onDelete: Restrict)
  stockMutation StockMutation            @relation(fields: [stockMutationId], references: [id], onDelete: Restrict)
  costLayer     InventoryCostLayer       @relation(fields: [costLayerId], references: [id], onDelete: Restrict)
  reversalOf    InventoryCostAllocation? @relation("CostAllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    InventoryCostAllocation? @relation("CostAllocationReversal")

  @@unique([postingId, stockMutationId, costLayerId, type])
  @@index([costLayerId, createdAt])
  @@index([stockMutationId])
  @@map("inventory_cost_allocations")
}

model StockRequest {
  id             String             @id @default(cuid())
  requestCode    String             @unique
  branchId       String
  sourceBranchId String?
  requestedBy    String
  status         StockRequestStatus @default(PENDING)
  notes          String?

  // Review fields
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewNotes            String?
  approvalIdempotencyKey String?   @unique
  approvalPayloadHash    String?
  releaseIdempotencyKey  String?   @unique
  releasePayloadHash     String?
  reservationReleasedAt  DateTime?

  // Payment fields (for Partnership branches)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?
  paymentUploadedAt    DateTime?
  paymentUploadedBy    String?

  // Payment verification (by Admin Manager)
  paymentVerifiedBy        String?
  paymentVerifiedAt        DateTime?
  paymentVerificationNotes String?
  paymentRejectionReason   String?

  // Shipping fields
  shippedBy String?
  shippedAt DateTime?

  // Receiving fields
  receivedBy     String?
  receivedAt     DateTime?
  receivingNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch          Branch               @relation("StockRequestDestination", fields: [branchId], references: [id])
  sourceBranch    Branch?              @relation("StockRequestSource", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  items           StockRequestItem[]
  reservations    StockReservation[]
  invoice         StockRequestInvoice?
  shipment        Shipment?
  overstockUsages OverstockUsage[]

  @@index([branchId, status])
  @@index([sourceBranchId, status])
  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("stock_requests")
}

model StockRequestItem {
  id                String   @id @default(cuid())
  stockRequestId    String
  inventoryItemId   String? // Optional - for existing inventory items
  masterProductId   String // Required - reference to master product
  requestedQty      Decimal  @db.Decimal(10, 2)
  approvedQty       Decimal? @db.Decimal(10, 2) // Qty approved by manager (can differ from requested)
  overstockDeducted Decimal? @db.Decimal(10, 2) // Qty deducted from existing overstock
  finalQty          Decimal? @db.Decimal(10, 2) // Final qty after overstock deduction (requestedQty - overstockDeducted)
  notes             String?

  stockRequest    StockRequest       @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?     @relation(fields: [inventoryItemId], references: [id])
  masterProduct   MasterProduct      @relation(fields: [masterProductId], references: [id])
  overstockUsages OverstockUsage[]
  reservations    StockReservation[]

  @@index([stockRequestId])
  @@index([masterProductId])
  @@map("stock_request_items")
}

model StockReservation {
  id                 String                 @id @default(cuid())
  stockRequestId     String
  stockRequestItemId String
  inventoryBalanceId String
  quantity           Decimal                @db.Decimal(18, 4)
  releasedQty        Decimal                @default(0) @db.Decimal(18, 4)
  status             StockReservationStatus @default(ACTIVE)
  reservedBy         String
  reservedAt         DateTime               @default(now())
  releasedBy         String?
  releasedAt         DateTime?
  releaseReason      String?
  consumedQty        Decimal                @default(0) @db.Decimal(18, 4)
  consumedBy         String?
  consumedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  stockRequest     StockRequest     @relation(fields: [stockRequestId], references: [id], onDelete: Restrict)
  stockRequestItem StockRequestItem @relation(fields: [stockRequestItemId], references: [id], onDelete: Restrict)
  inventoryBalance InventoryBalance @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)

  @@unique([stockRequestItemId, inventoryBalanceId])
  @@index([stockRequestId, status])
  @@index([inventoryBalanceId, status])
  @@map("stock_reservations")
}

model Shipment {
  id                 String         @id @default(cuid())
  shipmentCode       String         @unique
  stockRequestId     String         @unique
  fromBranchId       String
  toBranchId         String
  status             ShipmentStatus @default(PREPARING)
  shipIdempotencyKey String?        @unique
  shipPayloadHash    String?

  // Shipping details
  shippedAt         DateTime?
  shippedBy         String?
  shipmentPhotoUrl  String? // Foto paket (optional)
  shipmentPhotoName String?

  // Receiving details
  receivedAt      DateTime?
  receivedBy      String?
  receiptFileUrl  String?
  receiptFileName String?
  receiptFileSize Int?
  receiptMimeType String?

  // Approval details
  approvedAt DateTime?
  approvedBy String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockRequest     StockRequest            @relation(fields: [stockRequestId], references: [id])
  fromBranch       Branch                  @relation("ShipmentFrom", fields: [fromBranchId], references: [id])
  toBranch         Branch                  @relation("ShipmentTo", fields: [toBranchId], references: [id])
  items            ShipmentItem[]
  discrepancies    ShipmentDiscrepancy[]
  receipts         ShipmentReceipt[]
  overstocks       BranchOverstock[]
  internalTransfer InternalTransferLedger?

  @@index([toBranchId, status])
  @@index([status])
  @@index([shippedAt])
  @@index([receivedAt])
  @@map("shipments")
}

model InternalTransferLedger {
  id                         String                 @id @default(cuid())
  shipmentId                 String                 @unique
  fromBranchId               String
  toBranchId                 String
  status                     InternalTransferStatus @default(IN_TRANSIT)
  currency                   String                 @default("IDR")
  totalValue                 Decimal                @db.Decimal(18, 4)
  receivedValue              Decimal                @default(0) @db.Decimal(18, 4)
  dispatchInventoryPostingId String                 @unique
  receiptInventoryPostingId  String?                @unique
  dispatchJournalEntryId     String                 @unique
  receiptJournalEntryId      String?                @unique
  dispatchedAt               DateTime
  receivedAt                 DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  shipment                 Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  fromBranch               Branch            @relation("InternalTransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch                 Branch            @relation("InternalTransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  dispatchInventoryPosting InventoryPosting  @relation("TransferDispatchPosting", fields: [dispatchInventoryPostingId], references: [id], onDelete: Restrict)
  receiptInventoryPosting  InventoryPosting? @relation("TransferReceiptPosting", fields: [receiptInventoryPostingId], references: [id], onDelete: Restrict)
  dispatchJournalEntry     JournalEntry      @relation("TransferDispatchJournal", fields: [dispatchJournalEntryId], references: [id], onDelete: Restrict)
  receiptJournalEntry      JournalEntry?     @relation("TransferReceiptJournal", fields: [receiptJournalEntryId], references: [id], onDelete: Restrict)

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@map("internal_transfer_ledgers")
}

model ShipmentItem {
  id              String   @id @default(cuid())
  shipmentId      String
  masterProductId String
  sentQty         Decimal  @db.Decimal(18, 4)
  receivedQty     Decimal? @db.Decimal(18, 4) // Actual qty received
  quarantineQty   Decimal  @default(0) @db.Decimal(18, 4)
  requestedQty    Decimal? @db.Decimal(18, 4) // Original requested qty (for overstock tracking)
  overstockQty    Decimal? @db.Decimal(18, 4) // Overstock qty (sentQty - requestedQty)
  overstockReason String? // Reason for overstock (required if overstockQty > 0)

  shipment       Shipment                @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  masterProduct  MasterProduct           @relation(fields: [masterProductId], references: [id])
  transferLayers ShipmentTransferLayer[]
  receiptItems   ShipmentReceiptItem[]

  @@index([shipmentId])
  @@index([masterProductId])
  @@map("shipment_items")
}

// Invoice for Partnership stock requests
model StockRequestInvoice {
  id             String @id @default(cuid())
  invoiceNumber  String @unique
  stockRequestId String @unique
  branchId       String

  // Pricing
  subtotal        Decimal @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)
  paidAmount      Decimal @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal @default(0) @db.Decimal(12, 2)

  // Invoice Status
  status InvoiceStatus @default(PENDING_PAYMENT)

  // Payment Proof from Admin Cabang Partnership
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?
  paymentUploadedAt    DateTime?
  paymentUploadedBy    String?

  // Payment account shown on unpaid invoices
  paymentAccountLabel  String?
  paymentBankName      String?
  paymentAccountNumber String?
  paymentAccountHolder String?

  // Payment Verification by Admin Manager
  paymentVerificationStatus PaymentVerificationStatus @default(PENDING)
  verifiedBy                String?
  verifiedAt                DateTime?
  verificationNotes         String?
  rejectionReason           String?

  // Timestamps
  paidAt    DateTime?
  notes     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stockRequest StockRequest                 @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  items        StockRequestInvoiceItem[]
  payments     StockRequestInvoicePayment[]

  @@index([branchId])
  @@index([status])
  @@index([paymentVerificationStatus])
  @@index([createdAt])
  @@map("stock_request_invoices")
}

model StockRequestInvoicePayment {
  id        String @id @default(cuid())
  invoiceId String

  amount Decimal @db.Decimal(12, 2)

  proofFileUrl  String
  proofFileName String
  proofFileSize Int
  proofMimeType String

  notes      String?
  uploadedBy String
  uploadedAt DateTime @default(now())

  verifiedBy        String?
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice StockRequestInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([uploadedBy])
  @@index([uploadedAt])
  @@map("stock_request_invoice_payments")
}

model StockRequestInvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  masterProductId String
  sku             String? // Snapshot SKU produk
  productName     String // Snapshot nama produk
  description     String? // Snapshot keterangan produk
  quantity        Decimal @db.Decimal(10, 2)
  pricePerUnit    Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  invoice       StockRequestInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct       @relation(fields: [masterProductId], references: [id])

  @@index([invoiceId])
  @@index([masterProductId])
  @@map("stock_request_invoice_items")
}

// Discrepancy report for shipments
model ShipmentDiscrepancy {
  id                String                    @id @default(cuid())
  shipmentId        String
  shipmentReceiptId String?
  masterProductId   String
  productName       String // Snapshot nama produk
  expectedQty       Decimal                   @db.Decimal(18, 4)
  receivedQty       Decimal                   @db.Decimal(18, 4)
  discrepancyType   DiscrepancyType
  quarantinedQty    Decimal                   @default(0) @db.Decimal(18, 4)
  status            ShipmentDiscrepancyStatus @default(OPEN)
  notes             String?
  photoUrl          String? // Foto bukti (optional)
  photoFileName     String?
  reportedBy        String
  resolvedBy        String?
  resolvedAt        DateTime?
  resolutionNotes   String?
  createdAt         DateTime                  @default(now())

  shipment        Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentReceipt ShipmentReceipt? @relation(fields: [shipmentReceiptId], references: [id], onDelete: Restrict)
  masterProduct   MasterProduct    @relation(fields: [masterProductId], references: [id])

  @@index([shipmentId])
  @@index([shipmentReceiptId])
  @@index([shipmentId, status])
  @@index([masterProductId])
  @@index([discrepancyType])
  @@map("shipment_discrepancies")
}

model ShipmentTransferLayer {
  id                       String   @id @default(cuid())
  shipmentItemId           String
  sourceCostLayerId        String
  sourceInventoryBalanceId String
  batchId                  String?
  shippedQty               Decimal  @db.Decimal(18, 4)
  receivedQty              Decimal  @default(0) @db.Decimal(18, 4)
  unitCost                 Decimal  @db.Decimal(18, 4)
  totalCost                Decimal  @db.Decimal(18, 4)
  currency                 String   @default("IDR")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  shipmentItem           ShipmentItem          @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  sourceCostLayer        InventoryCostLayer    @relation(fields: [sourceCostLayerId], references: [id], onDelete: Restrict)
  sourceInventoryBalance InventoryBalance      @relation(fields: [sourceInventoryBalanceId], references: [id], onDelete: Restrict)
  batch                  InventoryBatch?       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  receiptItems           ShipmentReceiptItem[]

  @@unique([shipmentItemId, sourceCostLayerId])
  @@index([sourceInventoryBalanceId])
  @@index([shipmentItemId, receivedQty])
  @@map("shipment_transfer_layers")
}

model ShipmentReceipt {
  id                  String   @id @default(cuid())
  receiptNumber       String   @unique
  shipmentId          String
  idempotencyKey      String   @unique
  payloadHash         String
  inventoryPostingId  String   @unique
  isFinal             Boolean  @default(false)
  totalQuantity       Decimal  @db.Decimal(18, 4)
  quarantinedQuantity Decimal  @default(0) @db.Decimal(18, 4)
  totalCost           Decimal  @db.Decimal(18, 4)
  evidenceFileUrl     String?
  evidenceFileName    String?
  evidenceFileSize    Int?
  evidenceMimeType    String?
  evidenceChecksum    String?
  notes               String?
  receivedBy          String
  receivedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  shipment         Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  inventoryPosting InventoryPosting      @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  items            ShipmentReceiptItem[]
  discrepancies    ShipmentDiscrepancy[]

  @@index([shipmentId, receivedAt])
  @@map("shipment_receipts")
}

model ShipmentReceiptItem {
  id                 String   @id @default(cuid())
  shipmentReceiptId  String
  shipmentItemId     String
  transferLayerId    String
  inventoryBalanceId String
  receivedQty        Decimal  @db.Decimal(18, 4)
  quarantineQty      Decimal  @default(0) @db.Decimal(18, 4)
  unitCost           Decimal  @db.Decimal(18, 4)
  totalCost          Decimal  @db.Decimal(18, 4)
  createdAt          DateTime @default(now())

  shipmentReceipt  ShipmentReceipt       @relation(fields: [shipmentReceiptId], references: [id], onDelete: Restrict)
  shipmentItem     ShipmentItem          @relation(fields: [shipmentItemId], references: [id], onDelete: Restrict)
  transferLayer    ShipmentTransferLayer @relation(fields: [transferLayerId], references: [id], onDelete: Restrict)
  inventoryBalance InventoryBalance      @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)

  @@unique([shipmentReceiptId, shipmentItemId, transferLayerId])
  @@index([shipmentItemId])
  @@index([inventoryBalanceId])
  @@map("shipment_receipt_items")
}

// ============================================================
// OVERSTOCK DOMAIN
// ============================================================

// Tracks overstock (excess items sent beyond requested quantity)
model BranchOverstock {
  id               String          @id @default(cuid())
  branchId         String
  masterProductId  String
  quantity         Decimal         @db.Decimal(10, 2) // Remaining overstock quantity
  originalQty      Decimal         @db.Decimal(10, 2) // Original overstock quantity
  reason           String // Reason for overstock (required)
  sourceShipmentId String
  status           OverstockStatus @default(AVAILABLE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterProduct  MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  sourceShipment Shipment         @relation(fields: [sourceShipmentId], references: [id], onDelete: Cascade)
  usages         OverstockUsage[]

  @@index([branchId])
  @@index([masterProductId])
  @@index([status])
  @@index([branchId, masterProductId, status])
  @@index([sourceShipmentId])
  @@map("branch_overstocks")
}

// Tracks how overstock is consumed by stock requests
model OverstockUsage {
  id                 String   @id @default(cuid())
  overstockId        String
  stockRequestId     String
  stockRequestItemId String
  quantityUsed       Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  overstock        BranchOverstock  @relation(fields: [overstockId], references: [id], onDelete: Cascade)
  stockRequest     StockRequest     @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  stockRequestItem StockRequestItem @relation(fields: [stockRequestItemId], references: [id], onDelete: Cascade)

  @@index([overstockId])
  @@index([stockRequestId])
  @@index([stockRequestItemId])
  @@map("overstock_usages")
}

// ============================================================
// HOMECARE BAG LOGISTICS DOMAIN
// ============================================================

model HomecareTeam {
  id          String  @id @default(cuid())
  teamCode    String  @unique
  name        String
  branchId    String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       HomecareTeamMember[]
  bags          HomecareBag[]
  stockRequests HomecareBagStockRequest[]

  @@index([branchId, isActive])
  @@index([teamCode])
  @@map("homecare_teams")
}

model HomecareTeamMember {
  id       String                 @id @default(cuid())
  teamId   String
  userId   String
  role     HomecareTeamMemberRole
  isActive Boolean                @default(true)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  notes    String?   @db.Text

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@map("homecare_team_members")
}

model HomecareBag {
  id       String            @id @default(cuid())
  bagCode  String            @unique
  name     String
  teamId   String
  branchId String
  status   HomecareBagStatus @default(ACTIVE)
  isActive Boolean           @default(true)

  notes     String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  stocks        HomecareBagStock[]
  stockRequests HomecareBagStockRequest[]
  shipments     HomecareBagShipment[]
  usages        HomecareBagUsage[]
  returns       HomecareBagReturn[]
  opnames       HomecareBagOpname[]
  mutations     LogisticStockMutation[]

  @@index([teamId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@map("homecare_bags")
}

model HomecareBagStock {
  id              String @id @default(cuid())
  bagId           String
  masterProductId String

  stock        Decimal @default(0) @db.Decimal(10, 4)
  minThreshold Decimal @default(0) @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag HomecareBag @relation(fields: [bagId], references: [id], onDelete: Cascade)

  @@unique([bagId, masterProductId])
  @@index([bagId])
  @@index([masterProductId])
  @@index([bagId, stock])
  @@map("homecare_bag_stocks")
}

model HomecareBagStockRequest {
  id          String                   @id @default(cuid())
  requestCode String                   @unique
  teamId      String
  bagId       String
  branchId    String
  requestedBy String
  status      HomecareBagRequestStatus @default(PENDING)

  priority     String @default("NORMAL")
  requestNotes String @db.Text

  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?   @db.Text
  rejectionReason String?   @db.Text
  preparedBy      String?
  preparedAt      DateTime?
  shippedBy       String?
  shippedAt       DateTime?
  receivedBy      String?
  receivedAt      DateTime?
  receivingNotes  String?   @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team     HomecareTeam                  @relation(fields: [teamId], references: [id])
  bag      HomecareBag                   @relation(fields: [bagId], references: [id])
  items    HomecareBagStockRequestItem[]
  shipment HomecareBagShipment?

  @@index([teamId, status])
  @@index([bagId, status])
  @@index([branchId, status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("homecare_bag_stock_requests")
}

model HomecareBagStockRequestItem {
  id              String @id @default(cuid())
  requestId       String
  masterProductId String

  requestedQty Decimal  @db.Decimal(10, 4)
  approvedQty  Decimal? @db.Decimal(10, 4)
  finalQty     Decimal? @db.Decimal(10, 4)
  notes        String?  @db.Text

  request HomecareBagStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([masterProductId])
  @@map("homecare_bag_stock_request_items")
}

model HomecareBagShipment {
  id           String @id @default(cuid())
  shipmentCode String @unique
  requestId    String @unique

  fromBranchId String
  toBagId      String
  status       ShipmentStatus @default(PREPARING)

  shippedBy String?
  shippedAt DateTime?

  shipmentPhotoUrl  String?
  shipmentPhotoName String?

  receivedAt     DateTime?
  receivedUserId String?

  receiptFileUrl  String?
  receiptFileName String?
  receiptFileSize Int?
  receiptMimeType String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request HomecareBagStockRequest   @relation(fields: [requestId], references: [id])
  bag     HomecareBag               @relation(fields: [toBagId], references: [id])
  items   HomecareBagShipmentItem[]

  @@index([fromBranchId])
  @@index([toBagId, status])
  @@index([status])
  @@index([shippedAt])
  @@map("homecare_bag_shipments")
}

model HomecareBagShipmentItem {
  id              String @id @default(cuid())
  shipmentId      String
  masterProductId String

  sentQty     Decimal  @db.Decimal(10, 4)
  receivedQty Decimal? @db.Decimal(10, 4)

  discrepancyType  DiscrepancyType?
  discrepancyNotes String?          @db.Text
  photoUrl         String?
  photoFileName    String?

  shipment HomecareBagShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([masterProductId])
  @@index([discrepancyType])
  @@map("homecare_bag_shipment_items")
}

model HomecareBagUsage {
  id        String @id @default(cuid())
  usageCode String @unique
  bagId     String
  teamId    String

  treatmentSessionId String?
  usedBy             String
  status             HomecareBagUsageStatus @default(COMPLETED)
  usageDate          DateTime               @default(now())
  notes              String                 @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag            @relation(fields: [bagId], references: [id])
  items HomecareBagUsageItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([usedBy])
  @@index([treatmentSessionId])
  @@index([usageDate])
  @@map("homecare_bag_usages")
}

model HomecareBagUsageItem {
  id              String  @id @default(cuid())
  usageId         String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  unit            String?
  notes           String? @db.Text

  usage HomecareBagUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)

  @@index([usageId])
  @@index([masterProductId])
  @@map("homecare_bag_usage_items")
}

model HomecareBagReturn {
  id         String @id @default(cuid())
  returnCode String @unique
  bagId      String
  teamId     String
  toBranchId String

  returnedBy String
  receivedBy String?
  returnedAt DateTime  @default(now())
  receivedAt DateTime?
  notes      String    @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagReturnItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([toBranchId])
  @@index([returnedBy])
  @@index([receivedAt])
  @@map("homecare_bag_returns")
}

model HomecareBagReturnItem {
  id              String  @id @default(cuid())
  returnId        String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  isReusable      Boolean @default(true)
  condition       String?
  notes           String? @db.Text

  bagReturn HomecareBagReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([masterProductId])
  @@map("homecare_bag_return_items")
}

model HomecareBagOpname {
  id         String                  @id @default(cuid())
  opnameCode String                  @unique
  bagId      String
  teamId     String
  status     HomecareBagOpnameStatus @default(DRAFT)
  checkedBy  String
  checkedAt  DateTime                @default(now())
  notes      String                  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagOpnameItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([checkedBy])
  @@index([checkedAt])
  @@map("homecare_bag_opnames")
}

model HomecareBagOpnameItem {
  id              String @id @default(cuid())
  opnameId        String
  masterProductId String

  systemQty         Decimal @db.Decimal(10, 4)
  physicalQty       Decimal @db.Decimal(10, 4)
  difference        Decimal @db.Decimal(10, 4)
  adjustmentCreated Boolean @default(false)
  notes             String? @db.Text

  opname HomecareBagOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)

  @@index([opnameId])
  @@index([masterProductId])
  @@map("homecare_bag_opname_items")
}

model LogisticStockTransaction {
  id              String                    @id @default(cuid())
  transactionCode String                    @unique
  type            LogisticTransactionType
  status          LogisticTransactionStatus @default(COMPLETED)

  sourceType LogisticLocationType?
  sourceId   String?

  destinationType LogisticLocationType?
  destinationId   String?

  referenceType String?
  referenceId   String?

  reason String?
  notes  String  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LogisticStockTransactionItem[]

  @@index([type])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_transactions")
}

model LogisticStockTransactionItem {
  id              String  @id @default(cuid())
  transactionId   String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)

  sourceStockBefore Decimal? @db.Decimal(10, 4)
  sourceStockAfter  Decimal? @db.Decimal(10, 4)

  destinationStockBefore Decimal? @db.Decimal(10, 4)
  destinationStockAfter  Decimal? @db.Decimal(10, 4)
  notes                  String?  @db.Text

  transaction LogisticStockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([masterProductId])
  @@map("logistic_stock_transaction_items")
}

model LogisticStockMutation {
  id           String @id @default(cuid())
  mutationCode String @unique

  locationType LogisticLocationType
  locationId   String

  homecareBagId   String?
  masterProductId String
  type            LogisticTransactionType

  quantity    Decimal @db.Decimal(10, 4)
  stockBefore Decimal @db.Decimal(10, 4)
  stockAfter  Decimal @db.Decimal(10, 4)

  referenceType String?
  referenceId   String?
  notes         String  @db.Text

  createdBy String
  createdAt DateTime @default(now())

  homecareBag HomecareBag? @relation(fields: [homecareBagId], references: [id], onDelete: SetNull)

  @@index([locationType, locationId])
  @@index([homecareBagId])
  @@index([masterProductId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_mutations")
}

// ============================================================
// COMMUNICATION DOMAIN
// ============================================================

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String             @db.Text
  deepLink  String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ChatRoom {
  id        String   @id @default(cuid())
  memberId  String   @unique
  staffId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member   Member        @relation(fields: [memberId], references: [id])
  staff    User?         @relation("ChatRoomStaff", fields: [staffId], references: [id])
  messages ChatMessage[]

  @@index([isActive])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String   @db.Text
  fileUrl    String?
  fileName   String?
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  userName      String?
  userRole      String?
  branchId      String? // Branch where action occurred (null for global/system actions)
  branchName    String?
  action        AuditAction
  module        String?
  resource      String
  resourceId    String
  entityType    String?
  entityId      String?
  entityCode    String?
  description   String?
  meta          Json?
  beforeData    Json?
  afterData     Json?
  changedFields Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId, createdAt])
  @@index([branchId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// LAB RESULTS DOMAIN
// ============================================================

model LabResult {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fileName String // Original filename
  fileUrl  String // MinIO URL
  fileType String // MIME type: application/pdf, image/jpeg, image/png
  fileSize Int // File size in bytes

  description String?   @db.Text // Keterangan hasil lab
  labDate     DateTime? // Tanggal hasil lab (optional)

  uploadedBy     String // User ID yang upload
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([uploadedBy])
  @@map("lab_results")
}
