model InventoryCostLayer {
  id                 String                   @id @default(cuid())
  inventoryBalanceId String
  batchId            String?
  sourceType         String
  sourceId           String
  originalQty        Decimal                  @db.Decimal(18, 4)
  remainingQty       Decimal                  @db.Decimal(18, 4)
  unitCost           Decimal?                 @db.Decimal(18, 4)
  currency           String                   @default("IDR")
  valuationStatus    InventoryValuationStatus @default(VALUED)
  receivedAt         DateTime
  isVoided           Boolean                  @default(false)
  createdAt          DateTime                 @default(now())

  inventoryBalance       InventoryBalance          @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  batch                  InventoryBatch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  allocations            InventoryCostAllocation[]
  shipmentTransferLayers ShipmentTransferLayer[]
  goodsReceiptItem       GoodsReceiptItem?

  @@index([inventoryBalanceId, receivedAt, id])
  @@index([batchId, receivedAt])
  @@index([sourceType, sourceId])
  @@map("inventory_cost_layers")
}

model InventoryCostAllocation {
  id              String                      @id @default(cuid())
  postingId       String
  stockMutationId String
  costLayerId     String
  type            InventoryCostAllocationType @default(CONSUMPTION)
