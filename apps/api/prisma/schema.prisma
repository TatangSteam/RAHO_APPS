  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  fromUom       UnitOfMeasure @relation("ConversionFromUom", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUom         UnitOfMeasure @relation("ConversionToUom", fields: [toUomId], references: [id], onDelete: Restrict)

  @@unique([masterProductId, fromUomId, toUomId])
  @@index([fromUomId, toUomId, isActive])
  @@map("unit_conversions")
}

model InventoryItem {
  id              String   @id @default(cuid())
  masterProductId String
  branchId        String
