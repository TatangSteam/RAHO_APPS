  toConversions      UnitConversion[]    @relation("ConversionToUom")
  purchaseOrderItems PurchaseOrderItem[]

  @@index([category, isActive])
  @@map("units_of_measure")
}

model UnitConversion {
  id              String   @id @default(cuid())
  masterProductId String
  fromUomId       String
  toUomId         String
