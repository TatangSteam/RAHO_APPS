  amount Decimal @db.Decimal(12, 2)

  proofFileUrl  String
  proofFileName String
  proofFileSize Int
  proofMimeType String

  notes      String?
  uploadedBy String
  uploadedAt DateTime @default(now())

  verifiedBy        String?
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice StockRequestInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([uploadedBy])
  @@index([uploadedAt])
  @@map("stock_request_invoice_payments")
}

model StockRequestInvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  masterProductId String
  sku             String? // Snapshot SKU produk
  productName     String // Snapshot nama produk
  description     String? // Snapshot keterangan produk
  quantity        Decimal @db.Decimal(10, 2)
