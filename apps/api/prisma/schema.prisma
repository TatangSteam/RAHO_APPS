  balances            InventoryBalance[]
  openingBalanceLines OpeningBalanceLine[]
  goodsReceiptItems   GoodsReceiptItem[]
  goodsReceiptLines   GoodsReceiptLine[]
  stockOpnameLines    StockOpnameLine[]

