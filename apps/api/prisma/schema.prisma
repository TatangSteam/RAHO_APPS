// ============================================================
// RAHO — Prisma Schema
// PostgreSQL 15 | CUID primary keys | Soft-delete via isActive
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

