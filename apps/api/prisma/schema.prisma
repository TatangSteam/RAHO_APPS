  direction             InventoryAdjustmentDirection
  quantity              Decimal                      @db.Decimal(18, 4)
  unitCost              Decimal?                     @db.Decimal(18, 4)
  estimatedValue        Decimal                      @default(0) @db.Decimal(18, 2)
  postedValue           Decimal                      @default(0) @db.Decimal(18, 2)
  inventoryPostingId    String?
  notes                 String?
  createdAt             DateTime                     @default(now())

  adjustment InventoryAdjustment @relation(fields: [inventoryAdjustmentId], references: [id], onDelete: Restrict)

  @@unique([inventoryAdjustmentId, lineNo])
  @@index([inventoryItemId, batchId])
  @@index([inventoryPostingId])
  @@map("inventory_adjustment_lines")
