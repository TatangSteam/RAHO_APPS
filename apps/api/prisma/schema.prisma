// ============================================================
// RAHO — Prisma Schema
// PostgreSQL 15 | CUID primary keys | Soft-delete via isActive
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN_MANAGER
  ADMIN_CABANG
  ADMIN_LAYANAN
  DOCTOR
  NURSE
  MEMBER
}

enum BranchType {
  PUSAT
  PREMIER
  PARTNERSHIP
}

enum Gender {
  L
  P
}

enum DocumentType {
  PERSETUJUAN_SETELAH_PENJELASAN
  FOTO_PROFIL
}

enum ReferrerType {
  SALES
  DOKTER
  MEMBER
}

enum IncentiveType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PackageType {
  BASIC
  BOOSTER
}

enum PackageStatus {
  PENDING_PAYMENT
  WAITING_VERIFICATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentPlanType {
  FULL_PAYMENT
  INSTALLMENT
}

enum BoosterType {
  NO // Nitric Oxide
  GT // Glutathione
  MB // Methylene Blue
  KCL // Potassium Chloride
  H2S // Hydrogen Sulfide
  HK // Hypochlorous Acid
  O3 // Ozone
  HHO // Hydrogen (legacy - keep for backward compatibility)
  NO2 // Nitric Oxide 2 (legacy - keep for backward compatibility)
}

enum SessionType {
  ON_SITE
  HOME_CARE
}

enum EncounterStatus {
  ONGOING
  CLOSED
}

enum VitalType {
  SISTOL
  DIASTOL
  HR
  SATURASI
  PI
}

enum VitalTiming {
  SEBELUM
  SESUDAH
}

enum BottleType {
  IFA
  EDTA
}

enum EMRNoteType {
  CLINICAL_NOTE
  OPERATIONAL_NOTE
  ASSESSMENT
  OUTCOME_MONITORING
}

enum DiagnosisCategory {
  HIPERTENSI
  NEUROLOGI
  DIABETES
  KARDIOVASKULAR
  ORTOPEDI
  IMUNOLOGI
  HEMATOLOGI
  STROKE
  JANTUNG_KARDIOVASKULAR
  SINDROM_METABOLIK
  KANKER
  DEGENERATIF
  AUTO_IMUN
  ONKOLOGI
  LAINNYA
}

enum ProductCategory {
  MEDICINE
  DEVICE
  CONSUMABLE
}

enum StockMutationType {
  USED
  RECEIVED
  ADJUSTMENT
}

enum StockRequestStatus {
  PENDING // Baru dibuat, menunggu review
  APPROVED // Disetujui (untuk Premier)
  WAITING_PAYMENT // Menunggu pembayaran (untuk Partnership)
  PAYMENT_UPLOADED // Bukti bayar sudah diupload
  PAYMENT_CONFIRMED // Pembayaran dikonfirmasi
  REJECTED // Ditolak
  SHIPPED // Sedang dikirim
  COMPLETED // Selesai - barang diterima sesuai
  COMPLETED_WITH_ISSUE // Selesai - ada ketidaksesuaian
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DiscrepancyType {
  SHORTAGE // Kurang
  DAMAGE // Rusak
  WRONG_ITEM // Salah item
  OTHER // Lainnya
}

enum StockAdjustmentReason {
  EXPIRED // Kadaluarsa
  DAMAGED // Rusak/Pecah
  LOST // Hilang
  STOCK_OPNAME // Koreksi stock opname
  OTHER // Lainnya
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  RECEIVED
  RECEIVED_WITH_ISSUE // Diterima dengan ketidaksesuaian
  APPROVED
}

enum NotificationType {
  INVOICE
  REMINDER
  INFO
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_CHANGE
  PASSWORD_RESET
}

enum OverstockStatus {
  AVAILABLE // Masih tersedia untuk digunakan
  PARTIALLY_USED // Sebagian sudah terpakai
  FULLY_USED // Sudah habis terpakai
}

// ============================================================
// CORE DOMAIN
// ============================================================

model Branch {
  id             String     @id @default(cuid())
  branchCode     String     @unique
  name           String
  address        String?
  city           String?
  phone          String?
  type           BranchType @default(PREMIER)
  operatingHours String?
  isActive       Boolean    @default(true)
  createdBy      String? // User ID who created this branch
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  users               User[]
  members             Member[]
  branchMemberAccess  BranchMemberAccess[]
  memberPackages      MemberPackage[]
  memberAddOns        MemberAddOn[]
  nonTherapyPurchases MemberNonTherapyPurchase[]
  invoices            Invoice[]
  packagePricings     PackagePricing[]
  inventoryItems      InventoryItem[]
  stockRequests       StockRequest[]
  shipmentsFrom       Shipment[]                 @relation("ShipmentFrom")
  shipmentsTo         Shipment[]                 @relation("ShipmentTo")
  encounters          Encounter[]
  treatmentSessions   TreatmentSession[]
  managerBranches     ManagerBranch[]
  staffBranches       StaffBranch[]              @relation("StaffBranches")
  referralCodes       ReferralCode[]
  auditLogs           AuditLog[]
  overstocks          BranchOverstock[]

  @@index([branchCode])
  @@index([isActive])
  @@index([createdBy])
  @@map("branches")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  role        Role
  staffCode   String?   @unique
  branchId    String?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  branch          Branch?         @relation(fields: [branchId], references: [id])
  profile         UserProfile?
  member          Member?
  auditLogs       AuditLog[]
  notifications   Notification[]
  chatMessages    ChatMessage[]
  chatRooms       ChatRoom[]      @relation("ChatRoomStaff")
  managedBranches ManagerBranch[]
  staffBranches   StaffBranch[]   @relation("StaffBranches")

  sessionsAsAdmin  TreatmentSession[] @relation("SessionAdmin")
  sessionsAsDoctor TreatmentSession[] @relation("SessionDoctor")
  sessionsAsNurse  TreatmentSession[] @relation("SessionNurse")

  // Multiple doctors/nurses per session
  sessionDoctorAssignments SessionDoctor[] @relation("SessionDoctorStaff")
  sessionNurseAssignments  SessionNurse[]  @relation("SessionNurseStaff")

  packagesAssigned   MemberPackage[]            @relation("PackageAssignedBy")
  packagesVerified   MemberPackage[]            @relation("PackageVerifiedBy")
  packagesRejected   MemberPackage[]            @relation("PackageRejectedBy")
  packagesRefunded   MemberPackage[]            @relation("PackageRefundedBy")
  addOnsAssigned     MemberAddOn[]              @relation("AddOnAssignedBy")
  addOnsVerified     MemberAddOn[]              @relation("AddOnVerifiedBy")
  addOnsRejected     MemberAddOn[]              @relation("AddOnRejectedBy")
  nonTherapyAssigned MemberNonTherapyPurchase[] @relation("NonTherapyAssignedBy")
  nonTherapyVerified MemberNonTherapyPurchase[] @relation("NonTherapyVerifiedBy")
  invoicesCreated    Invoice[]                  @relation("InvoiceCreatedBy")
  invoicesVerified   Invoice[]                  @relation("InvoiceVerifiedBy")
  paymentsReceived   InvoicePayment[]           @relation("PaymentReceivedBy")
  uploadedLabResults LabResult[]

  @@index([email])
  @@index([role])
  @@index([branchId, role, isActive])
  @@index([staffCode])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@map("user_profiles")
}

model ManagerBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("manager_branches")
}

model StaffBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("StaffBranches", fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation("StaffBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("staff_branches")
}

// ============================================================
// MEMBER DOMAIN
// ============================================================

model Member {
  id                   String  @id @default(cuid())
  userId               String  @unique
  memberNo             String  @unique
  registrationBranchId String
  referralCodeId       String?

  // Incentive Settings (per member)
  firstIncentiveType  IncentiveType?
  firstIncentiveValue Decimal?       @db.Decimal(10, 2)
  nextIncentiveType   IncentiveType?
  nextIncentiveValue  Decimal?       @db.Decimal(10, 2)

  voucherCount     Int       @default(0)
  isConsentToPhoto Boolean   @default(true)
  nik              String?   @unique
  tempatLahir      String?
  dateOfBirth      DateTime?
  jenisKelamin     Gender?
  agama            String?   // Religion field
  address          String?
  pekerjaan        String?
  statusNikah      String?
  emergencyContact String?
  sumberInfoRaho   String?
  postalCode       String?
  isDeceased       Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                User                       @relation(fields: [userId], references: [id])
  registrationBranch  Branch                     @relation(fields: [registrationBranchId], references: [id])
  referralCode        ReferralCode?              @relation(fields: [referralCodeId], references: [id])
  documents           MemberDocument[]
  branchAccesses      BranchMemberAccess[]
  memberPackages      MemberPackage[]
  memberAddOns        MemberAddOn[]
  nonTherapyPurchases MemberNonTherapyPurchase[]
  invoices            Invoice[]
  encounters          Encounter[]
  diagnoses           Diagnosis[] // Direct diagnoses without encounter
  therapyPlans        TherapyPlan[] // Therapy plans for preparation
  therapyPlanSets     TherapyPlanSet[]
  chatRoom            ChatRoom?
  incentiveRecords    ReferralIncentiveRecord[]
  labResults          LabResult[]

  @@index([memberNo])
  @@index([registrationBranchId, isActive])
  @@index([referralCodeId])
  @@index([nik])
  @@index([voucherCount])
  @@map("members")
}

model MemberDocument {
  id           String       @id @default(cuid())
  memberId     String
  documentType DocumentType
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedBy   String
  createdAt    DateTime     @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, documentType])
  @@map("member_documents")
}

model BranchMemberAccess {
  id        String   @id @default(cuid())
  memberId  String
  branchId  String
  grantedBy String
  notes     String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([memberId, branchId])
  @@index([branchId])
  @@index([memberId])
  @@map("branch_member_access")
}

model ReferralCode {
  id           String       @id @default(cuid())
  code         String       @unique
  referrerName String
  referrerType ReferrerType
  branchId     String
  phone        String?
  email        String?

  // Statistics
  totalReferrals       Int     @default(0)
  totalIncentiveEarned Decimal @default(0) @db.Decimal(15, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch           Branch                    @relation(fields: [branchId], references: [id])
  members          Member[]
  incentiveRecords ReferralIncentiveRecord[]

  @@index([code])
  @@index([branchId])
  @@index([isActive])
  @@index([referrerType])
  @@map("referral_codes")
}

model ReferralIncentiveRecord {
  id              String @id @default(cuid())
  referralCodeId  String
  memberId        String
  memberPackageId String

  // Package Info (snapshot)
  packageType  String
  packageName  String
  packageValue Decimal @db.Decimal(15, 2)

  // Incentive Calculation
  isFirstPackage  Boolean
  incentiveType   IncentiveType
  incentiveValue  Decimal       @db.Decimal(10, 2)
  incentiveAmount Decimal       @db.Decimal(15, 2)

  // Metadata
  notes     String?
  createdAt DateTime @default(now())

  referralCode  ReferralCode  @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  member        Member        @relation(fields: [memberId], references: [id])
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id])

  @@index([referralCodeId])
  @@index([memberId])
  @@index([memberPackageId])
  @@index([createdAt])
  @@map("referral_incentive_records")
}

// ============================================================
// PACKAGE DOMAIN
// ============================================================

model MasterBoosterType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_booster_types")
}

model MasterServiceType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_service_types")
}

model PackagePricing {
  id            String      @id @default(cuid())
  branchId      String? // NULL = global pricing, specific ID = branch-specific pricing
  packageType   PackageType
  boosterType   String? // Custom booster type code (NO, GT, MB, KCL, H2S, HK, O3, or custom from MasterBoosterType)
  serviceType   String? // HC, PS, PHC, PTY, PDA for service type pricing
  productCode   String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  name          String
  totalSessions Int
  price         Decimal     @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  branch         Branch?         @relation(fields: [branchId], references: [id])
  memberPackages MemberPackage[]

  @@unique([branchId, packageType, boosterType, serviceType, totalSessions])
  @@index([branchId, isActive])
  @@index([packageType])
  @@map("package_pricings")
}

model MemberPackage {
  id               String        @id @default(cuid())
  packageCode      String        @unique
  memberId         String
  branchId         String
  packagePricingId String?
  packageType      PackageType
  productCode      String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  totalSessions    Int
  usedSessions     Int           @default(0)
  finalPrice       Decimal       @db.Decimal(12, 2)
  discountPercent  Decimal?      @db.Decimal(5, 2)
  discountAmount   Decimal?      @db.Decimal(12, 2)
  discountNote     String?
  notes            String?
  status           PackageStatus @default(PENDING_PAYMENT)
  paymentPlanType  PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal Int?
  installmentSchedule Json?
  totalVerifiedPaid Decimal @default(0) @db.Decimal(12, 2)
  paymentPlanStatus String?
  boosterType      String?
  serviceType      String? // HC, PS, PHC, PTY, PDA
  purchaseGroupId  String? // Group BASIC + BOOSTER purchased together
  upgradedFromId   String? // Track if this is an upgrade from another package

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  // Refund information (informasi pengembalian dana)
  refundAmount        Decimal?  @db.Decimal(12, 2)
  refundReason        String?
  refundProofUrl      String?
  refundProofFileName String?
  refundProofFileSize Int?
  refundProofMimeType String?
  refundedBy          String?
  refundedAt          DateTime?

  assignedBy  String
  verifiedBy  String?
  rejectedBy  String?
  paidAt      DateTime?
  verifiedAt  DateTime?
  rejectedAt  DateTime?
  rejectionReason String?
  activatedAt DateTime?
  expiredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  member           Member                    @relation(fields: [memberId], references: [id])
  branch           Branch                    @relation(fields: [branchId], references: [id])
  packagePricing   PackagePricing?           @relation(fields: [packagePricingId], references: [id])
  assignedByUser   User                      @relation("PackageAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser   User?                     @relation("PackageVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser   User?                     @relation("PackageRejectedBy", fields: [rejectedBy], references: [id])
  refundedByUser   User?                     @relation("PackageRefundedBy", fields: [refundedBy], references: [id])
  upgradedFrom     MemberPackage?            @relation("PackageUpgrade", fields: [upgradedFromId], references: [id], onDelete: SetNull)
  upgrades         MemberPackage[]           @relation("PackageUpgrade")
  encounters       Encounter[]               @relation("EncounterBasicPackage")
  boosterSessions  TreatmentSession[]        @relation("SessionBoosterPackage")
  addOns           MemberAddOn[]
  incentiveRecords ReferralIncentiveRecord[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([packageCode])
  @@index([memberId, packageType, status])
  @@index([purchaseGroupId])
  @@index([paymentProofUrl])
  @@index([refundedAt])
  @@index([refundProofUrl])
  @@map("member_packages")
}

model MemberAddOn {
  id           String        @id @default(cuid())
  addOnCode    String        @unique
  memberId     String
  branchId     String
  packageId    String? // Optional: link to package if purchased together
  addOnType    AddOnType
  quantity     Int           @default(1)
  pricePerUnit Decimal       @db.Decimal(12, 2)
  totalPrice   Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(PENDING_PAYMENT)
  paymentPlanType  PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal Int?
  installmentSchedule Json?
  totalVerifiedPaid Decimal @default(0) @db.Decimal(12, 2)
  paymentPlanStatus String?
  notes        String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy String
  verifiedBy String?
  rejectedBy String?
  paidAt     DateTime?
  verifiedAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member         @relation(fields: [memberId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  package        MemberPackage? @relation(fields: [packageId], references: [id])
  assignedByUser User           @relation("AddOnAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?          @relation("AddOnVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser User?          @relation("AddOnRejectedBy", fields: [rejectedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([addOnCode])
  @@index([paymentProofUrl])
  @@map("member_add_ons")
}

// ============================================================
// NON-THERAPY PRODUCTS DOMAIN
// ============================================================

model NonTherapyProduct {
  id          String      @id @default(cuid())
  productCode String      @unique
  productType ProductType
  name        String
  description String?

  // Air Nano specific fields
  airNanoColor  AirNanoColor?
  airNanoVolume AirNanoVolume?
  airNanoUnit   AirNanoUnit?

  // Pricing
  pricePerUnit Decimal @db.Decimal(12, 2)

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases MemberNonTherapyPurchase[]

  @@index([productType, isActive])
  @@index([productCode])
  @@map("non_therapy_products")
}

model MemberNonTherapyPurchase {
  id           String        @id @default(cuid())
  purchaseCode String        @unique
  memberId     String
  branchId     String
  productId    String
  quantity     Int           @default(1)
  pricePerUnit Decimal       @db.Decimal(12, 2)
  totalPrice   Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(PENDING_PAYMENT)
  notes        String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy String
  verifiedBy String?
  paidAt     DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member            @relation(fields: [memberId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  product        NonTherapyProduct @relation(fields: [productId], references: [id])
  assignedByUser User              @relation("NonTherapyAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?             @relation("NonTherapyVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([purchaseCode])
  @@index([paymentProofUrl])
  @@map("member_non_therapy_purchases")
}

// ============================================================
// INVOICE DOMAIN
// ============================================================

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  memberId      String
  branchId      String

  // Financial details
  subtotal        Decimal  @db.Decimal(12, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  discountNote    String?
  taxPercent      Decimal? @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal? @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)

  // Status and dates
  status      InvoiceStatus @default(DRAFT)
  paymentPlanType PaymentPlanType @default(FULL_PAYMENT)
  paymentGroupId String?
  installmentNumber Int?
  installmentTotal Int?
  installmentSchedule Json?
  totalPurchaseAmount Decimal? @db.Decimal(12, 2)
  installmentAmount Decimal? @db.Decimal(12, 2)
  carryOverAmount Decimal? @default(0) @db.Decimal(12, 2)
  creditAmount Decimal? @default(0) @db.Decimal(12, 2)
  actualPaidAmount Decimal? @db.Decimal(12, 2)
  paymentVerificationStatus PaymentVerificationStatus @default(PENDING)
  paymentRejectionReason String?
  isAdjustment Boolean @default(false)
  dueDate     DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  // Payment details
  paymentMethod    PaymentMethod?
  paymentReference String?
  paymentNotes     String?

  // Metadata
  notes      String?
  createdBy  String
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member           @relation(fields: [memberId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  createdByUser  User             @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  verifiedByUser User?            @relation("InvoiceVerifiedBy", fields: [verifiedBy], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([invoiceNumber])
  @@index([status, dueDate])
  @@index([paymentGroupId, installmentNumber])
  @@index([paymentPlanType])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  itemType       String // 'PACKAGE', 'ADDON', 'NON_THERAPY'
  itemId         String // Reference to MemberPackage, MemberAddOn, or MemberNonTherapyPurchase
  code           String? // Product code (e.g., TNB-P7-HC, BST-NO-P1-HC)
  description    String
  quantity       Int      @default(1)
  pricePerUnit   Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal? @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType, itemId])
  @@map("invoice_items")
}

model InvoicePayment {
  id               String        @id @default(cuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentReference String?
  notes            String?

  // Payment proof (bukti pembayaran)
  proofFileUrl  String?
  proofFileName String?
  proofFileSize Int?
  proofMimeType String?

  receivedBy String
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedByUser User    @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
  @@index([proofFileUrl])
  @@map("invoice_payments")
}

enum AddOnType {
  AIR_NANO
  KONSULTASI_GIZI
  KONSULTASI_PSIKOLOG
  ROKOK_KENKOU
  LAINNYA
}

enum ProductType {
  AIR_NANO
  ROKOK_KENKOU
}

enum AirNanoColor {
  KUNING
  BIRU
  HIJAU
}

enum AirNanoVolume {
  ML_600
  ML_1500
}

enum AirNanoUnit {
  BOTOL
  DUS
}

enum InvoiceStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
