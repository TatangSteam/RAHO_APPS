  costLayer     InventoryCostLayer       @relation(fields: [costLayerId], references: [id], onDelete: Restrict)
  reversalOf    InventoryCostAllocation? @relation("CostAllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy    InventoryCostAllocation? @relation("CostAllocationReversal")

  @@unique([postingId, stockMutationId, costLayerId, type])
  @@index([costLayerId, createdAt])
  @@index([stockMutationId])
  @@map("inventory_cost_allocations")
}

model InventoryAdjustmentReasonCode {
