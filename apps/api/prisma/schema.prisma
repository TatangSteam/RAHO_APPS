// ============================================================
// CORE DOMAIN
// ============================================================

model Branch {
  id             String     @id @default(cuid())
  branchCode     String     @unique
  name           String
  address        String?
  city           String?
  phone          String?
  type           BranchType @default(PREMIER)
  operatingHours String?
  isActive       Boolean    @default(true)
  createdBy      String? // User ID who created this branch
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  users                   User[]
  members                 Member[]
  branchMemberAccess      BranchMemberAccess[]
  memberPackages          MemberPackage[]
  memberAddOns            MemberAddOn[]
  nonTherapyPurchases     MemberNonTherapyPurchase[]
  invoices                Invoice[]
  packagePricings         PackagePricing[]
  inventoryItems          InventoryItem[]
  stockRequests           StockRequest[]             @relation("StockRequestDestination")
  stockRequestsFulfilled  StockRequest[]             @relation("StockRequestSource")
  shipmentsFrom           Shipment[]                 @relation("ShipmentFrom")
  shipmentsTo             Shipment[]                 @relation("ShipmentTo")
  encounters              Encounter[]
  treatmentSessions       TreatmentSession[]
  managerBranches         ManagerBranch[]
  staffBranches           StaffBranch[]              @relation("StaffBranches")
  referralCodes           ReferralCode[]
  auditLogs               AuditLog[]
  permissionOverrides     UserPermissionOverride[]
  accountingPeriods       AccountingPeriod[]
  journalEntries          JournalEntry[]
  journalLines            JournalLine[]
  cashBankAccounts        CashBankAccount[]
  cashBankTransactions    CashBankTransaction[]
  overstocks              BranchOverstock[]
  warehouses              Warehouse[]
  inventoryPostings       InventoryPosting[]
  inventoryBalances       InventoryBalance[]
  openingBalances         OpeningBalance[]
  expenses                Expense[]
  internalTransfersFrom   InternalTransferLedger[]   @relation("InternalTransferFromBranch")
  internalTransfersTo     InternalTransferLedger[]   @relation("InternalTransferToBranch")
  purchaseRequests        PurchaseRequest[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  supplierInvoices        SupplierInvoice[]
  supplierPayments        SupplierPayment[]
  packageRevenueContracts PackageRevenueContract[]
  domainEvents            DomainEvent[]
  revenueRecognitions     RevenueRecognition[]
  treatmentBoms           TreatmentBom[]
  approvalInstances       ApprovalInstance[]
  stockOpnames            StockOpname[]

  @@index([branchCode])
  @@index([isActive])
  @@index([createdBy])
  @@map("branches")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String
  role                    Role
  adminManagerAccessScope AdminManagerAccessScope @default(FULL)
  staffCode               String?                 @unique
  branchId                String?
  roleTemplateId          String?
  isActive                Boolean                 @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Relations
  branch                      Branch?                  @relation(fields: [branchId], references: [id])
  roleTemplate                RoleTemplate?            @relation(fields: [roleTemplateId], references: [id], onDelete: SetNull)
  profile                     UserProfile?
  member                      Member?
  auditLogs                   AuditLog[]
  notifications               Notification[]
  chatMessages                ChatMessage[]
  chatRooms                   ChatRoom[]               @relation("ChatRoomStaff")
  managedBranches             ManagerBranch[]
  staffBranches               StaffBranch[]            @relation("StaffBranches")
  permissionOverrides         UserPermissionOverride[] @relation("PermissionOverrideUser")
  permissionOverridesCreated  UserPermissionOverride[] @relation("PermissionOverrideCreatedBy")
  journalEntriesCreated       JournalEntry[]           @relation("JournalEntryCreatedBy")
  journalEntriesPosted        JournalEntry[]           @relation("JournalEntryPostedBy")
  accountingPeriodsCreated    AccountingPeriod[]       @relation("AccountingPeriodCreatedBy")
  accountingPeriodsClosed     AccountingPeriod[]       @relation("AccountingPeriodClosedBy")
  paymentsVerified            InvoicePayment[]         @relation("PaymentVerifiedBy")
  cashBankAccountsCreated     CashBankAccount[]        @relation("CashBankAccountCreatedBy")
  cashBankTransactionsCreated CashBankTransaction[]    @relation("CashBankTransactionCreatedBy")
  openingBalancesCreated      OpeningBalance[]         @relation("OpeningBalanceCreatedBy")
  openingBalancesReviewed     OpeningBalance[]         @relation("OpeningBalanceReviewedBy")
  expensesCreated             Expense[]                @relation("ExpenseCreatedBy")
  expensesReviewed            Expense[]                @relation("ExpenseReviewedBy")
  expensesPaid                Expense[]                @relation("ExpensePaidBy")
  suppliersCreated            Supplier[]               @relation("SupplierCreatedBy")
  purchaseRequestsCreated     PurchaseRequest[]        @relation("PurchaseRequestCreatedBy")
  purchaseRequestsReviewed    PurchaseRequest[]        @relation("PurchaseRequestReviewedBy")
  purchaseOrdersCreated       PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  goodsReceiptsCreated        GoodsReceipt[]           @relation("GoodsReceiptCreatedBy")
  supplierInvoicesCreated     SupplierInvoice[]        @relation("SupplierInvoiceCreatedBy")
  supplierPaymentsCreated     SupplierPayment[]        @relation("SupplierPaymentCreatedBy")
  revenuePoliciesCreated      PackageRevenuePolicy[]   @relation("RevenuePolicyCreatedBy")
  approvalInstancesMade       ApprovalInstance[]       @relation("ApprovalInstanceMaker")
  approvalDecisions           ApprovalDecision[]       @relation("ApprovalDecisionApprover")
  approvalAuditLogs           ApprovalAuditLog[]       @relation("ApprovalAuditActor")
  stockOpnamesCreated         StockOpname[]            @relation("StockOpnameCreatedBy")

  sessionsAsAdmin  TreatmentSession[] @relation("SessionAdmin")
  sessionsAsDoctor TreatmentSession[] @relation("SessionDoctor")
  sessionsAsNurse  TreatmentSession[] @relation("SessionNurse")

  // Multiple doctors/nurses per session
  sessionDoctorAssignments SessionDoctor[] @relation("SessionDoctorStaff")
  sessionNurseAssignments  SessionNurse[]  @relation("SessionNurseStaff")

  packagesAssigned   MemberPackage[]            @relation("PackageAssignedBy")
  packagesVerified   MemberPackage[]            @relation("PackageVerifiedBy")
  packagesRejected   MemberPackage[]            @relation("PackageRejectedBy")
  packagesRefunded   MemberPackage[]            @relation("PackageRefundedBy")
  addOnsAssigned     MemberAddOn[]              @relation("AddOnAssignedBy")
  addOnsVerified     MemberAddOn[]              @relation("AddOnVerifiedBy")
  addOnsRejected     MemberAddOn[]              @relation("AddOnRejectedBy")
  nonTherapyAssigned MemberNonTherapyPurchase[] @relation("NonTherapyAssignedBy")
  nonTherapyVerified MemberNonTherapyPurchase[] @relation("NonTherapyVerifiedBy")
  invoicesCreated    Invoice[]                  @relation("InvoiceCreatedBy")
  invoicesVerified   Invoice[]                  @relation("InvoiceVerifiedBy")
  paymentsReceived   InvoicePayment[]           @relation("PaymentReceivedBy")
  uploadedLabResults LabResult[]

  @@index([email])
  @@index([role])
  @@index([branchId, role, isActive])
  @@index([roleTemplateId])
  @@index([staffCode])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@map("user_profiles")
}

model ManagerBranch {
  id          String                  @id @default(cuid())
  userId      String
  branchId    String
  accessScope AdminManagerAccessScope @default(FULL)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([accessScope])
  @@map("manager_branches")
}

model StaffBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("StaffBranches", fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation("StaffBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("staff_branches")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  isSensitive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleTemplates RoleTemplatePermission[]
  userOverrides UserPermissionOverride[]

  @@index([module, isActive])
  @@map("permissions")
}

model RoleTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  baseRole    Role?    @unique
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RoleTemplatePermission[]
  users       User[]

  @@index([isActive])
  @@map("role_templates")
}

model RoleTemplatePermission {
  id             String   @id @default(cuid())
  roleTemplateId String
  permissionId   String
  createdAt      DateTime @default(now())

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, permissionId])
  @@index([permissionId])
  @@map("role_template_permissions")
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect
  branchId     String?
  scopeKey     String           @default("GLOBAL")
  reason       String?
  validUntil   DateTime?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation("PermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator    User       @relation("PermissionOverrideCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId, scopeKey])
  @@index([userId, effect])
  @@index([branchId])
  @@index([validUntil])
  @@map("user_permission_overrides")
}

// ============================================================
// ACCOUNTING FOUNDATION
// ============================================================

model Account {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  level         Int           @default(1)
  allowPosting  Boolean       @default(true)
  isControl     Boolean       @default(false)
  isActive      Boolean       @default(true)
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent                  Account?               @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                Account[]              @relation("AccountHierarchy")
  lines                   JournalLine[]
  cashBankAccounts        CashBankAccount[]
  openingBalanceLines     OpeningBalanceLine[]
  expenses                Expense[]
  supplierInvoiceDebits   SupplierInvoice[]      @relation("SupplierInvoiceGrniAccount")
  supplierInvoiceCredits  SupplierInvoice[]      @relation("SupplierInvoiceApAccount")
  revenuePolicies         PackageRevenuePolicy[] @relation("RevenuePolicyRevenueAccount")
  deferredRevenuePolicies PackageRevenuePolicy[] @relation("RevenuePolicyDeferredAccount")

  @@index([type, isActive])
  @@index([parentId])
  @@map("accounts")
}

model AccountingPeriod {
  id         String                 @id @default(cuid())
  name       String
  fiscalYear Int
  periodNo   Int
  startDate  DateTime
  endDate    DateTime
  branchId   String?
  scopeKey   String                 @default("GLOBAL")
  status     AccountingPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedBy   String?
  createdBy  String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator        User           @relation("AccountingPeriodCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  closer         User?          @relation("AccountingPeriodClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([fiscalYear, periodNo, scopeKey])
  @@index([scopeKey, status, startDate, endDate])
  @@index([branchId, status])
  @@map("accounting_periods")
}

model JournalEntry {
  id                 String        @id @default(cuid())
  journalNumber      String        @unique
  postingKey         String        @unique
  payloadHash        String
  transactionDate    DateTime
  description        String
  branchId           String
  accountingPeriodId String
  status             JournalStatus @default(POSTED)
  totalDebit         Decimal       @db.Decimal(18, 2)
  totalCredit        Decimal       @db.Decimal(18, 2)
  metadata           Json?
  postedAt           DateTime      @default(now())
  createdBy          String
  postedBy           String
  reversedAt         DateTime?
  reversedByEntryId  String?       @unique
  createdAt          DateTime      @default(now())

  branch                    Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accountingPeriod          AccountingPeriod          @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  creator                   User                      @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  poster                    User                      @relation("JournalEntryPostedBy", fields: [postedBy], references: [id], onDelete: Restrict)
  reversedByEntry           JournalEntry?             @relation("JournalReversal", fields: [reversedByEntryId], references: [id], onDelete: Restrict)
  reversesEntry             JournalEntry?             @relation("JournalReversal")
  lines                     JournalLine[]
  sourceLinks               JournalSourceLink[]
  cashBankTransactions      CashBankTransaction[]
  openingBalance            OpeningBalance?
  expense                   Expense?
  transferDispatch          InternalTransferLedger?   @relation("TransferDispatchJournal")
  transferReceipt           InternalTransferLedger?   @relation("TransferReceiptJournal")
  goodsReceipt              GoodsReceipt?
  supplierInvoice           SupplierInvoice?
  supplierPayment           SupplierPayment?
  deferredRevenueMovements  DeferredRevenueMovement[]
  revenueRecognitions       RevenueRecognition[]
  completedTreatmentSession TreatmentSession?         @relation("TreatmentCompletionJournal")
  cancelledTreatmentSession TreatmentSession?         @relation("TreatmentCancellationJournal")
  stockOpname               StockOpname?

  @@index([branchId, transactionDate])
  @@index([accountingPeriodId, status])
  @@index([status, postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  lineNo         Int
  accountId      String
  branchId       String
  costCenterCode String?
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  metadata       Json?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNo])
  @@index([accountId, createdAt])
  @@index([branchId, createdAt])
  @@index([costCenterCode, createdAt])
  @@map("journal_lines")
}

model JournalSourceLink {
  id             String   @id @default(cuid())
  journalEntryId String
  sourceType     String
  sourceId       String
  sourceNumber   String?
  relationType   String   @default("PRIMARY")
  metadata       Json?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, sourceType, sourceId, relationType])
  @@index([sourceType, sourceId])
  @@index([sourceNumber])
  @@map("journal_source_links")
}

model JournalSequence {
  id         String   @id @default(cuid())
  scopeKey   String
  fiscalYear Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([scopeKey, fiscalYear])
  @@map("journal_sequences")
}

// ============================================================
// MEMBER DOMAIN
// ============================================================

model Member {
  id                   String  @id @default(cuid())
  userId               String  @unique
  memberNo             String  @unique
  registrationBranchId String
  referralCodeId       String?

  // Incentive Settings (per member)
  firstIncentiveType  IncentiveType?
  firstIncentiveValue Decimal?       @db.Decimal(10, 2)
  nextIncentiveType   IncentiveType?
  nextIncentiveValue  Decimal?       @db.Decimal(10, 2)

  voucherCount     Int       @default(0)
  isConsentToPhoto Boolean   @default(true)
  nik              String?   @unique
  tempatLahir      String?
  dateOfBirth      DateTime?
  jenisKelamin     Gender?
  agama            String? // Religion field
  address          String?
  pekerjaan        String?
  statusNikah      String?
  emergencyContact String?
  sumberInfoRaho   String?
  postalCode       String?
  isDeceased       Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                User                       @relation(fields: [userId], references: [id])
  registrationBranch  Branch                     @relation(fields: [registrationBranchId], references: [id])
  referralCode        ReferralCode?              @relation(fields: [referralCodeId], references: [id])
  documents           MemberDocument[]
  branchAccesses      BranchMemberAccess[]
  memberPackages      MemberPackage[]
  memberAddOns        MemberAddOn[]
  nonTherapyPurchases MemberNonTherapyPurchase[]
  invoices            Invoice[]
  encounters          Encounter[]
  diagnoses           Diagnosis[] // Direct diagnoses without encounter
  therapyPlans        TherapyPlan[] // Therapy plans for preparation
  therapyPlanSets     TherapyPlanSet[]
  chatRoom            ChatRoom?
  incentiveRecords    ReferralIncentiveRecord[]
  labResults          LabResult[]

  @@index([memberNo])
  @@index([registrationBranchId, isActive])
  @@index([referralCodeId])
  @@index([nik])
  @@index([dateOfBirth])
  @@index([voucherCount])
  @@map("members")
}

model MemberDocument {
  id           String       @id @default(cuid())
  memberId     String
  documentType DocumentType
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedBy   String
  createdAt    DateTime     @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, documentType])
  @@map("member_documents")
}

model BranchMemberAccess {
  id        String   @id @default(cuid())
  memberId  String
  branchId  String
  grantedBy String
  notes     String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([memberId, branchId])
  @@index([branchId])
  @@index([memberId])
  @@map("branch_member_access")
}

model ReferralCode {
  id           String       @id @default(cuid())
  code         String       @unique
  referrerName String
  referrerType ReferrerType
  branchId     String
  phone        String?
  email        String?

  // Statistics
  totalReferrals       Int     @default(0)
  totalIncentiveEarned Decimal @default(0) @db.Decimal(15, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch           Branch                    @relation(fields: [branchId], references: [id])
  members          Member[]
  incentiveRecords ReferralIncentiveRecord[]

  @@index([code])
  @@index([branchId])
  @@index([isActive])
  @@index([referrerType])
  @@map("referral_codes")
}

model ReferralIncentiveRecord {
  id              String @id @default(cuid())
  referralCodeId  String
  memberId        String
  memberPackageId String

  // Package Info (snapshot)
  packageType  String
  packageName  String
  packageValue Decimal @db.Decimal(15, 2)

  // Incentive Calculation
  isFirstPackage  Boolean
  incentiveType   IncentiveType
  incentiveValue  Decimal       @db.Decimal(10, 2)
  incentiveAmount Decimal       @db.Decimal(15, 2)

  // Metadata
  notes     String?
  createdAt DateTime @default(now())

  referralCode  ReferralCode  @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  member        Member        @relation(fields: [memberId], references: [id])
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id])

  @@index([referralCodeId])
  @@index([memberId])
  @@index([memberPackageId])
  @@index([createdAt])
  @@map("referral_incentive_records")
}

// ============================================================
// PACKAGE DOMAIN
// ============================================================

model MasterBoosterType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_booster_types")
}

model MasterServiceType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_service_types")
}

model PackagePricing {
  id            String      @id @default(cuid())
  branchId      String? // NULL = global pricing, specific ID = branch-specific pricing
  packageType   PackageType
  boosterType   String? // Custom booster type code (NO, GT, MB, KCL, H2S, HK, O3, or custom from MasterBoosterType)
  serviceType   String? // HC, PS, PHC, PTY, PDA for service type pricing
  productCode   String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  name          String
  totalSessions Int
  price         Decimal     @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  branch         Branch?               @relation(fields: [branchId], references: [id])
  memberPackages MemberPackage[]
  revenuePolicy  PackageRevenuePolicy?
  treatmentBoms  TreatmentBom[]

  @@unique([branchId, packageType, boosterType, serviceType, totalSessions, productCode], map: "package_pricing_identity_unique")
  @@index([branchId, isActive])
  @@index([packageType])
  @@map("package_pricings")
}

model MemberPackage {
  id                  String          @id @default(cuid())
  packageCode         String          @unique
  memberId            String
  branchId            String
  packagePricingId    String?
  packageType         PackageType
  productCode         String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  totalSessions       Int
  usedSessions        Int             @default(0)
  finalPrice          Decimal         @db.Decimal(12, 2)
  discountPercent     Decimal?        @db.Decimal(5, 2)
  discountAmount      Decimal?        @db.Decimal(12, 2)
  discountNote        String?
  notes               String?
  status              PackageStatus   @default(PENDING_PAYMENT)
  paymentPlanType     PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal    Int?
  installmentSchedule Json?
  totalVerifiedPaid   Decimal         @default(0) @db.Decimal(12, 2)
  paymentPlanStatus   String?
  boosterType         String?
  serviceType         String? // HC, PS, PHC, PTY, PDA
  purchaseGroupId     String? // Group BASIC + BOOSTER purchased together
  upgradedFromId      String? // Track if this is an upgrade from another package

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  // Refund information (informasi pengembalian dana)
  refundAmount        Decimal?  @db.Decimal(12, 2)
  refundReason        String?
  refundProofUrl      String?
  refundProofFileName String?
  refundProofFileSize Int?
  refundProofMimeType String?
  refundedBy          String?
  refundedAt          DateTime?

  assignedBy      String
  verifiedBy      String?
  rejectedBy      String?
  paidAt          DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  activatedAt     DateTime?
  expiredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member                   Member                    @relation(fields: [memberId], references: [id])
  branch                   Branch                    @relation(fields: [branchId], references: [id])
  packagePricing           PackagePricing?           @relation(fields: [packagePricingId], references: [id])
  assignedByUser           User                      @relation("PackageAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser           User?                     @relation("PackageVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser           User?                     @relation("PackageRejectedBy", fields: [rejectedBy], references: [id])
  refundedByUser           User?                     @relation("PackageRefundedBy", fields: [refundedBy], references: [id])
  upgradedFrom             MemberPackage?            @relation("PackageUpgrade", fields: [upgradedFromId], references: [id], onDelete: SetNull)
  upgrades                 MemberPackage[]           @relation("PackageUpgrade")
  encounters               Encounter[]               @relation("EncounterBasicPackage")
  boosterSessions          TreatmentSession[]        @relation("SessionBoosterPackage")
  addOns                   MemberAddOn[]
  incentiveRecords         ReferralIncentiveRecord[]
  benefitValuation         PackageBenefitValuation?
  revenueContract          PackageRevenueContract?
  deferredRevenueMovements DeferredRevenueMovement[]
  revenueRecognitions      RevenueRecognition[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([packageCode])
  @@index([memberId, packageType, status])
  @@index([purchaseGroupId])
  @@index([paymentProofUrl])
  @@index([refundedAt])
  @@index([refundProofUrl])
  @@map("member_packages")
}

// ============================================================
// DEFERRED REVENUE & REVENUE RECOGNITION
// ============================================================

model PackageRevenuePolicy {
  id                       String                   @id @default(cuid())
  packagePricingId         String                   @unique
  version                  Int                      @default(1)
  recognitionMethod        RevenueRecognitionMethod @default(PER_SESSION)
  deferredRevenueAccountId String
  revenueAccountId         String
  isActive                 Boolean                  @default(true)
  effectiveFrom            DateTime                 @default(now())
  effectiveTo              DateTime?
  createdBy                String
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  packagePricing         PackagePricing            @relation(fields: [packagePricingId], references: [id], onDelete: Restrict)
  deferredRevenueAccount Account                   @relation("RevenuePolicyDeferredAccount", fields: [deferredRevenueAccountId], references: [id], onDelete: Restrict)
  revenueAccount         Account                   @relation("RevenuePolicyRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  creator                User                      @relation("RevenuePolicyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  valuations             PackageBenefitValuation[]

  @@index([isActive, effectiveFrom])
  @@map("package_revenue_policies")
}

model PackageBenefitValuation {
  id                         String                   @id @default(cuid())
  memberPackageId            String                   @unique
  policyId                   String?
  policyVersion              Int                      @default(1)
  recognitionMethod          RevenueRecognitionMethod @default(PER_SESSION)
  standaloneBenefitValue     Decimal                  @db.Decimal(18, 2)
  allocatedConsideration     Decimal                  @db.Decimal(18, 2)
  totalSessions              Int
  regularSessionRevenue      Decimal                  @db.Decimal(18, 2)
  finalSessionRevenue        Decimal                  @db.Decimal(18, 2)
  deferredRevenueAccountCode String                   @default("2200")
  revenueAccountCode         String                   @default("4100")
  allocationSnapshot         Json
  valuedAt                   DateTime                 @default(now())
  createdAt                  DateTime                 @default(now())

  memberPackage MemberPackage           @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)
  policy        PackageRevenuePolicy?   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  contract      PackageRevenueContract?

  @@index([policyId, valuedAt])
  @@map("package_benefit_valuations")
}

model PackageRevenueContract {
  id                      String                       @id @default(cuid())
  memberPackageId         String                       @unique
  valuationId             String                       @unique
  branchId                String
  totalConsideration      Decimal                      @db.Decimal(18, 2)
  fundedDeferredAmount    Decimal                      @default(0) @db.Decimal(18, 2)
  recognizedAmount        Decimal                      @default(0) @db.Decimal(18, 2)
  remainingDeferredAmount Decimal                      @default(0) @db.Decimal(18, 2)
  recognizedSessions      Int                          @default(0)
  status                  PackageRevenueContractStatus @default(UNFUNDED)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  memberPackage MemberPackage             @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)
  valuation     PackageBenefitValuation   @relation(fields: [valuationId], references: [id], onDelete: Restrict)
  branch        Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  movements     DeferredRevenueMovement[]
  recognitions  RevenueRecognition[]

  @@index([branchId, status])
  @@map("package_revenue_contracts")
}

model DeferredRevenueMovement {
  id                 String                      @id @default(cuid())
  movementKey        String                      @unique
  contractId         String
  memberPackageId    String
  invoicePaymentId   String?
  treatmentSessionId String?
  journalEntryId     String?
  type               DeferredRevenueMovementType
  amount             Decimal                     @db.Decimal(18, 2)
  occurredAt         DateTime                    @default(now())
  metadata           Json?
  createdAt          DateTime                    @default(now())

  contract         PackageRevenueContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  memberPackage    MemberPackage          @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)
  invoicePayment   InvoicePayment?        @relation(fields: [invoicePaymentId], references: [id], onDelete: Restrict)
  treatmentSession TreatmentSession?      @relation(fields: [treatmentSessionId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([invoicePaymentId, memberPackageId, type])
  @@index([contractId, occurredAt])
  @@index([treatmentSessionId])
  @@map("deferred_revenue_movements")
}

model DomainEvent {
  id                 String            @id @default(cuid())
  eventKey           String            @unique
  eventType          String
  aggregateType      String
  aggregateId        String
  branchId           String
  treatmentSessionId String?           @unique
  payloadHash        String
  payload            Json
  status             DomainEventStatus @default(PENDING)
  occurredAt         DateTime          @default(now())
  processedAt        DateTime?
  failureReason      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  treatmentSession TreatmentSession?    @relation(fields: [treatmentSessionId], references: [id], onDelete: Restrict)
  recognitions     RevenueRecognition[]

  @@index([eventType, status, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("domain_events")
}

model RevenueRecognition {
  id                 String                   @id @default(cuid())
  recognitionKey     String                   @unique
  domainEventId      String
  treatmentSessionId String
  memberPackageId    String
  contractId         String
  branchId           String
  sessionOrdinal     Int
  amount             Decimal                  @db.Decimal(18, 2)
  status             RevenueRecognitionStatus @default(RESERVED)
  journalEntryId     String?
  recognizedAt       DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  domainEvent      DomainEvent            @relation(fields: [domainEventId], references: [id], onDelete: Restrict)
  treatmentSession TreatmentSession       @relation(fields: [treatmentSessionId], references: [id], onDelete: Restrict)
  memberPackage    MemberPackage          @relation(fields: [memberPackageId], references: [id], onDelete: Restrict)
  contract         PackageRevenueContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  branch           Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([treatmentSessionId, memberPackageId])
  @@index([journalEntryId])
  @@index([contractId, status])
  @@index([branchId, recognizedAt])
  @@map("revenue_recognitions")
}

model MemberAddOn {
  id                  String          @id @default(cuid())
  addOnCode           String          @unique
  memberId            String
  branchId            String
  packageId           String? // Optional: link to package if purchased together
  addOnType           AddOnType
  quantity            Int             @default(1)
  pricePerUnit        Decimal         @db.Decimal(12, 2)
  totalPrice          Decimal         @db.Decimal(12, 2)
  status              PackageStatus   @default(PENDING_PAYMENT)
  paymentPlanType     PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal    Int?
  installmentSchedule Json?
  totalVerifiedPaid   Decimal         @default(0) @db.Decimal(12, 2)
  paymentPlanStatus   String?
  notes               String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy      String
  verifiedBy      String?
  rejectedBy      String?
  paidAt          DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member         Member         @relation(fields: [memberId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  package        MemberPackage? @relation(fields: [packageId], references: [id])
  assignedByUser User           @relation("AddOnAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?          @relation("AddOnVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser User?          @relation("AddOnRejectedBy", fields: [rejectedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([addOnCode])
  @@index([paymentProofUrl])
  @@map("member_add_ons")
}

// ============================================================
// NON-THERAPY PRODUCTS DOMAIN
// ============================================================

model NonTherapyProduct {
  id          String      @id @default(cuid())
  productCode String      @unique
  productType ProductType
  name        String
  description String?

  // Air Nano specific fields
  airNanoColor  AirNanoColor?
  airNanoVolume AirNanoVolume?
  airNanoUnit   AirNanoUnit?

  // Pricing
  pricePerUnit Decimal @db.Decimal(12, 2)

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases MemberNonTherapyPurchase[]

  @@index([productType, isActive])
  @@index([productCode])
  @@map("non_therapy_products")
}

model MemberNonTherapyPurchase {
  id           String        @id @default(cuid())
  purchaseCode String        @unique
  memberId     String
  branchId     String
  productId    String
  quantity     Int           @default(1)
  pricePerUnit Decimal       @db.Decimal(12, 2)
  totalPrice   Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(PENDING_PAYMENT)
  notes        String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy String
  verifiedBy String?
  paidAt     DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member            @relation(fields: [memberId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  product        NonTherapyProduct @relation(fields: [productId], references: [id])
  assignedByUser User              @relation("NonTherapyAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?             @relation("NonTherapyVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([purchaseCode])
  @@index([paymentProofUrl])
  @@map("member_non_therapy_purchases")
}

// ============================================================
// INVOICE DOMAIN
// ============================================================

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  memberId      String
  branchId      String

  // Financial details
  subtotal              Decimal   @db.Decimal(12, 2)
  discountPercent       Decimal?  @db.Decimal(5, 2)
  discountAmount        Decimal?  @db.Decimal(12, 2)
  discountNote          String?
  taxPercent            Decimal?  @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal?  @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal   @db.Decimal(12, 2)
  currency              String    @default("IDR")
  snapshotVersion       Int       @default(1)
  customerSnapshot      Json?
  branchSnapshot        Json?
  termsSnapshot         Json?
  finalizedAt           DateTime?
  settlementAccountCode String    @default("2200")

  // Status and dates
  status                    InvoiceStatus             @default(DRAFT)
  paymentPlanType           PaymentPlanType           @default(FULL_PAYMENT)
  paymentGroupId            String?
  installmentNumber         Int?
  installmentTotal          Int?
  installmentSchedule       Json?
  totalPurchaseAmount       Decimal?                  @db.Decimal(12, 2)
  installmentAmount         Decimal?                  @db.Decimal(12, 2)
  carryOverAmount           Decimal?                  @default(0) @db.Decimal(12, 2)
  creditAmount              Decimal?                  @default(0) @db.Decimal(12, 2)
  actualPaidAmount          Decimal?                  @db.Decimal(12, 2)
  paymentVerificationStatus PaymentVerificationStatus @default(PENDING)
  paymentRejectionReason    String?
  isAdjustment              Boolean                   @default(false)
  dueDate                   DateTime?
  paidAt                    DateTime?
  cancelledAt               DateTime?

  // Payment details
  paymentMethod    PaymentMethod?
  paymentReference String?
  paymentNotes     String?

  // Metadata
  notes      String?
  createdBy  String
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member           @relation(fields: [memberId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  createdByUser  User             @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  verifiedByUser User?            @relation("InvoiceVerifiedBy", fields: [verifiedBy], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([invoiceNumber])
  @@index([status, dueDate])
  @@index([paymentGroupId, installmentNumber])
  @@index([paymentPlanType])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  itemType       String // 'PACKAGE', 'ADDON', 'NON_THERAPY'
  itemId         String // Reference to MemberPackage, MemberAddOn, or MemberNonTherapyPurchase
  code           String? // Product code (e.g., TNB-P7-HC, BST-NO-P1-HC)
  description    String
  quantity       Int      @default(1)
  pricePerUnit   Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal? @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType, itemId])
  @@map("invoice_items")
}

model InvoicePayment {
  id                 String                    @id @default(cuid())
  invoiceId          String
  idempotencyKey     String                    @unique
  payloadHash        String
  amount             Decimal                   @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  cashBankAccountId  String?
  paymentReference   String?
  notes              String?
  verificationStatus PaymentVerificationStatus @default(PENDING)
  verificationReason String?
  verifiedBy         String?
  verifiedAt         DateTime?

  // Payment proof (bukti pembayaran)
  proofFileUrl  String?
  proofFileName String?
  proofFileSize Int?
  proofMimeType String?
  proofChecksum String?

  receivedBy String
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  invoice                  Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedByUser           User                      @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])
  verifiedByUser           User?                     @relation("PaymentVerifiedBy", fields: [verifiedBy], references: [id])
  cashBankAccount          CashBankAccount?          @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  cashBankTransaction      CashBankTransaction?
  deferredRevenueMovements DeferredRevenueMovement[]

  @@index([invoiceId])
  @@index([invoiceId, verificationStatus])
  @@index([cashBankAccountId, verificationStatus])
  @@index([receivedAt])
  @@index([proofFileUrl])
  @@map("invoice_payments")
}

model CashBankAccount {
  id                String              @id @default(cuid())
  code              String              @unique
  name              String
  type              CashBankAccountType
  branchId          String
  coaAccountId      String
  currency          String              @default("IDR")
  bankName          String?
  accountNumber     String?
  accountHolderName String?
  requiresReference Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  branch              Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coaAccount          Account               @relation(fields: [coaAccountId], references: [id], onDelete: Restrict)
  creator             User                  @relation("CashBankAccountCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  payments            InvoicePayment[]
  transactions        CashBankTransaction[]
  openingBalanceLines OpeningBalanceLine[]
  expenses            Expense[]
  supplierPayments    SupplierPayment[]

  @@unique([branchId, name])
  @@index([branchId, type, isActive])
  @@map("cash_bank_accounts")
}

model CashBankTransaction {
  id                String                    @id @default(cuid())
  transactionNumber String                    @unique
  postingKey        String                    @unique
  cashBankAccountId String
  branchId          String
  transactionDate   DateTime
  type              CashBankTransactionType
  status            CashBankTransactionStatus @default(POSTED)
  amount            Decimal                   @db.Decimal(18, 2)
  sourceType        String
  sourceId          String
  sourceNumber      String?
  invoicePaymentId  String?                   @unique
  journalEntryId    String
  description       String
  metadata          Json?
  createdBy         String
  createdAt         DateTime                  @default(now())

  cashBankAccount    CashBankAccount     @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoicePayment     InvoicePayment?     @relation(fields: [invoicePaymentId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  creator            User                @relation("CashBankTransactionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  openingBalanceLine OpeningBalanceLine?
  expense            Expense?
  supplierPayment    SupplierPayment?

  @@index([cashBankAccountId, transactionDate])
  @@index([branchId, transactionDate])
  @@index([sourceType, sourceId])
  @@index([status, transactionDate])
  @@map("cash_bank_transactions")
}

model OpeningBalance {
  id              String               @id @default(cuid())
  documentNumber  String               @unique
  postingKey      String               @unique
  payloadHash     String
  branchId        String
  balanceDate     DateTime
  description     String
  status          OpeningBalanceStatus @default(DRAFT)
  totalDebit      Decimal              @default(0) @db.Decimal(18, 2)
  totalCredit     Decimal              @default(0) @db.Decimal(18, 2)
  journalEntryId  String?              @unique
  rejectionReason String?
  createdBy       String
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  postedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator      User                 @relation("OpeningBalanceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer     User?                @relation("OpeningBalanceReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines        OpeningBalanceLine[]

  @@index([branchId, balanceDate])
  @@index([status, createdAt])
  @@map("opening_balances")
}

model OpeningBalanceLine {
  id                    String                 @id @default(cuid())
  openingBalanceId      String
  lineNo                Int
  type                  OpeningBalanceLineType
  accountId             String
  description           String
  debit                 Decimal                @default(0) @db.Decimal(18, 2)
  credit                Decimal                @default(0) @db.Decimal(18, 2)
  counterpartyRef       String?
  cashBankAccountId     String?
  inventoryItemId       String?
  stockLocationId       String?
  quantity              Decimal?               @db.Decimal(18, 4)
  unitCost              Decimal?               @db.Decimal(18, 4)
  batchNumber           String?
  manufactureDate       DateTime?
  expiryDate            DateTime?
  inventoryPostingId    String?                @unique
  cashBankTransactionId String?                @unique
  metadata              Json?
  createdAt             DateTime               @default(now())

  openingBalance      OpeningBalance       @relation(fields: [openingBalanceId], references: [id], onDelete: Cascade)
  account             Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  cashBankAccount     CashBankAccount?     @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  inventoryItem       InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockLocation       StockLocation?       @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  inventoryPosting    InventoryPosting?    @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  cashBankTransaction CashBankTransaction? @relation(fields: [cashBankTransactionId], references: [id], onDelete: Restrict)

  @@unique([openingBalanceId, lineNo])
  @@index([type, accountId])
  @@index([inventoryItemId, stockLocationId])
  @@map("opening_balance_lines")
}

model Expense {
  id                    String        @id @default(cuid())
  expenseNumber         String        @unique
  postingKey            String        @unique
  payloadHash           String
  branchId              String
  expenseDate           DateTime
  category              String
  description           String
  amount                Decimal       @db.Decimal(18, 2)
  expenseAccountId      String
  cashBankAccountId     String
  status                ExpenseStatus @default(DRAFT)
  evidenceFileUrl       String?
  evidenceFileName      String?
  evidenceFileSize      Int?
  evidenceMimeType      String?
  evidenceChecksum      String?
  approvalNote          String?
  rejectionReason       String?
  journalEntryId        String?       @unique
  cashBankTransactionId String?       @unique
  createdBy             String
  submittedAt           DateTime?
  reviewedBy            String?
  reviewedAt            DateTime?
  paidBy                String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  expenseAccount      Account              @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  cashBankAccount     CashBankAccount      @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  creator             User                 @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer            User?                @relation("ExpenseReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  payer               User?                @relation("ExpensePaidBy", fields: [paidBy], references: [id], onDelete: Restrict)
  journalEntry        JournalEntry?        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  cashBankTransaction CashBankTransaction? @relation(fields: [cashBankTransactionId], references: [id], onDelete: Restrict)

  @@index([branchId, expenseDate])
  @@index([status, createdAt])
  @@index([expenseAccountId])
  @@map("expenses")
}

// Generic, immutable workflow used by finance, purchasing, and inventory.
model ApprovalRule {
  id              String   @id @default(cuid())
  ruleCode        String   @unique
  name            String
  module          String
  transactionType String   @default("*")
  branchScopeKey  String   @default("GLOBAL")
  categoryKey     String   @default("*")
  minAmount       Decimal  @default(0) @db.Decimal(18, 2)
  maxAmount       Decimal? @db.Decimal(18, 2)
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps     ApprovalRuleStep[]
  instances ApprovalInstance[]

  @@index([module, transactionType, isActive, priority])
  @@index([branchScopeKey, categoryKey])
  @@map("approval_rules")
}

model ApprovalRuleStep {
  id                String @id @default(cuid())
  approvalRuleId    String
  stepNo            Int
  name              String
  permissionCode    String
  requiredApprovals Int    @default(1)

  rule ApprovalRule @relation(fields: [approvalRuleId], references: [id], onDelete: Restrict)

  @@unique([approvalRuleId, stepNo])
  @@map("approval_rule_steps")
}

model ApprovalInstance {
  id              String                 @id @default(cuid())
  entityKey       String                 @unique
  module          String
  entityType      String
  entityId        String
  entityNumber    String?
  branchId        String
  makerUserId     String
  amount          Decimal                @default(0) @db.Decimal(18, 2)
  category        String?
  transactionType String
  approvalRuleId  String
  ruleSnapshot    Json
  payloadHash     String
  status          ApprovalInstanceStatus @default(PENDING)
  currentStep     Int                    @default(1)
  submittedAt     DateTime               @default(now())
  completedAt     DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  rule        ApprovalRule       @relation(fields: [approvalRuleId], references: [id], onDelete: Restrict)
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  maker       User               @relation("ApprovalInstanceMaker", fields: [makerUserId], references: [id], onDelete: Restrict)
  decisions   ApprovalDecision[]
  auditLogs   ApprovalAuditLog[]
  stockOpname StockOpname?

  @@index([module, status, branchId, submittedAt])
  @@index([entityType, entityId])
  @@map("approval_instances")
}

model ApprovalDecision {
  id                 String               @id @default(cuid())
  approvalInstanceId String
  stepNo             Int
  decision           ApprovalDecisionType
  approverUserId     String
  permissionCode     String
  note               String?
  decidedAt          DateTime             @default(now())

  instance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  approver User             @relation("ApprovalDecisionApprover", fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([approvalInstanceId, stepNo, approverUserId])
  @@index([approverUserId, decidedAt])
  @@map("approval_decisions")
}

model ApprovalAuditLog {
  id                 String   @id @default(cuid())
  approvalInstanceId String
  action             String
  actorUserId        String
  stepNo             Int?
  beforeStatus       String?
  afterStatus        String
  metadata           Json?
  createdAt          DateTime @default(now())

  instance ApprovalInstance @relation(fields: [approvalInstanceId], references: [id], onDelete: Restrict)
  actor    User             @relation("ApprovalAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([approvalInstanceId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("approval_audit_logs")
}

// ============================================================
// PURCHASING & ACCOUNTS PAYABLE
// ============================================================

model Supplier {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  taxId            String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  paymentTermsDays Int            @default(30)
  status           SupplierStatus @default(ACTIVE)
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  creator  User              @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  orders   PurchaseOrder[]
  invoices SupplierInvoice[]

  @@index([status, name])
  @@map("suppliers")
}

model PurchaseRequest {
  id              String                @id @default(cuid())
  requestNumber   String                @unique
  postingKey      String                @unique
  payloadHash     String
  branchId        String
  requestDate     DateTime
  requiredDate    DateTime?
  description     String
  status          PurchaseRequestStatus @default(DRAFT)
  approvalNote    String?
  rejectionReason String?
  createdBy       String
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  convertedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  branch   Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator  User                  @relation("PurchaseRequestCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer User?                 @relation("PurchaseRequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  items    PurchaseRequestItem[]
  order    PurchaseOrder?

  @@index([branchId, requestDate])
  @@index([status, createdAt])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                String   @id @default(cuid())
  purchaseRequestId String
  lineNo            Int
  masterProductId   String
  description       String
  requestedQty      Decimal  @db.Decimal(18, 4)
  approvedQty       Decimal? @db.Decimal(18, 4)
  estimatedUnitCost Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  masterProduct   MasterProduct   @relation(fields: [masterProductId], references: [id], onDelete: Restrict)

  @@unique([purchaseRequestId, lineNo])
  @@index([masterProductId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  poNumber          String              @unique
  postingKey        String              @unique
  payloadHash       String
  purchaseRequestId String              @unique
  supplierId        String
  branchId          String
  orderDate         DateTime
  expectedDate      DateTime?
  status            PurchaseOrderStatus @default(ISSUED)
  currency          String              @default("IDR")
  totalAmount       Decimal             @db.Decimal(18, 2)
  notes             String?
  createdBy         String
  issuedAt          DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  purchaseRequest PurchaseRequest     @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator         User                @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  goodsReceipts   GoodsReceipt[]
  invoices        SupplierInvoice[]

  @@index([branchId, orderDate])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                         String   @id @default(cuid())
  purchaseOrderId            String
  lineNo                     Int
  masterProductId            String
  uomId                      String?
  destinationStockLocationId String?
  skuSnapshot                String?
  nameSnapshot               String
  uomSnapshot                String
  orderedQty                 Decimal  @db.Decimal(18, 4)
  receivedQty                Decimal  @default(0) @db.Decimal(18, 4)
  unitPrice                  Decimal  @db.Decimal(18, 4)
  lineTotal                  Decimal  @db.Decimal(18, 2)
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  purchaseOrder            PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  masterProduct            MasterProduct      @relation(fields: [masterProductId], references: [id], onDelete: Restrict)
  uom                      UnitOfMeasure?     @relation(fields: [uomId], references: [id], onDelete: Restrict)
  destinationStockLocation StockLocation?     @relation(fields: [destinationStockLocationId], references: [id], onDelete: Restrict)
  receiptLines             GoodsReceiptLine[]
  receiptItems             GoodsReceiptItem[]

  @@unique([purchaseOrderId, lineNo])
  @@index([masterProductId])
  @@index([destinationStockLocationId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id                     String             @id @default(cuid())
  receiptNumber          String             @unique
  idempotencyKey         String             @unique
  payloadHash            String
  purchaseOrderId        String
  branchId               String
  status                 GoodsReceiptStatus @default(POSTED)
  receiptDate            DateTime
  totalQuantity          Decimal            @default(0) @db.Decimal(18, 4)
  quarantinedQuantity    Decimal            @default(0) @db.Decimal(18, 4)
  totalValue             Decimal            @db.Decimal(18, 2)
  journalEntryId         String             @unique
  inventoryPostingId     String?            @unique
  evidenceReference      String?
  supplierDeliveryNumber String?
  notes                  String?
  createdBy              String
  createdAt              DateTime           @default(now())

  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  journalEntry     JournalEntry       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  inventoryPosting InventoryPosting?  @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)
  creator          User               @relation("GoodsReceiptCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lines            GoodsReceiptLine[]
  items            GoodsReceiptItem[]

  @@index([purchaseOrderId, receiptDate])
  @@index([branchId, receiptDate])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String    @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  lineNo              Int
  inventoryItemId     String
  stockLocationId     String
  quantity            Decimal   @db.Decimal(18, 4)
  unitCost            Decimal   @db.Decimal(18, 4)
  lineValue           Decimal   @db.Decimal(18, 2)
  batchNumber         String?
  manufactureDate     DateTime?
  expiryDate          DateTime?
  inventoryPostingId  String    @unique
  createdAt           DateTime  @default(now())

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  stockLocation     StockLocation     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  inventoryPosting  InventoryPosting  @relation(fields: [inventoryPostingId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, lineNo])
  @@index([purchaseOrderItemId])
  @@map("goods_receipt_lines")
}

model GoodsReceiptItem {
  id                  String                @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  inventoryItemId     String
  inventoryBalanceId  String
  stockLocationId     String
  batchId             String?
  batchKey            String                @default("NO_BATCH")
  stockMutationId     String                @unique
  costLayerId         String                @unique
  condition           GoodsReceiptCondition @default(GOOD)
  quantity            Decimal               @db.Decimal(18, 4)
  quarantineQty       Decimal               @default(0) @db.Decimal(18, 4)
  unitCost            Decimal               @db.Decimal(18, 4)
  totalCost           Decimal               @db.Decimal(18, 4)
  notes               String?
  createdAt           DateTime              @default(now())

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  purchaseOrderItem PurchaseOrderItem  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryBalance  InventoryBalance   @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  stockLocation     StockLocation      @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  batch             InventoryBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  stockMutation     StockMutation      @relation(fields: [stockMutationId], references: [id], onDelete: Restrict)
  costLayer         InventoryCostLayer @relation(fields: [costLayerId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptId, purchaseOrderItemId, stockLocationId, batchKey, condition], map: "goods_receipt_items_receipt_line_key")
  @@index([purchaseOrderItemId])
  @@index([inventoryBalanceId])
  @@index([batchId])
  @@map("goods_receipt_items")
}

model SupplierInvoice {
  id                    String                @id @default(cuid())
  invoiceNumber         String                @unique
  supplierInvoiceNumber String
  postingKey            String                @unique
  payloadHash           String
  purchaseOrderId       String
  supplierId            String
  branchId              String
  invoiceDate           DateTime
  dueDate               DateTime
  amount                Decimal               @db.Decimal(18, 2)
  paidAmount            Decimal               @default(0) @db.Decimal(18, 2)
  balanceAmount         Decimal               @db.Decimal(18, 2)
  status                SupplierInvoiceStatus @default(POSTED)
  grniAccountId         String
  apAccountId           String
  journalEntryId        String                @unique
  evidenceReference     String?
  createdBy             String
  postedAt              DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  grniAccount   Account           @relation("SupplierInvoiceGrniAccount", fields: [grniAccountId], references: [id], onDelete: Restrict)
  apAccount     Account           @relation("SupplierInvoiceApAccount", fields: [apAccountId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry      @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  creator       User              @relation("SupplierInvoiceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  payments      SupplierPayment[]

  @@unique([supplierId, supplierInvoiceNumber])
  @@index([branchId, dueDate, status])
  @@index([purchaseOrderId, invoiceDate])
  @@map("supplier_invoices")
}

model SupplierPayment {
  id                    String   @id @default(cuid())
  paymentNumber         String   @unique
  postingKey            String   @unique
  payloadHash           String
  supplierInvoiceId     String
  cashBankAccountId     String
  branchId              String
  paymentDate           DateTime
  amount                Decimal  @db.Decimal(18, 2)
  paymentReference      String
  journalEntryId        String   @unique
  cashBankTransactionId String   @unique
  createdBy             String
  postedAt              DateTime @default(now())
  createdAt             DateTime @default(now())

  supplierInvoice     SupplierInvoice     @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  cashBankAccount     CashBankAccount     @relation(fields: [cashBankAccountId], references: [id], onDelete: Restrict)
  branch              Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  journalEntry        JournalEntry        @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  cashBankTransaction CashBankTransaction @relation(fields: [cashBankTransactionId], references: [id], onDelete: Restrict)
  creator             User                @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([supplierInvoiceId, paymentDate])
  @@index([branchId, paymentDate])
  @@map("supplier_payments")
}

enum AddOnType {
  AIR_NANO
  KONSULTASI_GIZI
  KONSULTASI_PSIKOLOG
  ROKOK_KENKOU
  LAINNYA
}

enum ProductType {
  AIR_NANO
  ROKOK_KENKOU
}

enum AirNanoColor {
  KUNING
  BIRU
  HIJAU
}

enum AirNanoVolume {
  ML_600
  ML_1500
}

enum AirNanoUnit {
  BOTOL
  DUS
}

enum InvoiceStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  DEBT
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  CREDIT
  QRIS
  OTHER
}

// ============================================================
// THERAPY DOMAIN
// ============================================================

model Encounter {
  id              String          @id @default(cuid())
  encounterCode   String          @unique
  memberId        String
  branchId        String
  memberPackageId String
  adminLayananId  String
  doctorId        String
  nurseId         String
  status          EncounterStatus @default(ONGOING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  member        Member             @relation(fields: [memberId], references: [id])
  branch        Branch             @relation(fields: [branchId], references: [id])
  memberPackage MemberPackage      @relation("EncounterBasicPackage", fields: [memberPackageId], references: [id])
  diagnoses     Diagnosis[]
  sessions      TreatmentSession[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([memberPackageId])
  @@index([doctorId])
  @@map("encounters")
}

model TreatmentSession {
  id                         String                    @id @default(cuid())
  sessionCode                String                    @unique
  encounterId                String
  branchId                   String
  infusKe                    Int
  branchInfusKe              Int
  pelaksanaan                SessionType
  treatmentDate              DateTime
  isCompleted                Boolean                   @default(false)
  completionStatus           TreatmentCompletionStatus @default(IN_PROGRESS)
  adminLayananId             String
  doctorId                   String // Primary doctor (backward compatibility)
  nurseId                    String // Primary nurse (backward compatibility)
  boosterPackageId           String?
  boosterType                String?
  completedAt                DateTime?
  completedBy                String?
  materialPostingId          String?                   @unique
  completionJournalEntryId   String?                   @unique
  recognizedRevenue          Decimal                   @default(0) @db.Decimal(18, 2)
  materialCost               Decimal                   @default(0) @db.Decimal(18, 2)
  grossProfit                Decimal                   @default(0) @db.Decimal(18, 2)
  cancelledAt                DateTime?
  cancelledBy                String?
  cancellationIdempotencyKey String?                   @unique
  cancellationReason         String?                   @db.Text
  materialReversalPostingId  String?                   @unique
  cancellationJournalEntryId String?                   @unique
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  encounter               Encounter         @relation(fields: [encounterId], references: [id])
  branch                  Branch            @relation(fields: [branchId], references: [id])
  adminLayanan            User              @relation("SessionAdmin", fields: [adminLayananId], references: [id])
  doctor                  User              @relation("SessionDoctor", fields: [doctorId], references: [id])
  nurse                   User              @relation("SessionNurse", fields: [nurseId], references: [id])
  boosterPackage          MemberPackage?    @relation("SessionBoosterPackage", fields: [boosterPackageId], references: [id])
  materialPosting         InventoryPosting? @relation("TreatmentMaterialPosting", fields: [materialPostingId], references: [id], onDelete: Restrict)
  materialReversalPosting InventoryPosting? @relation("TreatmentMaterialReversalPosting", fields: [materialReversalPostingId], references: [id], onDelete: Restrict)
  completionJournal       JournalEntry?     @relation("TreatmentCompletionJournal", fields: [completionJournalEntryId], references: [id], onDelete: Restrict)
  cancellationJournal     JournalEntry?     @relation("TreatmentCancellationJournal", fields: [cancellationJournalEntryId], references: [id], onDelete: Restrict)

  therapyPlan      TherapyPlan?
  vitalSigns       VitalSign[]
  infusion         InfusionExecution?
  materials        MaterialUsage[]
  photo            SessionPhoto?
  supportingPhotos SessionSupportingPhoto[]
  emrNotes         EMRNote[]
  evaluation       DoctorEvaluation?

  // Multiple doctors and nurses support
  sessionDoctors           SessionDoctor[]
  sessionNurses            SessionNurse[]
  completedEvent           DomainEvent?
  revenueRecognitions      RevenueRecognition[]
  deferredRevenueMovements DeferredRevenueMovement[]

  @@index([encounterId])
  @@index([branchId, treatmentDate])
  @@index([branchId, branchInfusKe])
  @@index([doctorId, treatmentDate])
  @@index([isCompleted])
  @@index([completionStatus, completedAt])
  @@map("treatment_sessions")
}

// Junction table for multiple doctors per session
