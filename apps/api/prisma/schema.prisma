  branchId             String
  warehouseId          String?
  stockLocationId      String?
  status               StockOpnameStatus     @default(DRAFT)
  reasonCode           StockAdjustmentReason
  notes                String
  countedAt            DateTime
  snapshotAt           DateTime              @default(now())
  lockToken            String?               @unique
  createdBy            String
  startedBy            String?
  submittedAt          DateTime?
  reviewedBy           String?
  reviewedAt           DateTime?
  approvedBy           String?
  approvedAt           DateTime?
  rejectionReason      String?
  approvalInstanceId   String?               @unique
  adjustmentId         String?               @unique
  totalAdjustmentValue Decimal               @default(0) @db.Decimal(18, 2)
  journalEntryId       String?               @unique
  postedBy             String?
  postedAt             DateTime?
  cancelledBy          String?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
