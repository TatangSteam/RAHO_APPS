// ============================================================
// RAHO — Prisma Schema
// PostgreSQL 15 | CUID primary keys | Soft-delete via isActive
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  ADMIN_MANAGER
  ADMIN_CABANG
  ADMIN_LAYANAN
  ADMIN_LOGISTIK
  DOCTOR
  NURSE
  MEMBER
}

enum AdminManagerAccessScope {
  FULL
  MEMBER_VIEW_ONLY
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum BranchType {
  PUSAT
  PREMIER
  PARTNERSHIP
}

enum Gender {
  L
  P
}

enum DocumentType {
  PERSETUJUAN_SETELAH_PENJELASAN
  FOTO_PROFIL
}

enum ReferrerType {
  SALES
  DOKTER
  MEMBER
}

enum IncentiveType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PackageType {
  BASIC
  BOOSTER
}

enum PackageStatus {
  PENDING_PAYMENT
  WAITING_VERIFICATION
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentPlanType {
  FULL_PAYMENT
  INSTALLMENT
}

enum BoosterType {
  NO // Nitric Oxide
  GT // Gasotransmitter
  MB // Methylene Blue
  KCL // Potassium Chloride
  H2S // Hydrogen Sulfide
  HK // H2O Konsentrat
  O3 // Ozone
  HHO // Hydrogen (legacy - keep for backward compatibility)
  NO2 // Nitric Oxide 2 (legacy - keep for backward compatibility)
}

enum SessionType {
  ON_SITE
  HOME_CARE
}

enum EncounterStatus {
  ONGOING
  CLOSED
}

enum VitalType {
  SISTOL
  DIASTOL
  HR
  SATURASI
  PI
}

enum VitalTiming {
  SEBELUM
  SESUDAH
}

enum BottleType {
  IFA
  EDTA
}

enum EMRNoteType {
  CLINICAL_NOTE
  OPERATIONAL_NOTE
  ASSESSMENT
  OUTCOME_MONITORING
}

enum DiagnosisCategory {
  HIPERTENSI
  NEUROLOGI
  DIABETES
  KARDIOVASKULAR
  ORTOPEDI
  IMUNOLOGI
  HEMATOLOGI
  STROKE
  JANTUNG_KARDIOVASKULAR
  SINDROM_METABOLIK
  KANKER
  DEGENERATIF
  AUTO_IMUN
  ONKOLOGI
  LAINNYA
}

enum ProductCategory {
  MEDICINE
  DEVICE
  CONSUMABLE
}

enum StockMutationType {
  USED
  RECEIVED
  ADJUSTMENT
}

enum StockRequestStatus {
  PENDING // Baru dibuat, menunggu review
  APPROVED // Disetujui (untuk Premier)
  WAITING_PAYMENT // Menunggu pembayaran (untuk Partnership)
  PAYMENT_UPLOADED // Bukti bayar sudah diupload
  PAYMENT_CONFIRMED // Pembayaran dikonfirmasi
  REJECTED // Ditolak
  SHIPPED // Sedang dikirim
  COMPLETED // Selesai - barang diterima sesuai
  COMPLETED_WITH_ISSUE // Selesai - ada ketidaksesuaian
}

enum PaymentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DiscrepancyType {
  SHORTAGE // Kurang
  DAMAGE // Rusak
  WRONG_ITEM // Salah item
  OTHER // Lainnya
}

enum StockAdjustmentReason {
  EXPIRED // Kadaluarsa
  DAMAGED // Rusak/Pecah
  LOST // Hilang
  STOCK_OPNAME // Koreksi stock opname
  OTHER // Lainnya
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  RECEIVED
  RECEIVED_WITH_ISSUE // Diterima dengan ketidaksesuaian
  APPROVED
}

enum NotificationType {
  INVOICE
  REMINDER
  INFO
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_CHANGE
  PASSWORD_RESET
  LOGIN_SUCCESS
  LOGIN_FAILED
  VERIFY_PAYMENT
  REJECT_PAYMENT
  UPLOAD_FILE
  STATUS_CHANGE
  ASSIGN
  CANCEL
  COMPLETE
  STOCK_REQUEST
  SHIPMENT
  RECEIVE_SHIPMENT
  STOCK_ADJUSTMENT
}

enum OverstockStatus {
  AVAILABLE // Masih tersedia untuk digunakan
  PARTIALLY_USED // Sebagian sudah terpakai
  FULLY_USED // Sudah habis terpakai
}

enum HomecareBagStatus {
  ACTIVE
  INACTIVE
  IN_CHECKING
  DAMAGED
  LOST
}

enum HomecareTeamMemberRole {
  ADMIN_LAYANAN
  DOCTOR
  NURSE
  DRIVER
  OTHER
}

enum HomecareBagRequestStatus {
  DRAFT
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PREPARING
  SHIPPED
  RECEIVED
  RECEIVED_WITH_ISSUE
  COMPLETED
  CANCELLED
}

enum HomecareBagUsageStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum HomecareBagOpnameStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LogisticLocationType {
  CENTRAL_STOCK
  BRANCH_STOCK
  HOMECARE_BAG
}

enum LogisticTransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  ADJUSTMENT
  REQUEST_APPROVAL
  SHIPMENT
  RECEIVE_SHIPMENT
  BAG_USAGE
  BAG_RETURN
  STOCK_OPNAME
}

enum LogisticTransactionStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

// ============================================================
// CORE DOMAIN
// ============================================================

model Branch {
  id             String     @id @default(cuid())
  branchCode     String     @unique
  name           String
  address        String?
  city           String?
  phone          String?
  type           BranchType @default(PREMIER)
  operatingHours String?
  isActive       Boolean    @default(true)
  createdBy      String? // User ID who created this branch
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  users               User[]
  members             Member[]
  branchMemberAccess  BranchMemberAccess[]
  memberPackages      MemberPackage[]
  memberAddOns        MemberAddOn[]
  nonTherapyPurchases MemberNonTherapyPurchase[]
  invoices            Invoice[]
  packagePricings     PackagePricing[]
  inventoryItems      InventoryItem[]
  stockRequests       StockRequest[]
  shipmentsFrom       Shipment[]                 @relation("ShipmentFrom")
  shipmentsTo         Shipment[]                 @relation("ShipmentTo")
  encounters          Encounter[]
  treatmentSessions   TreatmentSession[]
  managerBranches     ManagerBranch[]
  staffBranches       StaffBranch[]              @relation("StaffBranches")
  referralCodes       ReferralCode[]
  auditLogs           AuditLog[]
  permissionOverrides UserPermissionOverride[]
  accountingPeriods   AccountingPeriod[]
  journalEntries      JournalEntry[]
  journalLines        JournalLine[]
  overstocks          BranchOverstock[]

  @@index([branchCode])
  @@index([isActive])
  @@index([createdBy])
  @@map("branches")
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  password                String
  role                    Role
  adminManagerAccessScope AdminManagerAccessScope @default(FULL)
  staffCode               String?                 @unique
  branchId                String?
  roleTemplateId          String?
  isActive                Boolean                 @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  // Relations
  branch                     Branch?                  @relation(fields: [branchId], references: [id])
  roleTemplate               RoleTemplate?            @relation(fields: [roleTemplateId], references: [id], onDelete: SetNull)
  profile                    UserProfile?
  member                     Member?
  auditLogs                  AuditLog[]
  notifications              Notification[]
  chatMessages               ChatMessage[]
  chatRooms                  ChatRoom[]               @relation("ChatRoomStaff")
  managedBranches            ManagerBranch[]
  staffBranches              StaffBranch[]            @relation("StaffBranches")
  permissionOverrides        UserPermissionOverride[] @relation("PermissionOverrideUser")
  permissionOverridesCreated UserPermissionOverride[] @relation("PermissionOverrideCreatedBy")
  journalEntriesCreated      JournalEntry[]           @relation("JournalEntryCreatedBy")
  journalEntriesPosted       JournalEntry[]           @relation("JournalEntryPostedBy")
  accountingPeriodsCreated   AccountingPeriod[]       @relation("AccountingPeriodCreatedBy")
  accountingPeriodsClosed    AccountingPeriod[]       @relation("AccountingPeriodClosedBy")

  sessionsAsAdmin  TreatmentSession[] @relation("SessionAdmin")
  sessionsAsDoctor TreatmentSession[] @relation("SessionDoctor")
  sessionsAsNurse  TreatmentSession[] @relation("SessionNurse")

  // Multiple doctors/nurses per session
  sessionDoctorAssignments SessionDoctor[] @relation("SessionDoctorStaff")
  sessionNurseAssignments  SessionNurse[]  @relation("SessionNurseStaff")

  packagesAssigned   MemberPackage[]            @relation("PackageAssignedBy")
  packagesVerified   MemberPackage[]            @relation("PackageVerifiedBy")
  packagesRejected   MemberPackage[]            @relation("PackageRejectedBy")
  packagesRefunded   MemberPackage[]            @relation("PackageRefundedBy")
  addOnsAssigned     MemberAddOn[]              @relation("AddOnAssignedBy")
  addOnsVerified     MemberAddOn[]              @relation("AddOnVerifiedBy")
  addOnsRejected     MemberAddOn[]              @relation("AddOnRejectedBy")
  nonTherapyAssigned MemberNonTherapyPurchase[] @relation("NonTherapyAssignedBy")
  nonTherapyVerified MemberNonTherapyPurchase[] @relation("NonTherapyVerifiedBy")
  invoicesCreated    Invoice[]                  @relation("InvoiceCreatedBy")
  invoicesVerified   Invoice[]                  @relation("InvoiceVerifiedBy")
  paymentsReceived   InvoicePayment[]           @relation("PaymentReceivedBy")
  uploadedLabResults LabResult[]

  @@index([email])
  @@index([role])
  @@index([branchId, role, isActive])
  @@index([roleTemplateId])
  @@index([staffCode])
  @@map("users")
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@map("user_profiles")
}

model ManagerBranch {
  id          String                  @id @default(cuid())
  userId      String
  branchId    String
  accessScope AdminManagerAccessScope @default(FULL)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([accessScope])
  @@map("manager_branches")
}

model StaffBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation("StaffBranches", fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation("StaffBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("staff_branches")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  isSensitive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roleTemplates RoleTemplatePermission[]
  userOverrides UserPermissionOverride[]

  @@index([module, isActive])
  @@map("permissions")
}

model RoleTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  baseRole    Role?    @unique
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RoleTemplatePermission[]
  users       User[]

  @@index([isActive])
  @@map("role_templates")
}

model RoleTemplatePermission {
  id             String   @id @default(cuid())
  roleTemplateId String
  permissionId   String
  createdAt      DateTime @default(now())

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, permissionId])
  @@index([permissionId])
  @@map("role_template_permissions")
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect
  branchId     String?
  scopeKey     String           @default("GLOBAL")
  reason       String?
  validUntil   DateTime?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation("PermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator    User       @relation("PermissionOverrideCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([userId, permissionId, scopeKey])
  @@index([userId, effect])
  @@index([branchId])
  @@index([validUntil])
  @@map("user_permission_overrides")
}

// ============================================================
// ACCOUNTING FOUNDATION
// ============================================================

model Account {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  type          AccountType
  normalBalance NormalBalance
  parentId      String?
  level         Int           @default(1)
  allowPosting  Boolean       @default(true)
  isControl     Boolean       @default(false)
  isActive      Boolean       @default(true)
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent   Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[]     @relation("AccountHierarchy")
  lines    JournalLine[]

  @@index([type, isActive])
  @@index([parentId])
  @@map("accounts")
}

model AccountingPeriod {
  id         String                 @id @default(cuid())
  name       String
  fiscalYear Int
  periodNo   Int
  startDate  DateTime
  endDate    DateTime
  branchId   String?
  scopeKey   String                 @default("GLOBAL")
  status     AccountingPeriodStatus @default(OPEN)
  closedAt   DateTime?
  closedBy   String?
  createdBy  String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  creator        User           @relation("AccountingPeriodCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  closer         User?          @relation("AccountingPeriodClosedBy", fields: [closedBy], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([fiscalYear, periodNo, scopeKey])
  @@index([scopeKey, status, startDate, endDate])
  @@index([branchId, status])
  @@map("accounting_periods")
}

model JournalEntry {
  id                 String        @id @default(cuid())
  journalNumber      String        @unique
  postingKey         String        @unique
  payloadHash        String
  transactionDate    DateTime
  description        String
  branchId           String
  accountingPeriodId String
  status             JournalStatus @default(POSTED)
  totalDebit         Decimal       @db.Decimal(18, 2)
  totalCredit        Decimal       @db.Decimal(18, 2)
  metadata           Json?
  postedAt           DateTime      @default(now())
  createdBy          String
  postedBy           String
  reversedAt         DateTime?
  reversedByEntryId  String?       @unique
  createdAt          DateTime      @default(now())

  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod    @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  creator          User                @relation("JournalEntryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  poster           User                @relation("JournalEntryPostedBy", fields: [postedBy], references: [id], onDelete: Restrict)
  reversedByEntry  JournalEntry?       @relation("JournalReversal", fields: [reversedByEntryId], references: [id], onDelete: Restrict)
  reversesEntry    JournalEntry?       @relation("JournalReversal")
  lines            JournalLine[]
  sourceLinks      JournalSourceLink[]

  @@index([branchId, transactionDate])
  @@index([accountingPeriodId, status])
  @@index([status, postedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  lineNo         Int
  accountId      String
  branchId       String
  costCenterCode String?
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  metadata       Json?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNo])
  @@index([accountId, createdAt])
  @@index([branchId, createdAt])
  @@index([costCenterCode, createdAt])
  @@map("journal_lines")
}

model JournalSourceLink {
  id             String   @id @default(cuid())
  journalEntryId String
  sourceType     String
  sourceId       String
  sourceNumber   String?
  relationType   String   @default("PRIMARY")
  metadata       Json?
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, sourceType, sourceId, relationType])
  @@index([sourceType, sourceId])
  @@index([sourceNumber])
  @@map("journal_source_links")
}

model JournalSequence {
  id         String   @id @default(cuid())
  scopeKey   String
  fiscalYear Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([scopeKey, fiscalYear])
  @@map("journal_sequences")
}

// ============================================================
// MEMBER DOMAIN
// ============================================================

model Member {
  id                   String  @id @default(cuid())
  userId               String  @unique
  memberNo             String  @unique
  registrationBranchId String
  referralCodeId       String?

  // Incentive Settings (per member)
  firstIncentiveType  IncentiveType?
  firstIncentiveValue Decimal?       @db.Decimal(10, 2)
  nextIncentiveType   IncentiveType?
  nextIncentiveValue  Decimal?       @db.Decimal(10, 2)

  voucherCount     Int       @default(0)
  isConsentToPhoto Boolean   @default(true)
  nik              String?   @unique
  tempatLahir      String?
  dateOfBirth      DateTime?
  jenisKelamin     Gender?
  agama            String? // Religion field
  address          String?
  pekerjaan        String?
  statusNikah      String?
  emergencyContact String?
  sumberInfoRaho   String?
  postalCode       String?
  isDeceased       Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user                User                       @relation(fields: [userId], references: [id])
  registrationBranch  Branch                     @relation(fields: [registrationBranchId], references: [id])
  referralCode        ReferralCode?              @relation(fields: [referralCodeId], references: [id])
  documents           MemberDocument[]
  branchAccesses      BranchMemberAccess[]
  memberPackages      MemberPackage[]
  memberAddOns        MemberAddOn[]
  nonTherapyPurchases MemberNonTherapyPurchase[]
  invoices            Invoice[]
  encounters          Encounter[]
  diagnoses           Diagnosis[] // Direct diagnoses without encounter
  therapyPlans        TherapyPlan[] // Therapy plans for preparation
  therapyPlanSets     TherapyPlanSet[]
  chatRoom            ChatRoom?
  incentiveRecords    ReferralIncentiveRecord[]
  labResults          LabResult[]

  @@index([memberNo])
  @@index([registrationBranchId, isActive])
  @@index([referralCodeId])
  @@index([nik])
  @@index([dateOfBirth])
  @@index([voucherCount])
  @@map("members")
}

model MemberDocument {
  id           String       @id @default(cuid())
  memberId     String
  documentType DocumentType
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  uploadedBy   String
  createdAt    DateTime     @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, documentType])
  @@map("member_documents")
}

model BranchMemberAccess {
  id        String   @id @default(cuid())
  memberId  String
  branchId  String
  grantedBy String
  notes     String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([memberId, branchId])
  @@index([branchId])
  @@index([memberId])
  @@map("branch_member_access")
}

model ReferralCode {
  id           String       @id @default(cuid())
  code         String       @unique
  referrerName String
  referrerType ReferrerType
  branchId     String
  phone        String?
  email        String?

  // Statistics
  totalReferrals       Int     @default(0)
  totalIncentiveEarned Decimal @default(0) @db.Decimal(15, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch           Branch                    @relation(fields: [branchId], references: [id])
  members          Member[]
  incentiveRecords ReferralIncentiveRecord[]

  @@index([code])
  @@index([branchId])
  @@index([isActive])
  @@index([referrerType])
  @@map("referral_codes")
}

model ReferralIncentiveRecord {
  id              String @id @default(cuid())
  referralCodeId  String
  memberId        String
  memberPackageId String

  // Package Info (snapshot)
  packageType  String
  packageName  String
  packageValue Decimal @db.Decimal(15, 2)

  // Incentive Calculation
  isFirstPackage  Boolean
  incentiveType   IncentiveType
  incentiveValue  Decimal       @db.Decimal(10, 2)
  incentiveAmount Decimal       @db.Decimal(15, 2)

  // Metadata
  notes     String?
  createdAt DateTime @default(now())

  referralCode  ReferralCode  @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  member        Member        @relation(fields: [memberId], references: [id])
  memberPackage MemberPackage @relation(fields: [memberPackageId], references: [id])

  @@index([referralCodeId])
  @@index([memberId])
  @@index([memberPackageId])
  @@index([createdAt])
  @@map("referral_incentive_records")
}

// ============================================================
// PACKAGE DOMAIN
// ============================================================

model MasterBoosterType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  icon        String?
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_booster_types")
}

model MasterServiceType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("master_service_types")
}

model PackagePricing {
  id            String      @id @default(cuid())
  branchId      String? // NULL = global pricing, specific ID = branch-specific pricing
  packageType   PackageType
  boosterType   String? // Custom booster type code (NO, GT, MB, KCL, H2S, HK, O3, or custom from MasterBoosterType)
  serviceType   String? // HC, PS, PHC, PTY, PDA for service type pricing
  productCode   String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  name          String
  totalSessions Int
  price         Decimal     @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  branch         Branch?         @relation(fields: [branchId], references: [id])
  memberPackages MemberPackage[]

  @@unique([branchId, packageType, boosterType, serviceType, totalSessions, productCode], map: "package_pricing_identity_unique")
  @@index([branchId, isActive])
  @@index([packageType])
  @@map("package_pricings")
}

model MemberPackage {
  id                  String          @id @default(cuid())
  packageCode         String          @unique
  memberId            String
  branchId            String
  packagePricingId    String?
  packageType         PackageType
  productCode         String? // e.g., TNB-P7-HC, BST-NO-P1-HC
  totalSessions       Int
  usedSessions        Int             @default(0)
  finalPrice          Decimal         @db.Decimal(12, 2)
  discountPercent     Decimal?        @db.Decimal(5, 2)
  discountAmount      Decimal?        @db.Decimal(12, 2)
  discountNote        String?
  notes               String?
  status              PackageStatus   @default(PENDING_PAYMENT)
  paymentPlanType     PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal    Int?
  installmentSchedule Json?
  totalVerifiedPaid   Decimal         @default(0) @db.Decimal(12, 2)
  paymentPlanStatus   String?
  boosterType         String?
  serviceType         String? // HC, PS, PHC, PTY, PDA
  purchaseGroupId     String? // Group BASIC + BOOSTER purchased together
  upgradedFromId      String? // Track if this is an upgrade from another package

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  // Refund information (informasi pengembalian dana)
  refundAmount        Decimal?  @db.Decimal(12, 2)
  refundReason        String?
  refundProofUrl      String?
  refundProofFileName String?
  refundProofFileSize Int?
  refundProofMimeType String?
  refundedBy          String?
  refundedAt          DateTime?

  assignedBy      String
  verifiedBy      String?
  rejectedBy      String?
  paidAt          DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  activatedAt     DateTime?
  expiredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member           Member                    @relation(fields: [memberId], references: [id])
  branch           Branch                    @relation(fields: [branchId], references: [id])
  packagePricing   PackagePricing?           @relation(fields: [packagePricingId], references: [id])
  assignedByUser   User                      @relation("PackageAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser   User?                     @relation("PackageVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser   User?                     @relation("PackageRejectedBy", fields: [rejectedBy], references: [id])
  refundedByUser   User?                     @relation("PackageRefundedBy", fields: [refundedBy], references: [id])
  upgradedFrom     MemberPackage?            @relation("PackageUpgrade", fields: [upgradedFromId], references: [id], onDelete: SetNull)
  upgrades         MemberPackage[]           @relation("PackageUpgrade")
  encounters       Encounter[]               @relation("EncounterBasicPackage")
  boosterSessions  TreatmentSession[]        @relation("SessionBoosterPackage")
  addOns           MemberAddOn[]
  incentiveRecords ReferralIncentiveRecord[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([packageCode])
  @@index([memberId, packageType, status])
  @@index([purchaseGroupId])
  @@index([paymentProofUrl])
  @@index([refundedAt])
  @@index([refundProofUrl])
  @@map("member_packages")
}

model MemberAddOn {
  id                  String          @id @default(cuid())
  addOnCode           String          @unique
  memberId            String
  branchId            String
  packageId           String? // Optional: link to package if purchased together
  addOnType           AddOnType
  quantity            Int             @default(1)
  pricePerUnit        Decimal         @db.Decimal(12, 2)
  totalPrice          Decimal         @db.Decimal(12, 2)
  status              PackageStatus   @default(PENDING_PAYMENT)
  paymentPlanType     PaymentPlanType @default(FULL_PAYMENT)
  installmentTotal    Int?
  installmentSchedule Json?
  totalVerifiedPaid   Decimal         @default(0) @db.Decimal(12, 2)
  paymentPlanStatus   String?
  notes               String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy      String
  verifiedBy      String?
  rejectedBy      String?
  paidAt          DateTime?
  verifiedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  member         Member         @relation(fields: [memberId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  package        MemberPackage? @relation(fields: [packageId], references: [id])
  assignedByUser User           @relation("AddOnAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?          @relation("AddOnVerifiedBy", fields: [verifiedBy], references: [id])
  rejectedByUser User?          @relation("AddOnRejectedBy", fields: [rejectedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([addOnCode])
  @@index([paymentProofUrl])
  @@map("member_add_ons")
}

// ============================================================
// NON-THERAPY PRODUCTS DOMAIN
// ============================================================

model NonTherapyProduct {
  id          String      @id @default(cuid())
  productCode String      @unique
  productType ProductType
  name        String
  description String?

  // Air Nano specific fields
  airNanoColor  AirNanoColor?
  airNanoVolume AirNanoVolume?
  airNanoUnit   AirNanoUnit?

  // Pricing
  pricePerUnit Decimal @db.Decimal(12, 2)

  // Status
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases MemberNonTherapyPurchase[]

  @@index([productType, isActive])
  @@index([productCode])
  @@map("non_therapy_products")
}

model MemberNonTherapyPurchase {
  id           String        @id @default(cuid())
  purchaseCode String        @unique
  memberId     String
  branchId     String
  productId    String
  quantity     Int           @default(1)
  pricePerUnit Decimal       @db.Decimal(12, 2)
  totalPrice   Decimal       @db.Decimal(12, 2)
  status       PackageStatus @default(PENDING_PAYMENT)
  notes        String?

  // Payment proof (bukti pembayaran)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?

  assignedBy String
  verifiedBy String?
  paidAt     DateTime?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member            @relation(fields: [memberId], references: [id])
  branch         Branch            @relation(fields: [branchId], references: [id])
  product        NonTherapyProduct @relation(fields: [productId], references: [id])
  assignedByUser User              @relation("NonTherapyAssignedBy", fields: [assignedBy], references: [id])
  verifiedByUser User?             @relation("NonTherapyVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([purchaseCode])
  @@index([paymentProofUrl])
  @@map("member_non_therapy_purchases")
}

// ============================================================
// INVOICE DOMAIN
// ============================================================

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique
  memberId      String
  branchId      String

  // Financial details
  subtotal        Decimal  @db.Decimal(12, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(12, 2)
  discountNote    String?
  taxPercent      Decimal? @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal? @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal  @db.Decimal(12, 2)

  // Status and dates
  status                    InvoiceStatus             @default(DRAFT)
  paymentPlanType           PaymentPlanType           @default(FULL_PAYMENT)
  paymentGroupId            String?
  installmentNumber         Int?
  installmentTotal          Int?
  installmentSchedule       Json?
  totalPurchaseAmount       Decimal?                  @db.Decimal(12, 2)
  installmentAmount         Decimal?                  @db.Decimal(12, 2)
  carryOverAmount           Decimal?                  @default(0) @db.Decimal(12, 2)
  creditAmount              Decimal?                  @default(0) @db.Decimal(12, 2)
  actualPaidAmount          Decimal?                  @db.Decimal(12, 2)
  paymentVerificationStatus PaymentVerificationStatus @default(PENDING)
  paymentRejectionReason    String?
  isAdjustment              Boolean                   @default(false)
  dueDate                   DateTime?
  paidAt                    DateTime?
  cancelledAt               DateTime?

  // Payment details
  paymentMethod    PaymentMethod?
  paymentReference String?
  paymentNotes     String?

  // Metadata
  notes      String?
  createdBy  String
  verifiedBy String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  member         Member           @relation(fields: [memberId], references: [id])
  branch         Branch           @relation(fields: [branchId], references: [id])
  createdByUser  User             @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  verifiedByUser User?            @relation("InvoiceVerifiedBy", fields: [verifiedBy], references: [id])
  items          InvoiceItem[]
  payments       InvoicePayment[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([invoiceNumber])
  @@index([status, dueDate])
  @@index([paymentGroupId, installmentNumber])
  @@index([paymentPlanType])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  itemType       String // 'PACKAGE', 'ADDON', 'NON_THERAPY'
  itemId         String // Reference to MemberPackage, MemberAddOn, or MemberNonTherapyPurchase
  code           String? // Product code (e.g., TNB-P7-HC, BST-NO-P1-HC)
  description    String
  quantity       Int      @default(1)
  pricePerUnit   Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  discountAmount Decimal? @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemType, itemId])
  @@map("invoice_items")
}

model InvoicePayment {
  id               String        @id @default(cuid())
  invoiceId        String
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentReference String?
  notes            String?

  // Payment proof (bukti pembayaran)
  proofFileUrl  String?
  proofFileName String?
  proofFileSize Int?
  proofMimeType String?

  receivedBy String
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedByUser User    @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
  @@index([proofFileUrl])
  @@map("invoice_payments")
}

enum AddOnType {
  AIR_NANO
  KONSULTASI_GIZI
  KONSULTASI_PSIKOLOG
  ROKOK_KENKOU
  LAINNYA
}

enum ProductType {
  AIR_NANO
  ROKOK_KENKOU
}

enum AirNanoColor {
  KUNING
  BIRU
  HIJAU
}

enum AirNanoVolume {
  ML_600
  ML_1500
}

enum AirNanoUnit {
  BOTOL
  DUS
}

enum InvoiceStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  DEBT
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT
  CREDIT
  QRIS
  OTHER
}

// ============================================================
// THERAPY DOMAIN
// ============================================================

model Encounter {
  id              String          @id @default(cuid())
  encounterCode   String          @unique
  memberId        String
  branchId        String
  memberPackageId String
  adminLayananId  String
  doctorId        String
  nurseId         String
  status          EncounterStatus @default(ONGOING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  member        Member             @relation(fields: [memberId], references: [id])
  branch        Branch             @relation(fields: [branchId], references: [id])
  memberPackage MemberPackage      @relation("EncounterBasicPackage", fields: [memberPackageId], references: [id])
  diagnoses     Diagnosis[]
  sessions      TreatmentSession[]

  @@index([memberId, status])
  @@index([branchId, status])
  @@index([memberPackageId])
  @@index([doctorId])
  @@map("encounters")
}

model TreatmentSession {
  id               String      @id @default(cuid())
  sessionCode      String      @unique
  encounterId      String
  branchId         String
  infusKe          Int
  branchInfusKe    Int
  pelaksanaan      SessionType
  treatmentDate    DateTime
  isCompleted      Boolean     @default(false)
  adminLayananId   String
  doctorId         String // Primary doctor (backward compatibility)
  nurseId          String // Primary nurse (backward compatibility)
  boosterPackageId String?
  boosterType      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  encounter      Encounter      @relation(fields: [encounterId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  adminLayanan   User           @relation("SessionAdmin", fields: [adminLayananId], references: [id])
  doctor         User           @relation("SessionDoctor", fields: [doctorId], references: [id])
  nurse          User           @relation("SessionNurse", fields: [nurseId], references: [id])
  boosterPackage MemberPackage? @relation("SessionBoosterPackage", fields: [boosterPackageId], references: [id])

  therapyPlan      TherapyPlan?
  vitalSigns       VitalSign[]
  infusion         InfusionExecution?
  materials        MaterialUsage[]
  photo            SessionPhoto?
  supportingPhotos SessionSupportingPhoto[]
  emrNotes         EMRNote[]
  evaluation       DoctorEvaluation?

  // Multiple doctors and nurses support
  sessionDoctors SessionDoctor[]
  sessionNurses  SessionNurse[]

  @@index([encounterId])
  @@index([branchId, treatmentDate])
  @@index([branchId, branchInfusKe])
  @@index([doctorId, treatmentDate])
  @@index([isCompleted])
  @@map("treatment_sessions")
}

// Junction table for multiple doctors per session
model SessionDoctor {
  id        String   @id @default(cuid())
  sessionId String
  doctorId  String
  isPrimary Boolean  @default(false) // Mark primary doctor
  createdAt DateTime @default(now())

  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  doctor  User             @relation("SessionDoctorStaff", fields: [doctorId], references: [id])

  @@unique([sessionId, doctorId])
  @@index([sessionId])
  @@index([doctorId])
  @@map("session_doctors")
}

// Junction table for multiple nurses per session
model SessionNurse {
  id        String   @id @default(cuid())
  sessionId String
  nurseId   String
  isPrimary Boolean  @default(false) // Mark primary nurse
  createdAt DateTime @default(now())

  session TreatmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nurse   User             @relation("SessionNurseStaff", fields: [nurseId], references: [id])

  @@unique([sessionId, nurseId])
  @@index([sessionId])
  @@index([nurseId])
  @@map("session_nurses")
}

model Diagnosis {
  id                       String             @id @default(cuid())
  diagnosisCode            String             @unique
  memberId                 String // Direct link to member
  encounterId              String?            @unique // Optional - only if linked to encounter
  sourceDiagnosisId        String?            @map("source_diagnosis_id")
  doktorPemeriksa          String
  diagnosa                 String             @db.Text
  kategoriDiagnosa         DiagnosisCategory?
  kategoriDiagnosaList     Json?              @map("kategori_diagnosa_list")
  icdPrimer                String?
  icdSekunder              String?
  icdTersier               String?
  keluhanRiwayatSekarang   String?            @db.Text
  riwayatPenyakitTerdahulu String?            @db.Text
  riwayatSosialKebiasaan   String?            @db.Text
  riwayatPengobatan        String?            @db.Text
  pemeriksaanFisik         String?            @db.Text
  pemeriksaanTambahan      Json?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  member    Member     @relation(fields: [memberId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([memberId])
  @@index([sourceDiagnosisId])
  @@index([doktorPemeriksa])
  @@index([kategoriDiagnosa])
  @@map("diagnoses")
}

model TherapyPlanSet {
  id             String   @id @default(cuid())
  memberId       String
  setCode        String   @unique // Internal code, hidden from UI tables
  name           String?
  version        Int      @default(1)
  status         String   @default("ACTIVE") // ACTIVE, SUPERSEDED
  supersededById String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member       Member           @relation(fields: [memberId], references: [id])
  plans        TherapyPlan[]
  supersededBy TherapyPlanSet?  @relation("TherapyPlanSetVersioning", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes   TherapyPlanSet[] @relation("TherapyPlanSetVersioning")

  @@index([memberId, status])
  @@index([supersededById])
  @@map("therapy_plan_sets")
}

model TherapyPlan {
  id                  String    @id @default(cuid())
  planCode            String    @unique
  memberId            String? // NEW: For preparation (before session)
  therapyPlanSetId    String?
  planNumber          Int?
  treatmentSessionId  String?   @unique // Make optional
  keterangan          String?   @db.Text
  // IFA fields - IFA A + MG (pilih salah satu: 500ml atau 250ml)
  ifa250              Decimal?  @db.Decimal(10, 2) // IFA A + MG 250ml (satuan: Botol)
  ifa500              Decimal?  @db.Decimal(10, 2) // IFA A + MG 500ml (satuan: Botol)
  hho                 Decimal?  @db.Decimal(10, 2)
  hhoKonsentrat       Decimal?  @db.Decimal(10, 2)
  h2                  Decimal?  @db.Decimal(10, 2)
  no                  Decimal?  @db.Decimal(10, 2)
  gaso                Decimal?  @db.Decimal(10, 2)
  o2                  Decimal?  @db.Decimal(10, 2)
  o3                  Decimal?  @db.Decimal(10, 2)
  edta                Decimal?  @db.Decimal(10, 2)
  mb                  Decimal?  @db.Decimal(10, 2)
  h2s                 Decimal?  @db.Decimal(10, 2)
  kcl                 Decimal?  @db.Decimal(10, 2)
  jmlNb               Decimal?  @db.Decimal(10, 2)
  noInIfa             Decimal?  @default(2.5) @db.Decimal(10, 2) // Default NO di IFA 2,5ml
  ifaSubstances       Json?     @map("ifa_substances") // Zat yang terkandung di IFA, hanya pencatatan therapy plan
  ifaSubstanceTotalMl Decimal?  @map("ifa_substance_total_ml") @db.Decimal(10, 2)
  // Versioning fields
  version             Int       @default(1) // Version number (1, 2, 3, ...)
  supersededById      String? // ID of the therapy plan that supersedes this one
  supersededAt        DateTime? // When was this version superseded
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  member         Member?             @relation(fields: [memberId], references: [id])
  therapyPlanSet TherapyPlanSet?     @relation(fields: [therapyPlanSetId], references: [id])
  session        TreatmentSession?   @relation(fields: [treatmentSessionId], references: [id])
  supersededBy   TherapyPlan?        @relation("TherapyPlanVersioning", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes     TherapyPlan[]       @relation("TherapyPlanVersioning")
  infusions      InfusionExecution[]

  @@unique([therapyPlanSetId, planNumber])
  @@index([memberId])
  @@index([therapyPlanSetId])
  @@index([supersededById])
  @@map("therapy_plans")
}

model VitalSign {
  id                 String      @id @default(cuid())
  treatmentSessionId String
  pencatatan         VitalType
  waktuCatat         VitalTiming
  value              Decimal     @db.Decimal(8, 2)
  unit               String?
  recordedBy         String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  session TreatmentSession @relation(fields: [treatmentSessionId], references: [id])

  @@unique([treatmentSessionId, pencatatan, waktuCatat])
  @@index([treatmentSessionId])
  @@map("vital_signs")
}

model InfusionExecution {
  id                 String      @id @default(cuid())
  treatmentSessionId String      @unique
  therapyPlanId      String?
  // IFA fields - IFA A + MG (pilih salah satu: 500ml atau 250ml)
  ifa250             Decimal?    @db.Decimal(10, 2) // IFA A + MG 250ml (satuan: Botol)
  ifa500             Decimal?    @db.Decimal(10, 2) // IFA A + MG 500ml (satuan: Botol)
  hho                Decimal?    @db.Decimal(10, 2)
  hhoKonsentrat      Decimal?    @db.Decimal(10, 2)
  h2                 Decimal?    @db.Decimal(10, 2)
  no                 Decimal?    @db.Decimal(10, 2)
  gaso               Decimal?    @db.Decimal(10, 2)
  o2                 Decimal?    @db.Decimal(10, 2)
  o3                 Decimal?    @db.Decimal(10, 2)
  edta               Decimal?    @db.Decimal(10, 2)
  mb                 Decimal?    @db.Decimal(10, 2)
  h2s                Decimal?    @db.Decimal(10, 2)
  kcl                Decimal?    @db.Decimal(10, 2)
  jmlNb              Decimal?    @db.Decimal(10, 2)
  deviationNotes     String?     @db.Text
  bottleType         BottleType?
  jenisCairan        String?
  volumeCarrier      Decimal?    @db.Decimal(8, 2)
  jumlahJarum        Int?
  tanggalProduksi    DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  session     TreatmentSession @relation(fields: [treatmentSessionId], references: [id])
  therapyPlan TherapyPlan?     @relation(fields: [therapyPlanId], references: [id])

  @@index([therapyPlanId])
  @@map("infusion_executions")
}

model MaterialUsage {
  id                 String   @id @default(cuid())
  treatmentSessionId String
  inventoryItemId    String
  quantity           Decimal  @db.Decimal(10, 2)
  unit               String
  recordedBy         String
  createdAt          DateTime @default(now())

  session       TreatmentSession @relation(fields: [treatmentSessionId], references: [id])
  inventoryItem InventoryItem    @relation(fields: [inventoryItemId], references: [id])

  @@index([treatmentSessionId])
  @@index([inventoryItemId])
  @@map("material_usages")
}

model SessionPhoto {
  id                 String   @id @default(cuid())
  treatmentSessionId String   @unique
  fileUrl            String
  fileName           String
  fileSize           Int
  mimeType           String
  uploadedBy         String
  createdAt          DateTime @default(now())

  session TreatmentSession @relation(fields: [treatmentSessionId], references: [id])

  @@map("session_photos")
}

model SessionSupportingPhoto {
  id                 String   @id @default(cuid())
  treatmentSessionId String
  fileUrl            String
  fileName           String
  fileSize           Int
  mimeType           String
  description        String?  @db.Text
  uploadedBy         String
  createdAt          DateTime @default(now())

  session TreatmentSession @relation(fields: [treatmentSessionId], references: [id], onDelete: Cascade)

  @@index([treatmentSessionId])
  @@index([createdAt])
  @@map("session_supporting_photos")
}

model EMRNote {
  id                 String      @id @default(cuid())
  treatmentSessionId String
  noteType           EMRNoteType
  content            String      @db.Text
  writtenBy          String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  session TreatmentSession @relation(fields: [treatmentSessionId], references: [id])

  @@index([treatmentSessionId, noteType])
  @@index([treatmentSessionId])
  @@map("emr_notes")
}

model DoctorEvaluation {
  id                 String   @id @default(cuid())
  evaluationCode     String   @unique
  treatmentSessionId String   @unique
  keluhan            String?  @db.Text
  rekomendasi        String?  @db.Text
  subjective         String?  @db.Text
  objective          String?  @db.Text
  assessment         String?  @db.Text
  plan               String?  @db.Text
  generalNotes       String?  @db.Text
  writtenBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session TreatmentSession          @relation(fields: [treatmentSessionId], references: [id])
  history DoctorEvaluationHistory[]

  @@map("doctor_evaluations")
}

model DoctorEvaluationHistory {
  id           String   @id @default(cuid())
  evaluationId String
  fieldName    String
  oldValue     String?  @db.Text
  newValue     String?  @db.Text
  changedBy    String
  createdAt    DateTime @default(now())

  evaluation DoctorEvaluation @relation(fields: [evaluationId], references: [id])

  @@index([evaluationId])
  @@map("doctor_evaluation_histories")
}

// ============================================================
// INVENTORY DOMAIN
// ============================================================

model MasterProduct {
  id                   String          @id @default(cuid())
  sku                  String?         @unique // SKU code like PRD-INF-IFA-001
  name                 String          @unique
  category             ProductCategory
  unit                 String // Legacy field, kept for backward compatibility
  baseUnit             String          @map("base_unit") // Storage unit (botol, box, pack)
  usageUnit            String          @map("usage_unit") // Usage unit (ml, tablet, gram)
  conversionFactor     Decimal         @default(1.0) @map("conversion_factor") @db.Decimal(10, 4) // How many usage units per base unit
  description          String?
  isAutoUsedPerSession Boolean         @default(false) @map("is_auto_used_per_session") // Auto-deduct 1 unit per infusion session
  isAutoAddedToBranch  Boolean         @default(false) @map("is_auto_added_to_branch") // Auto-add to new branch inventory
  defaultInitialStock  Decimal?        @map("default_initial_stock") @db.Decimal(10, 4) // Default stock when auto-added to branch
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  inventoryItems           InventoryItem[]
  stockRequestItems        StockRequestItem[]
  shipmentItems            ShipmentItem[]
  stockRequestInvoiceItems StockRequestInvoiceItem[]
  shipmentDiscrepancies    ShipmentDiscrepancy[]
  overstocks               BranchOverstock[]

  @@index([category, isActive])
  @@index([isActive])
  @@index([baseUnit, usageUnit])
  @@index([sku])
  @@map("master_products")
}

model InventoryItem {
  id              String   @id @default(cuid())
  masterProductId String
  branchId        String
  stock           Decimal  @default(0) @db.Decimal(10, 4)
  minThreshold    Decimal  @default(0) @db.Decimal(10, 4)
  storageLocation String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  masterProduct     MasterProduct      @relation(fields: [masterProductId], references: [id])
  branch            Branch             @relation(fields: [branchId], references: [id])
  stockMutations    StockMutation[]
  materialUsages    MaterialUsage[]
  stockRequestItems StockRequestItem[]

  @@unique([masterProductId, branchId])
  @@index([branchId, stock])
  @@index([branchId])
  @@map("inventory_items")
}

model StockMutation {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMutationType
  quantity        Decimal           @db.Decimal(10, 4)
  stockBefore     Decimal           @db.Decimal(10, 4)
  stockAfter      Decimal           @db.Decimal(10, 4)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_mutations")
}

// ============================================================
// PROCUREMENT DOMAIN
// ============================================================

model StockRequest {
  id          String             @id @default(cuid())
  requestCode String             @unique
  branchId    String
  requestedBy String
  status      StockRequestStatus @default(PENDING)
  notes       String?

  // Review fields
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?

  // Payment fields (for Partnership branches)
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?
  paymentUploadedAt    DateTime?
  paymentUploadedBy    String?

  // Payment verification (by Admin Manager)
  paymentVerifiedBy        String?
  paymentVerifiedAt        DateTime?
  paymentVerificationNotes String?
  paymentRejectionReason   String?

  // Shipping fields
  shippedBy String?
  shippedAt DateTime?

  // Receiving fields
  receivedBy     String?
  receivedAt     DateTime?
  receivingNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch          Branch               @relation(fields: [branchId], references: [id])
  items           StockRequestItem[]
  invoice         StockRequestInvoice?
  shipment        Shipment?
  overstockUsages OverstockUsage[]

  @@index([branchId, status])
  @@index([status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("stock_requests")
}

model StockRequestItem {
  id                String   @id @default(cuid())
  stockRequestId    String
  inventoryItemId   String? // Optional - for existing inventory items
  masterProductId   String // Required - reference to master product
  requestedQty      Decimal  @db.Decimal(10, 2)
  approvedQty       Decimal? @db.Decimal(10, 2) // Qty approved by manager (can differ from requested)
  overstockDeducted Decimal? @db.Decimal(10, 2) // Qty deducted from existing overstock
  finalQty          Decimal? @db.Decimal(10, 2) // Final qty after overstock deduction (requestedQty - overstockDeducted)
  notes             String?

  stockRequest    StockRequest     @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?   @relation(fields: [inventoryItemId], references: [id])
  masterProduct   MasterProduct    @relation(fields: [masterProductId], references: [id])
  overstockUsages OverstockUsage[]

  @@index([stockRequestId])
  @@index([masterProductId])
  @@map("stock_request_items")
}

model Shipment {
  id             String         @id @default(cuid())
  shipmentCode   String         @unique
  stockRequestId String         @unique
  fromBranchId   String
  toBranchId     String
  status         ShipmentStatus @default(PREPARING)

  // Shipping details
  shippedAt         DateTime?
  shippedBy         String?
  shipmentPhotoUrl  String? // Foto paket (optional)
  shipmentPhotoName String?

  // Receiving details
  receivedAt      DateTime?
  receivedBy      String?
  receiptFileUrl  String?
  receiptFileName String?
  receiptFileSize Int?
  receiptMimeType String?

  // Approval details
  approvedAt DateTime?
  approvedBy String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockRequest  StockRequest          @relation(fields: [stockRequestId], references: [id])
  fromBranch    Branch                @relation("ShipmentFrom", fields: [fromBranchId], references: [id])
  toBranch      Branch                @relation("ShipmentTo", fields: [toBranchId], references: [id])
  items         ShipmentItem[]
  discrepancies ShipmentDiscrepancy[]
  overstocks    BranchOverstock[]

  @@index([toBranchId, status])
  @@index([status])
  @@index([shippedAt])
  @@index([receivedAt])
  @@map("shipments")
}

model ShipmentItem {
  id              String   @id @default(cuid())
  shipmentId      String
  masterProductId String
  sentQty         Decimal  @db.Decimal(10, 2)
  receivedQty     Decimal? @db.Decimal(10, 2) // Actual qty received
  requestedQty    Decimal? @db.Decimal(10, 2) // Original requested qty (for overstock tracking)
  overstockQty    Decimal? @db.Decimal(10, 2) // Overstock qty (sentQty - requestedQty)
  overstockReason String? // Reason for overstock (required if overstockQty > 0)

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id])

  @@index([shipmentId])
  @@index([masterProductId])
  @@map("shipment_items")
}

// Invoice for Partnership stock requests
model StockRequestInvoice {
  id             String @id @default(cuid())
  invoiceNumber  String @unique
  stockRequestId String @unique
  branchId       String

  // Pricing
  subtotal        Decimal @db.Decimal(12, 2)
  totalAmount     Decimal @db.Decimal(12, 2)
  paidAmount      Decimal @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal @default(0) @db.Decimal(12, 2)

  // Invoice Status
  status InvoiceStatus @default(PENDING_PAYMENT)

  // Payment Proof from Admin Cabang Partnership
  paymentProofUrl      String?
  paymentProofFileName String?
  paymentProofFileSize Int?
  paymentProofMimeType String?
  paymentUploadedAt    DateTime?
  paymentUploadedBy    String?

  // Payment account shown on unpaid invoices
  paymentAccountLabel  String?
  paymentBankName      String?
  paymentAccountNumber String?
  paymentAccountHolder String?

  // Payment Verification by Admin Manager
  paymentVerificationStatus PaymentVerificationStatus @default(PENDING)
  verifiedBy                String?
  verifiedAt                DateTime?
  verificationNotes         String?
  rejectionReason           String?

  // Timestamps
  paidAt    DateTime?
  notes     String?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stockRequest StockRequest                 @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  items        StockRequestInvoiceItem[]
  payments     StockRequestInvoicePayment[]

  @@index([branchId])
  @@index([status])
  @@index([paymentVerificationStatus])
  @@index([createdAt])
  @@map("stock_request_invoices")
}

model StockRequestInvoicePayment {
  id        String @id @default(cuid())
  invoiceId String

  amount Decimal @db.Decimal(12, 2)

  proofFileUrl  String
  proofFileName String
  proofFileSize Int
  proofMimeType String

  notes      String?
  uploadedBy String
  uploadedAt DateTime @default(now())

  verifiedBy        String?
  verifiedAt        DateTime?
  verificationNotes String?
  rejectionReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice StockRequestInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([uploadedBy])
  @@index([uploadedAt])
  @@map("stock_request_invoice_payments")
}

model StockRequestInvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  masterProductId String
  sku             String? // Snapshot SKU produk
  productName     String // Snapshot nama produk
  description     String? // Snapshot keterangan produk
  quantity        Decimal @db.Decimal(10, 2)
  pricePerUnit    Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  invoice       StockRequestInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct       @relation(fields: [masterProductId], references: [id])

  @@index([invoiceId])
  @@index([masterProductId])
  @@map("stock_request_invoice_items")
}

// Discrepancy report for shipments
model ShipmentDiscrepancy {
  id              String          @id @default(cuid())
  shipmentId      String
  masterProductId String
  productName     String // Snapshot nama produk
  expectedQty     Decimal         @db.Decimal(10, 2)
  receivedQty     Decimal         @db.Decimal(10, 2)
  discrepancyType DiscrepancyType
  notes           String?
  photoUrl        String? // Foto bukti (optional)
  photoFileName   String?
  reportedBy      String
  createdAt       DateTime        @default(now())

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id])

  @@index([shipmentId])
  @@index([masterProductId])
  @@index([discrepancyType])
  @@map("shipment_discrepancies")
}

// ============================================================
// OVERSTOCK DOMAIN
// ============================================================

// Tracks overstock (excess items sent beyond requested quantity)
model BranchOverstock {
  id               String          @id @default(cuid())
  branchId         String
  masterProductId  String
  quantity         Decimal         @db.Decimal(10, 2) // Remaining overstock quantity
  originalQty      Decimal         @db.Decimal(10, 2) // Original overstock quantity
  reason           String // Reason for overstock (required)
  sourceShipmentId String
  status           OverstockStatus @default(AVAILABLE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  masterProduct  MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  sourceShipment Shipment         @relation(fields: [sourceShipmentId], references: [id], onDelete: Cascade)
  usages         OverstockUsage[]

  @@index([branchId])
  @@index([masterProductId])
  @@index([status])
  @@index([branchId, masterProductId, status])
  @@index([sourceShipmentId])
  @@map("branch_overstocks")
}

// Tracks how overstock is consumed by stock requests
model OverstockUsage {
  id                 String   @id @default(cuid())
  overstockId        String
  stockRequestId     String
  stockRequestItemId String
  quantityUsed       Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  overstock        BranchOverstock  @relation(fields: [overstockId], references: [id], onDelete: Cascade)
  stockRequest     StockRequest     @relation(fields: [stockRequestId], references: [id], onDelete: Cascade)
  stockRequestItem StockRequestItem @relation(fields: [stockRequestItemId], references: [id], onDelete: Cascade)

  @@index([overstockId])
  @@index([stockRequestId])
  @@index([stockRequestItemId])
  @@map("overstock_usages")
}

// ============================================================
// HOMECARE BAG LOGISTICS DOMAIN
// ============================================================

model HomecareTeam {
  id          String  @id @default(cuid())
  teamCode    String  @unique
  name        String
  branchId    String
  description String? @db.Text
  isActive    Boolean @default(true)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       HomecareTeamMember[]
  bags          HomecareBag[]
  stockRequests HomecareBagStockRequest[]

  @@index([branchId, isActive])
  @@index([teamCode])
  @@map("homecare_teams")
}

model HomecareTeamMember {
  id       String                 @id @default(cuid())
  teamId   String
  userId   String
  role     HomecareTeamMemberRole
  isActive Boolean                @default(true)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  notes    String?   @db.Text

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([role])
  @@map("homecare_team_members")
}

model HomecareBag {
  id       String            @id @default(cuid())
  bagCode  String            @unique
  name     String
  teamId   String
  branchId String
  status   HomecareBagStatus @default(ACTIVE)
  isActive Boolean           @default(true)

  notes     String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team HomecareTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  stocks        HomecareBagStock[]
  stockRequests HomecareBagStockRequest[]
  shipments     HomecareBagShipment[]
  usages        HomecareBagUsage[]
  returns       HomecareBagReturn[]
  opnames       HomecareBagOpname[]
  mutations     LogisticStockMutation[]

  @@index([teamId])
  @@index([branchId])
  @@index([status])
  @@index([isActive])
  @@map("homecare_bags")
}

model HomecareBagStock {
  id              String @id @default(cuid())
  bagId           String
  masterProductId String

  stock        Decimal @default(0) @db.Decimal(10, 4)
  minThreshold Decimal @default(0) @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag HomecareBag @relation(fields: [bagId], references: [id], onDelete: Cascade)

  @@unique([bagId, masterProductId])
  @@index([bagId])
  @@index([masterProductId])
  @@index([bagId, stock])
  @@map("homecare_bag_stocks")
}

model HomecareBagStockRequest {
  id          String                   @id @default(cuid())
  requestCode String                   @unique
  teamId      String
  bagId       String
  branchId    String
  requestedBy String
  status      HomecareBagRequestStatus @default(PENDING)

  priority     String @default("NORMAL")
  requestNotes String @db.Text

  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?   @db.Text
  rejectionReason String?   @db.Text
  preparedBy      String?
  preparedAt      DateTime?
  shippedBy       String?
  shippedAt       DateTime?
  receivedBy      String?
  receivedAt      DateTime?
  receivingNotes  String?   @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team     HomecareTeam                  @relation(fields: [teamId], references: [id])
  bag      HomecareBag                   @relation(fields: [bagId], references: [id])
  items    HomecareBagStockRequestItem[]
  shipment HomecareBagShipment?

  @@index([teamId, status])
  @@index([bagId, status])
  @@index([branchId, status])
  @@index([requestedBy])
  @@index([createdAt])
  @@map("homecare_bag_stock_requests")
}

model HomecareBagStockRequestItem {
  id              String @id @default(cuid())
  requestId       String
  masterProductId String

  requestedQty Decimal  @db.Decimal(10, 4)
  approvedQty  Decimal? @db.Decimal(10, 4)
  finalQty     Decimal? @db.Decimal(10, 4)
  notes        String?  @db.Text

  request HomecareBagStockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([masterProductId])
  @@map("homecare_bag_stock_request_items")
}

model HomecareBagShipment {
  id           String @id @default(cuid())
  shipmentCode String @unique
  requestId    String @unique

  fromBranchId String
  toBagId      String
  status       ShipmentStatus @default(PREPARING)

  shippedBy String?
  shippedAt DateTime?

  shipmentPhotoUrl  String?
  shipmentPhotoName String?

  receivedAt     DateTime?
  receivedUserId String?

  receiptFileUrl  String?
  receiptFileName String?
  receiptFileSize Int?
  receiptMimeType String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request HomecareBagStockRequest   @relation(fields: [requestId], references: [id])
  bag     HomecareBag               @relation(fields: [toBagId], references: [id])
  items   HomecareBagShipmentItem[]

  @@index([fromBranchId])
  @@index([toBagId, status])
  @@index([status])
  @@index([shippedAt])
  @@map("homecare_bag_shipments")
}

model HomecareBagShipmentItem {
  id              String @id @default(cuid())
  shipmentId      String
  masterProductId String

  sentQty     Decimal  @db.Decimal(10, 4)
  receivedQty Decimal? @db.Decimal(10, 4)

  discrepancyType  DiscrepancyType?
  discrepancyNotes String?          @db.Text
  photoUrl         String?
  photoFileName    String?

  shipment HomecareBagShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([masterProductId])
  @@index([discrepancyType])
  @@map("homecare_bag_shipment_items")
}

model HomecareBagUsage {
  id        String @id @default(cuid())
  usageCode String @unique
  bagId     String
  teamId    String

  treatmentSessionId String?
  usedBy             String
  status             HomecareBagUsageStatus @default(COMPLETED)
  usageDate          DateTime               @default(now())
  notes              String                 @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag            @relation(fields: [bagId], references: [id])
  items HomecareBagUsageItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([usedBy])
  @@index([treatmentSessionId])
  @@index([usageDate])
  @@map("homecare_bag_usages")
}

model HomecareBagUsageItem {
  id              String  @id @default(cuid())
  usageId         String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  unit            String?
  notes           String? @db.Text

  usage HomecareBagUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)

  @@index([usageId])
  @@index([masterProductId])
  @@map("homecare_bag_usage_items")
}

model HomecareBagReturn {
  id         String @id @default(cuid())
  returnCode String @unique
  bagId      String
  teamId     String
  toBranchId String

  returnedBy String
  receivedBy String?
  returnedAt DateTime  @default(now())
  receivedAt DateTime?
  notes      String    @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagReturnItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([toBranchId])
  @@index([returnedBy])
  @@index([receivedAt])
  @@map("homecare_bag_returns")
}

model HomecareBagReturnItem {
  id              String  @id @default(cuid())
  returnId        String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)
  isReusable      Boolean @default(true)
  condition       String?
  notes           String? @db.Text

  bagReturn HomecareBagReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([masterProductId])
  @@map("homecare_bag_return_items")
}

model HomecareBagOpname {
  id         String                  @id @default(cuid())
  opnameCode String                  @unique
  bagId      String
  teamId     String
  status     HomecareBagOpnameStatus @default(DRAFT)
  checkedBy  String
  checkedAt  DateTime                @default(now())
  notes      String                  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bag   HomecareBag             @relation(fields: [bagId], references: [id])
  items HomecareBagOpnameItem[]

  @@index([bagId])
  @@index([teamId])
  @@index([checkedBy])
  @@index([checkedAt])
  @@map("homecare_bag_opnames")
}

model HomecareBagOpnameItem {
  id              String @id @default(cuid())
  opnameId        String
  masterProductId String

  systemQty         Decimal @db.Decimal(10, 4)
  physicalQty       Decimal @db.Decimal(10, 4)
  difference        Decimal @db.Decimal(10, 4)
  adjustmentCreated Boolean @default(false)
  notes             String? @db.Text

  opname HomecareBagOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)

  @@index([opnameId])
  @@index([masterProductId])
  @@map("homecare_bag_opname_items")
}

model LogisticStockTransaction {
  id              String                    @id @default(cuid())
  transactionCode String                    @unique
  type            LogisticTransactionType
  status          LogisticTransactionStatus @default(COMPLETED)

  sourceType LogisticLocationType?
  sourceId   String?

  destinationType LogisticLocationType?
  destinationId   String?

  referenceType String?
  referenceId   String?

  reason String?
  notes  String  @db.Text

  supportFileUrl      String?
  supportFileName     String?
  supportFileSize     Int?
  supportFileMimeType String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LogisticStockTransactionItem[]

  @@index([type])
  @@index([status])
  @@index([sourceType, sourceId])
  @@index([destinationType, destinationId])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_transactions")
}

model LogisticStockTransactionItem {
  id              String  @id @default(cuid())
  transactionId   String
  masterProductId String
  quantity        Decimal @db.Decimal(10, 4)

  sourceStockBefore Decimal? @db.Decimal(10, 4)
  sourceStockAfter  Decimal? @db.Decimal(10, 4)

  destinationStockBefore Decimal? @db.Decimal(10, 4)
  destinationStockAfter  Decimal? @db.Decimal(10, 4)
  notes                  String?  @db.Text

  transaction LogisticStockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([masterProductId])
  @@map("logistic_stock_transaction_items")
}

model LogisticStockMutation {
  id           String @id @default(cuid())
  mutationCode String @unique

  locationType LogisticLocationType
  locationId   String

  homecareBagId   String?
  masterProductId String
  type            LogisticTransactionType

  quantity    Decimal @db.Decimal(10, 4)
  stockBefore Decimal @db.Decimal(10, 4)
  stockAfter  Decimal @db.Decimal(10, 4)

  referenceType String?
  referenceId   String?
  notes         String  @db.Text

  createdBy String
  createdAt DateTime @default(now())

  homecareBag HomecareBag? @relation(fields: [homecareBagId], references: [id], onDelete: SetNull)

  @@index([locationType, locationId])
  @@index([homecareBagId])
  @@index([masterProductId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("logistic_stock_mutations")
}

// ============================================================
// COMMUNICATION DOMAIN
// ============================================================

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String             @db.Text
  deepLink  String?
  status    NotificationStatus @default(UNREAD)
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ChatRoom {
  id        String   @id @default(cuid())
  memberId  String   @unique
  staffId   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member   Member        @relation(fields: [memberId], references: [id])
  staff    User?         @relation("ChatRoomStaff", fields: [staffId], references: [id])
  messages ChatMessage[]

  @@index([isActive])
  @@map("chat_rooms")
}

model ChatMessage {
  id         String   @id @default(cuid())
  chatRoomId String
  senderId   String
  content    String   @db.Text
  fileUrl    String?
  fileName   String?
  createdAt  DateTime @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id])
  sender   User     @relation(fields: [senderId], references: [id])

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?
  userName      String?
  userRole      String?
  branchId      String? // Branch where action occurred (null for global/system actions)
  branchName    String?
  action        AuditAction
  module        String?
  resource      String
  resourceId    String
  entityType    String?
  entityId      String?
  entityCode    String?
  description   String?
  meta          Json?
  beforeData    Json?
  afterData     Json?
  changedFields Json?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId, createdAt])
  @@index([branchId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// LAB RESULTS DOMAIN
// ============================================================

model LabResult {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  fileName String // Original filename
  fileUrl  String // MinIO URL
  fileType String // MIME type: application/pdf, image/jpeg, image/png
  fileSize Int // File size in bytes

  description String?   @db.Text // Keterangan hasil lab
  labDate     DateTime? // Tanggal hasil lab (optional)

  uploadedBy     String // User ID yang upload
  uploadedByUser User   @relation(fields: [uploadedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([uploadedBy])
  @@map("lab_results")
}
