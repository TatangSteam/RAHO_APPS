  totalCost      Decimal                @default(0) @db.Decimal(18, 4)
  postedBy       String
  reversedAt     DateTime?
  reversalOfId   String?                @unique
  createdAt      DateTime               @default(now())

  branch                   Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
