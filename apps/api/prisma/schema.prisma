model TherapyPlanSet {
  id             String   @id @default(cuid())
  memberId       String
  setCode        String   @unique // Internal code, hidden from UI tables
  name           String?
  version        Int      @default(1)
  status         String   @default("ACTIVE") // ACTIVE, SUPERSEDED
  supersededById String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member       Member           @relation(fields: [memberId], references: [id])
  plans        TherapyPlan[]
  supersededBy TherapyPlanSet?  @relation("TherapyPlanSetVersioning", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes   TherapyPlanSet[] @relation("TherapyPlanSetVersioning")

  @@index([memberId, status])
  @@index([supersededById])
  @@map("therapy_plan_sets")
}

model TherapyPlan {
  id                  String    @id @default(cuid())
  planCode            String    @unique
  memberId            String? // NEW: For preparation (before session)
  therapyPlanSetId    String?
  planNumber          Int?
  treatmentSessionId  String?   @unique // Make optional
  keterangan          String?   @db.Text
  // IFA fields - IFA A + MG (pilih salah satu: 500ml atau 250ml)
  ifa250              Decimal?  @db.Decimal(10, 2) // IFA A + MG 250ml (satuan: Botol)
  ifa500              Decimal?  @db.Decimal(10, 2) // IFA A + MG 500ml (satuan: Botol)
  hho                 Decimal?  @db.Decimal(10, 2)
  hhoKonsentrat       Decimal?  @db.Decimal(10, 2)
  h2                  Decimal?  @db.Decimal(10, 2)
  no                  Decimal?  @db.Decimal(10, 2)
  gaso                Decimal?  @db.Decimal(10, 2)
  o2                  Decimal?  @db.Decimal(10, 2)
  o3                  Decimal?  @db.Decimal(10, 2)
  edta                Decimal?  @db.Decimal(10, 2)
  mb                  Decimal?  @db.Decimal(10, 2)
  h2s                 Decimal?  @db.Decimal(10, 2)
  kcl                 Decimal?  @db.Decimal(10, 2)
  jmlNb               Decimal?  @db.Decimal(10, 2)
  noInIfa             Decimal?  @default(2.5) @db.Decimal(10, 2) // Default NO di IFA 2,5ml
  ifaSubstances       Json?     @map("ifa_substances") // Zat yang terkandung di IFA, hanya pencatatan therapy plan
  ifaSubstanceTotalMl Decimal?  @map("ifa_substance_total_ml") @db.Decimal(10, 2)
  // Versioning fields
  version             Int       @default(1) // Version number (1, 2, 3, ...)
  supersededById      String? // ID of the therapy plan that supersedes this one
  supersededAt        DateTime? // When was this version superseded
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  member         Member?             @relation(fields: [memberId], references: [id])
  therapyPlanSet TherapyPlanSet?     @relation(fields: [therapyPlanSetId], references: [id])
  session        TreatmentSession?   @relation(fields: [treatmentSessionId], references: [id])
  supersededBy   TherapyPlan?        @relation("TherapyPlanVersioning", fields: [supersededById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes     TherapyPlan[]       @relation("TherapyPlanVersioning")
  infusions      InfusionExecution[]

  @@unique([therapyPlanSetId, planNumber])
  @@index([memberId])
  @@index([therapyPlanSetId])
  @@index([supersededById])
  @@map("therapy_plans")
}

model VitalSign {
