# RAHO Web — Environment Variables
# Copy ke .env.local dan sesuaikan nilainya

# ── API Backend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WHO ICD API (server-side only; do not prefix with NEXT_PUBLIC)
ICD_API_CLIENT_ID=
ICD_API_CLIENT_SECRET=

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Raho ERP
NEXT_PUBLIC_APP_VERSION=1.0.0
